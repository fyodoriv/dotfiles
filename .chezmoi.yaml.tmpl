{{- $choices := list "full" "core" -}}
{{- $profile := promptChoiceOnce . "profile" "Installation profile (full = all modules, core = essential only)" $choices "core" -}}
{{- $enterprise := promptBoolOnce . "is_enterprise" "Enable enterprise configs (AWS, K8s, Gradle)" false -}}
{{- $workEmailDomain := "example.com" -}}
{{- $gheHost := "github.example.com" -}}
{{- if $enterprise -}}
{{-   $workEmailDomain = promptStringOnce . "work_email_domain" "Work email domain for Chrome profile detection" "example.com" -}}
{{-   $gheHost = promptStringOnce . "github_enterprise_host" "GitHub Enterprise hostname" "github.example.com" -}}
{{- end -}}
{{- $useAiTools := promptBoolOnce . "use_ai_tools" "Enable AI agent tooling (ANTHROPIC_MODEL, agent-browser)" false -}}
{{- $useLocalAi := promptBoolOnce . "use_local_ai" "Enable local-LLM stack (pipx + aider + mlx-lm on Apple Silicon; ~30 GB model weights require explicit opt-in via ~/.config/dotfiles/.local-llm-bootstrap-confirmed sentinel)" false -}}
{{- $dotfilesDir := promptStringOnce . "dotfiles_dir" "Dotfiles directory relative to home (e.g. apps/dotfiles, dotfiles)" "apps/dotfiles" -}}
{{- $reposDir := promptStringOnce . "repos_dir" "Repos directory relative to home (e.g. apps, repos, src)" "apps" -}}
{{- $brewSkip := list -}}
{{- if hasKey . "brew_skip" -}}
{{-   $brewSkip = .brew_skip -}}
{{- end -}}
{{- $obsidian := false -}}
{{- if hasKey . "obsidian" -}}
{{-   $obsidian = .obsidian -}}
{{- end -}}
{{- $claudeRemoteControl := false -}}
{{- if hasKey . "claude_remote_control" -}}
{{-   $claudeRemoteControl = .claude_remote_control -}}
{{- end -}}
{{/*  weekly_metrics: opt-in weekly aggregate metrics file (lib/weekly-metrics.sh). */ -}}
{{- $weeklyMetrics := false -}}
{{- if hasKey . "weekly_metrics" -}}
{{-   $weeklyMetrics = .weekly_metrics -}}
{{- end -}}
{{/*  Optional Claude Code model/effort override (run_after_claude-settings-model.sh) */ -}}
{{- $claudeModel := "" -}}
{{- if hasKey . "claude_model" -}}
{{-   $claudeModel = .claude_model -}}
{{- end -}}
{{- $claudeEffort := "" -}}
{{- if hasKey . "claude_effort" -}}
{{-   $claudeEffort = .claude_effort -}}
{{- end -}}
{{/* claude_permissions: manage (default) pins bypassPermissions in Claude
     Code and the ~/bin/claude wrapper; keep leaves the person's prompts on. */ -}}
{{- $claudePermissions := "manage" -}}
{{- if hasKey . "claude_permissions" -}}
{{-   $claudePermissions = .claude_permissions -}}
{{- end -}}
{{/* claude_disabled_plugins: Claude Code plugins kept off on every apply
     (.chezmoiscripts/run_after_claude-disabled-plugins.sh). */ -}}
{{- $claudeDisabledPlugins := list "prisma@synced" -}}
{{- if hasKey . "claude_disabled_plugins" -}}
{{-   $claudeDisabledPlugins = .claude_disabled_plugins -}}
{{- end -}}
{{/* claude_mods: agentbrew Claude Code mods installed on every apply
     (.chezmoiscripts/run_after_claude-mods.sh). */ -}}
{{- $claudeMods := list "work-pane" -}}
{{- if hasKey . "claude_mods" -}}
{{-   $claudeMods = .claude_mods -}}
{{- end -}}
{{/* login_apps: apps macos-apps.sh adds as login items; a leading - removes
     one (lib/login-apps.sh). */ -}}
{{- $loginApps := list "Ghostty" -}}
{{- if hasKey . "login_apps" -}}
{{-   $loginApps = .login_apps -}}
{{- end -}}
{{- $autoUpgrade := promptBoolOnce . "auto_upgrade" "Enable auto-upgrade LaunchAgent (brew upgrade at 3am Sunday)" false -}}
{{- $useEncryption := promptBoolOnce . "use_encryption" "Enable age encryption (requires ~/.config/chezmoi/key.txt)" false -}}
{{- $ageRecipient := "unused-no-encryption-configured" -}}
{{- if $useEncryption -}}
{{-   $ageRecipient = dig "age" "recipient" "" .chezmoi.config -}}
{{-   if hasKey . "age_recipient" -}}
{{-     $ageRecipient = .age_recipient -}}
{{-   else if not $ageRecipient -}}
{{-     $ageRecipient = promptStringOnce . "age_recipient" "age public key (recipient)" "" -}}
{{-   end -}}
{{- end -}}
{{- $morningHour := 8 -}}
{{- $morningMinute := 30 -}}
{{- if eq $profile "full" -}}
{{/*  YAML loads small numbers as uint64, which promptIntOnce ignores */ -}}
{{-   if hasKey . "morning_hour" -}}
{{-     $morningHour = int .morning_hour -}}
{{-   else -}}
{{-     $morningHour = promptIntOnce . "morning_hour" "Morning briefing hour (0-23)" 8 -}}
{{-   end -}}
{{-   if hasKey . "morning_minute" -}}
{{-     $morningMinute = int .morning_minute -}}
{{-   else -}}
{{-     $morningMinute = promptIntOnce . "morning_minute" "Morning briefing minute (0-59)" 30 -}}
{{-   end -}}
{{- end -}}

{{/* ── Git identity ────────────────────────────────────────────────── */ -}}
{{- $gitWorkName := promptStringOnce . "git_work_name" "Git commit name for work/default identity" "" -}}
{{- $gitWorkEmailDefault := "" -}}
{{- if $enterprise -}}
{{-   $gitWorkEmailDefault = printf "your.username@%s" $workEmailDomain -}}
{{- end -}}
{{- $gitWorkEmail := promptStringOnce . "git_work_email" "Git commit email for work/default identity" $gitWorkEmailDefault -}}
{{- $gitPersonalEnabled := promptBoolOnce . "git_personal_enabled" "Enable split identity: personal identity for github.com remotes (work identity stays default elsewhere)" false -}}
{{- $gitPersonalName := "" -}}
{{- $gitPersonalEmail := "" -}}
{{- if $gitPersonalEnabled -}}
{{-   $gitPersonalName = promptStringOnce . "git_personal_name" "Git commit name for personal identity (github.com)" "" -}}
{{-   $gitPersonalEmail = promptStringOnce . "git_personal_email" "Git commit email for personal identity (github.com) — consider <username>@users.noreply.github.com" "" -}}
{{- end -}}

{{/* ── Owner machine ─────────────────────────────────────────────────
     owner_machine turns on checks and jobs that only make sense on the
     repo owner's Macs (personal-machine doctor, auto-commit-and-push
     sync). It is derived from the git identity, so a new user gets
     false and the owner's saved config needs no new key. Override with
     `owner_machine: true|false` in ~/.config/chezmoi/chezmoi.yaml. */ -}}
{{- $ownerMachine := or (eq $gitWorkEmail "fyodor@sent.com") (eq $gitPersonalEmail "fyodor@sent.com") -}}
{{- if hasKey . "owner_machine" -}}
{{-   $ownerMachine = .owner_machine -}}
{{- end -}}
{{/* auto_sync auto-commits and pushes the dotfiles checkout every 30 min.
     Default: on for the owner, off for everyone else (a fork's main
     should never get unreviewed pushes). */ -}}
{{- $autoSync := $ownerMachine -}}
{{- if hasKey . "auto_sync" -}}
{{-   $autoSync = .auto_sync -}}
{{- end -}}
{{/* endpoint_hardening turns on the endpoint-hardening scripts: they ad-hoc
     sign Homebrew bottles and link shims into the Homebrew prefix for an
     endpoint-security agent, so they write outside $HOME.
     Default: owner_machine. Set true on any Mac with such an agent. */ -}}
{{- $endpointHardening := $ownerMachine -}}
{{- if hasKey . "endpoint_hardening" -}}
{{-   $endpointHardening = .endpoint_hardening -}}
{{- end -}}
{{/* capslock_control maps Caps Lock to Control (LaunchAgent
     com.dotfiles.capslock-control, plus macos-visual.sh on full).
     Default: owner_machine, so a new user's Mac keeps Caps Lock as Caps
     Lock. Set true to opt in, or false to opt out. */ -}}
{{- $capslockControl := $ownerMachine -}}
{{- if hasKey . "capslock_control" -}}
{{-   $capslockControl = .capslock_control -}}
{{- end -}}
{{/* gh_admin_scopes makes the git doctor require the workflow,
     admin:public_key and delete_repo gh scopes. Default: owner_machine, so a
     new user's agents never need power to delete repos or change SSH keys. */ -}}
{{- $ghAdminScopes := $ownerMachine -}}
{{- if hasKey . "gh_admin_scopes" -}}
{{-   $ghAdminScopes = .gh_admin_scopes -}}
{{- end -}}
{{/* keep_awake_tools loads the sleepwatcher LaunchAgent and runs the
     doctor checks for it and for Amphetamine (lid-close persistence).
     Default: the full profile only. Set true on a core Mac to opt in. */ -}}
{{- $keepAwakeTools := eq $profile "full" -}}
{{- if hasKey . "keep_awake_tools" -}}
{{-   $keepAwakeTools = .keep_awake_tools -}}
{{- end -}}
{{/* trackpad_swipe_fingers: 3 or 4 fingers for swipes between desktops
     and Mission Control (macos-trackpad.sh). 3 also turns three-finger drag
     off. Default 4, which changes nothing. */ -}}
{{- $trackpadSwipeFingers := 4 -}}
{{- if hasKey . "trackpad_swipe_fingers" -}}
{{-   $trackpadSwipeFingers = .trackpad_swipe_fingers -}}
{{- end -}}
{{/* local_ai_agents loads the local-AI LaunchAgents (opencode serve on
     :4096, Ollama, model warmup) and runs the local-ai doctor module, whose
     fixes install opencode. Default: use_local_ai or owner_machine, so a new
     user's Mac gets none and the owner's Macs keep opencode serve. */ -}}
{{- $localAiAgents := or $useLocalAi $ownerMachine -}}
{{- if hasKey . "local_ai_agents" -}}
{{-   $localAiAgents = .local_ai_agents -}}
{{- end -}}
{{/* global_git_hooks wires git-hooks/ as core.hooksPath for every repo
     (leak gates + commit-msg cleanup). Opt out with false. */ -}}
{{- $globalGitHooks := true -}}
{{- if hasKey . "global_git_hooks" -}}
{{-   $globalGitHooks = .global_git_hooks -}}
{{- end -}}

sourceDir: {{ .chezmoi.sourceDir | quote }}

# Plain .sh lifecycle scripts read this; they cannot read template data.
scriptEnv:
  DOTFILES_ENDPOINT_HARDENING: {{ if $endpointHardening }}"1"{{ else }}"0"{{ end }}

encryption: age
age:
  identity: {{ joinPath .chezmoi.homeDir ".config/chezmoi/key.txt" | quote }}
  recipient: {{ $ageRecipient }}

data:
  profile: {{ $profile | quote }}
  is_enterprise: {{ $enterprise }}
  work_email_domain: {{ $workEmailDomain | quote }}
  github_enterprise_host: {{ $gheHost | quote }}
  dotfiles_dir: {{ $dotfilesDir | quote }}
  repos_dir: {{ $reposDir | quote }}
  brew_skip:
{{- range $brewSkip }}
    - {{ . | quote }}
{{- else }}
    []
{{- end }}
  obsidian: {{ $obsidian }}
  auto_upgrade: {{ $autoUpgrade }}
  auto_sync: {{ $autoSync }}
  owner_machine: {{ $ownerMachine }}
  endpoint_hardening: {{ $endpointHardening }}
  capslock_control: {{ $capslockControl }}
  trackpad_swipe_fingers: {{ $trackpadSwipeFingers }}
  global_git_hooks: {{ $globalGitHooks }}
  claude_remote_control: {{ $claudeRemoteControl }}
  weekly_metrics: {{ $weeklyMetrics }}
  use_ai_tools: {{ $useAiTools }}
  use_local_ai: {{ $useLocalAi }}
  local_ai_agents: {{ $localAiAgents }}
  gh_admin_scopes: {{ $ghAdminScopes }}
  keep_awake_tools: {{ $keepAwakeTools }}
  use_encryption: {{ $useEncryption }}
  age_recipient: {{ $ageRecipient | quote }}
  morning_hour: {{ $morningHour }}
  morning_minute: {{ $morningMinute }}
  git_work_name: {{ $gitWorkName | quote }}
  git_work_email: {{ $gitWorkEmail | quote }}
  git_personal_enabled: {{ $gitPersonalEnabled }}
  git_personal_name: {{ $gitPersonalName | quote }}
  git_personal_email: {{ $gitPersonalEmail | quote }}
{{- if $claudeModel }}
  claude_model: {{ $claudeModel | quote }}
{{- end }}
{{- if $claudeEffort }}
  claude_effort: {{ $claudeEffort | quote }}
{{- end }}
{{- if ne $claudePermissions "manage" }}
  claude_permissions: {{ $claudePermissions | quote }}
{{- end }}
  claude_disabled_plugins:
{{- range $claudeDisabledPlugins }}
    - {{ . | quote }}
{{- else }}
    []
{{- end }}
  claude_mods:
{{- range $claudeMods }}
    - {{ . | quote }}
{{- else }}
    []
{{- end }}
  login_apps:
{{- range $loginApps }}
    - {{ . | quote }}
{{- else }}
    []
{{- end }}
