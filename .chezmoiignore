# Profile-based ignoring (target paths, not source paths)
{{- if ne .profile "full" }}
.ideavimrc
.tmux.conf
.config/ghostty
.config/lazygit
.config/fastfetch
{{- end }}

# AI tooling (opt-in)
{{- if not (dig "use_ai_tools" false .) }}
.zshrc.ai-tools
{{- end }}

# Enterprise-only files (target paths)
{{- if not .is_enterprise }}
.ssh/config.enterprise
{{- end }}

# Personal git identity (opt-in — values from chezmoi prompts)
{{- if not (dig "git_personal_enabled" false .) }}
.gitconfig.personal
{{- end }}

# Skip encrypted files when age encryption is not configured
{{- if not (dig "use_encryption" false .) }}
.ssh/config.enterprise
{{- end }}
