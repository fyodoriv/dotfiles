#!/bin/bash
# Rebuild the native app-priority when its Rust source changes, so a merged
# fix reaches this Mac on the next `dotfiles apply`. Rebuild only when
# a native binary is selected. Rollback removes the link.
# Runs on every apply but builds only when the source hash differs from the
# one the last good build recorded, so a failed or timed-out build is retried
# on the next apply. tests/app-priority-native-refresh.bats checks that every
# crate file is hashed here.
set -euo pipefail

want="{{ template "app-priority-source-hash" . }}"

directory="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/native/app-priority"
stamp="$directory/source-hash"
[ -L "$directory/current" ] || exit 0
[ "$(cat "$stamp" 2>/dev/null || true)" = "$want" ] && exit 0

# The build waits for a heavy-run slot. Stop waiting after this many seconds;
# heavy-run drops a waiter whose caller is gone.
max_wait="${DOTFILES_NATIVE_BUILD_MAX_WAIT:-600}"

echo "→ Rebuilding native app-priority (Rust source changed)..."
# shellcheck source=/dev/null
source "{{ .chezmoi.sourceDir }}/lib/app-priority-build.sh"
if app_priority_build_with_timeout "$max_wait" bash "{{ .chezmoi.sourceDir }}/bin/app-priority-native" refresh "$want"; then
  exit 0
else
  if [ "$?" -eq 124 ]; then result="timed out after ${max_wait}s"; else result="failed"; fi
fi
# The build runs before the link swap, so the previous build stays active.
echo "⚠ native app-priority rebuild $result; the previous build stays active." >&2
echo "  The next dotfiles apply retries. Now: dotfiles priority-native install" >&2
