#!/bin/bash
# Rebuild the native app-priority when its Rust source changes, so a merged
# fix reaches this Mac on the next `dotfiles apply`. Only on Macs that opted
# in with `dotfiles priority-native install` (rollback removes the link).
# tests/app-priority-native-refresh.bats checks every source file is hashed here.
# Cargo.toml: {{ include "rust/app-priority/Cargo.toml" | sha256sum }}
# Cargo.lock: {{ include "rust/app-priority/Cargo.lock" | sha256sum }}
# src/main.rs: {{ include "rust/app-priority/src/main.rs" | sha256sum }}
# src/platform.rs: {{ include "rust/app-priority/src/platform.rs" | sha256sum }}
# src/selector.rs: {{ include "rust/app-priority/src/selector.rs" | sha256sum }}
set -euo pipefail

link="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/native/app-priority/current"
[ -L "$link" ] || exit 0

echo "→ Rebuilding native app-priority (Rust source changed)..."
# The build runs before the link swap, so a failure keeps the old build active.
if ! bash "{{ .chezmoi.sourceDir }}/bin/app-priority-native" install; then
  echo "⚠ native app-priority rebuild failed; the previous build stays active." >&2
  echo "  Retry: dotfiles priority-native install" >&2
fi
