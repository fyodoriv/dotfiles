.PHONY: changelog check-steps e2e e2e-if-needed test-plugins-bash32 help lint lint-full lint-tasks lint-tasks-freshness lint-tasks-rule9 test test-all test-force check audit install-deps count clean fmt coverage

.DEFAULT_GOAL := help

# All scripts to lint
# Endpoint-security shims (curl/jq/grep/...) are Mach-O binaries/symlinks.
# Shellcheck only the real scripts under bin/.
# Both lists use `=`, so make builds them only when lint needs them, not in
# each of the sub-makes that make check starts. One `file` call reads every
# bin/ entry.
BIN_SCRIPTS = $(shell file bin/* 2>/dev/null | awk -F': ' '/shell script/ { print $$1 }')

SCRIPTS = macos.sh macos-visual.sh macos-apps.sh snapshot.sh scripts/benchmark-run.sh scripts/gate-timed.sh scripts/changelog.sh \
           $(wildcard private_dot_agent-browser/executable_*.sh) \
           $(wildcard lib/*.sh) \
           $(BIN_SCRIPTS) $(wildcard modules/*/doctor.sh) \
           $(wildcard .chezmoiscripts/*.sh) $(wildcard .github/scripts/*.sh) \
           $(shell grep -L call_lefthook git-hooks/* 2>/dev/null)
# git-hooks/: lint only HAND-WRITTEN hooks (commit-msg, post-commit). The
# pre-commit / pre-push / post-merge / post-rewrite shims are GENERATED by
# `lefthook install` and ship a `[ "$X" = "1" -o "$X" = "true" ]` line that
# trips SC2166 — we don't control lefthook's codegen, so we don't lint it.
# `grep -L call_lefthook` selects the non-shim hooks and self-adapts as the
# generated shim set changes.

# macOS interactive scheduling tier — all child processes inherit
FULLPOWER := $(shell command -v taskpolicy >/dev/null 2>&1 && echo "taskpolicy -t 0 -l 0" || echo "")

# Test runs never write the real errors or stats logs (lib/errors-log.sh,
# lib/stats.sh); tests that check a write turn it back on.
export DOTFILES_ERRORS_LOG := 0
export DOTFILES_STATS_LOG := 0

DEV_DEPS := shellcheck bats-core parallel chezmoi fd jq
# python3 is bundled with macOS / GitHub Actions runners; we use it via
# bin/dotfiles-coverage instead of kcov because kcov 43 produces empty
# coverage on macOS Tahoe (DYLD_INSERT_LIBRARIES blocked by SIP).
OPTIONAL_DEV_DEPS := shfmt
TASKS_LINT_VERSION := $(shell sed -n '1p' .tasks-lint-version)
TASKS_LINT := npx -y @tasks-md/lint@$(TASKS_LINT_VERSION)
TASKS_FILE ?= TASKS.md

# ── Help ─────────────────────────────────────────────────────────────
help: ## Show this help message
	@printf "\033[1mUsage:\033[0m make [target]\n\n"
	@printf "\033[1mTargets:\033[0m\n"
	@grep -E '^[a-zA-Z_-]+:.*##' $(MAKEFILE_LIST) | \
		awk -F ':.*## ' '{printf "  \033[36m%-14s\033[0m %s\n", $$1, $$2}'

# ── Lint: shellcheck all scripts ─────────────────────────────────────
# make lint checks every script in SCRIPTS, but skips a script that already
# passed with the same content, the same files it sources, the same
# shellcheck version, and the same .shellcheckrc (bin/cached-run --per-file;
# every worktree shares these passes). The rest run $(JOBS) at a time.
# make lint-full is the old single uncached shellcheck call: same verdict.
LINT_FLAGS := -S warning
lint-key = $(shell shellcheck --version 2>/dev/null | sed -n 2p) rc=$(shell git hash-object .shellcheckrc 2>/dev/null) opts=$(SHELLCHECK_OPTS)
lint: ## Shellcheck all scripts (skips scripts that passed unchanged)
	@echo "═══ Shellcheck ═══"
	@$(FULLPOWER) ./bin/cached-run --per-file --jobs $(JOBS) --key "$(lint-key)" shellcheck $(LINT_FLAGS) -- $(SCRIPTS) && echo "✓ All scripts pass shellcheck" || exit 1

lint-full: ## Shellcheck all scripts, no cache (slow)
	@echo "═══ Shellcheck (full, no cache) ═══"
	@$(FULLPOWER) shellcheck $(LINT_FLAGS) $(SCRIPTS) && echo "✓ All scripts pass shellcheck" || exit 1

# ── Lint: task queue format ──────────────────────────────────────────
lint-tasks: ## Validate TASKS.md queue format
	@echo "═══ TASKS.md lint ═══"
	@$(TASKS_LINT) $(TASKS_FILE)
	@echo "═══ tasks-stability priority ═══"
	@.github/scripts/check-tasks-stability.sh
	@echo "═══ tasks-rule9 fields ═══"
	@TASKS_RULE9_FILE="$(TASKS_FILE)" .github/scripts/check-tasks-rule9-fields.sh

# ── Lint: tasks-md/lint pin freshness (advisory, never fails) ────────
lint-tasks-freshness: ## Warn if .tasks-lint-version is behind npm
	@echo "═══ tasks-lint freshness ═══"
	@.github/scripts/check-tasks-lint-freshness.sh

# ── Lint: rule-9 fields on P0/P1 ─────────────────────────────────────
# Walks TASKS.md and fails when any P0/P1 entry lacks one of the 5
# Hypothesis-Driven-Development fields (Hypothesis/Success/Pivot/
# Measurement/Anchor).
lint-tasks-rule9: ## Fail when P0/P1 tasks lack the 5 rule-9 fields
	@echo "═══ tasks-rule9 fields ═══"
	@TASKS_RULE9_FILE="$(TASKS_FILE)" .github/scripts/check-tasks-rule9-fields.sh

# ── Test: affected tests only (cached — skips if tree unchanged) ─────
# JOBS = number of parallel test files. Within-file parallelism is OFF by
# default (--no-parallelize-within-files) because some test files (e.g.
# dotfiles-profile.bats) share chezmoi state and would corrupt each other
# under concurrent execution. Slow files that ARE safe to parallelize opt
# in by setting `unset BATS_NO_PARALLELIZE_WITHIN_FILE` in their setup_file().
# Currently opted in: doctor.bats (was 826s serial), morning.bats (280s).
JOBS ?= $(shell sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
# bats --jobs needs GNU parallel. The core Brewfile does not install it, so
# without `parallel` on PATH the test targets run bats serially (slower, same
# tests). Install it with `brew install parallel` or `make install-deps`.
HAS_PARALLEL := $(shell command -v parallel >/dev/null 2>&1 && echo yes)
ifeq ($(HAS_PARALLEL),yes)
BATS_JOBS := --jobs $(JOBS) --no-parallelize-within-files
JOBS_LABEL := $(JOBS) jobs
TEST_FILE_JOBS := --jobs $(JOBS)
else
BATS_JOBS :=
JOBS_LABEL := serial: GNU parallel not found
TEST_FILE_JOBS :=
endif
# make test skips an affected test file that already passed on this HEAD
# with the same content of the changed files that select it
# (bin/bats-affected --pairs feeds them to bin/cached-run --per-file --deps).
# A fix to one file re-runs only the tests that file selects.
test: ## Run affected tests only (skips tests that passed with the same inputs)
	@pairs=$$(mktemp "$${TMPDIR:-/tmp}/bats-pairs.XXXXXX") || exit 1; \
	trap 'rm -f "$$pairs"' EXIT; \
	./bin/bats-affected --pairs > "$$pairs" || exit 1; \
	affected=$$(cut -f1 "$$pairs" | LC_ALL=C sort -u); \
	if [ -z "$$affected" ]; then \
	  echo "✓ No affected test files (nothing changed)"; \
	else \
	  count=$$(echo "$$affected" | wc -l | tr -d ' '); \
	  echo "═══ Tests: $$count affected file(s) ($(JOBS_LABEL)) ═══"; \
	  $(FULLPOWER) ./bin/cached-run --per-file $(TEST_FILE_JOBS) --deps "$$pairs" \
	    --key "head=$$(git rev-parse HEAD)" bats $(BATS_JOBS) -- $$affected; \
	fi

test-all: ## Run full test suite (cached)
	@$(FULLPOWER) ./bin/cached-run bats $(BATS_JOBS) tests/ tests/plugin/

test-force: ## Run full test suite (no cache)
	@echo "═══ Tests ($(JOBS_LABEL)) ═══"
	@$(FULLPOWER) bats $(BATS_JOBS) tests/ tests/plugin/

# ── Plugin suites on macOS /bin/bash 3.2 ─────────────────────────────
# The plugin CLI's shebang is #!/bin/bash (3.2 on macOS), but the bats files
# run `bash` from PATH (often Homebrew bash 5). This target puts
# tests/bash32/bash first on PATH, so every bash they start is 3.2. A full
# run takes minutes, so it reruns only when a plugin file or /bin/bash
# changed since it last passed (the passes are shared by all worktrees).
PLUGIN_BASH32_TESTS = tests/plugin-update.bats tests/plugin-v2.bats
PLUGIN_BASH32_DEPS = bin/dotfiles-plugin bin/dotfiles $(wildcard lib/plugin*.sh) lib/confirm.sh tests/bash32/bash
test-plugins-bash32: ## Run the plugin bats suites with /bin/bash 3.2 (only when a plugin file changed)
	@if [ ! -x /bin/bash ] || ! /bin/bash -c '[ "$${BASH_VERSINFO[0]}" = 3 ]'; then \
	  echo "✓ Plugin bash 3.2 run skipped (/bin/bash is not bash 3.2)"; exit 0; fi; \
	deps=$$(mktemp "$${TMPDIR:-/tmp}/bash32-deps.XXXXXX") || exit 1; \
	trap 'rm -f "$$deps"' EXIT; \
	for t in $(PLUGIN_BASH32_TESTS); do for d in $(PLUGIN_BASH32_DEPS); do printf '%s\t%s\n' "$$t" "$$d"; done; done > "$$deps"; \
	echo "═══ Plugin suites on /bin/bash 3.2 ═══"; \
	PATH="$(CURDIR)/tests/bash32:$$PATH" ./bin/cached-run --per-file --deps "$$deps" \
	  --key "$$(/bin/bash --version | head -1)" bats -- $(PLUGIN_BASH32_TESTS)

# ── E2E: hermetic install (real chezmoi/doctor/zsh in a scratch HOME) ──
E2E_FILES = $(wildcard tests/e2e/*.bats)
e2e: ## Run the hermetic install and story e2e (about 100 s; E2E_FULL=1 for the whole doctor)
	@bats tests/e2e/

# The e2e reruns only when an installer input, chezmoi, or zsh changed since
# it last passed: its inputs are every file needs-e2e.sh counts (the passes
# are shared by all worktrees).
e2e-if-needed: ## Run the install e2e only when an installer path changed
	@if paths=$$(./tests/e2e/needs-e2e.sh); then \
	  echo "═══ Install e2e: triggered by ═══"; echo "$$paths" | sed 's/^/  /'; \
	  inputs=$$(mktemp "$${TMPDIR:-/tmp}/e2e-inputs.XXXXXX") || exit 1; \
	  trap 'rm -f "$$inputs"' EXIT; \
	  git ls-files -co --exclude-standard | ./tests/e2e/needs-e2e.sh --stdin | \
	    awk -v files="$(E2E_FILES)" 'BEGIN { n = split(files, f, " ") } { for (i = 1; i <= n; i++) print f[i] "\t" $$0 }' > "$$inputs"; \
	  ./bin/cached-run --per-file --deps "$$inputs" \
	    --key "$$(chezmoi --version 2>/dev/null | head -1); $$(zsh --version 2>/dev/null)" bats -- $(E2E_FILES); \
	else \
	  echo "✓ Install e2e skipped (no installer path changed)"; \
	fi

# ── Check: lint + task queue lint + test ─────────────────────────────
# Each step's duration goes to ~/.local/state/dotfiles/gate-timings.jsonl
# (scripts/gate-timed.sh) for the monthly speed review in /tooling-checkup.
check: ## Lint + task queue lint + test + install e2e when needed (timed)
	@scripts/gate-timed.sh total $(MAKE) --no-print-directory check-steps
	@echo ""
	@echo "✓ All checks passed"
	@echo "  Iterating? Use make lint and bats tests/<name>.bats; run make check once before you commit."

check-steps:
	@scripts/gate-timed.sh lint $(MAKE) --no-print-directory lint
	@scripts/gate-timed.sh lint-tasks $(MAKE) --no-print-directory lint-tasks
	@scripts/gate-timed.sh test $(MAKE) --no-print-directory test
	@scripts/gate-timed.sh plugins-bash32 $(MAKE) --no-print-directory test-plugins-bash32
	@scripts/gate-timed.sh e2e $(MAKE) --no-print-directory e2e-if-needed

changelog: ## Regenerate CHANGELOG.md from conventional commits (never edit it by hand)
	@scripts/changelog.sh > CHANGELOG.md && echo "✓ CHANGELOG.md regenerated"

audit: ## Run security and repo-hygiene audit
	@./bin/dotfiles-audit

# ── Install development dependencies ─────────────────────────────────
install-deps: ## Install required dev tools plus fmt/coverage helpers
	brew install $(DEV_DEPS) $(OPTIONAL_DEV_DEPS)

# ── Count: show live stats (never copy them into docs) ──
# COUNT_TESTS narrows the bats files counted (tests/verify-counts.bats uses one
# file, so the test does not parse the whole suite).
COUNT_TESTS ?= tests/*.bats
count: ## Show test, module, and check counts
	@tests=$$(bats --count $(COUNT_TESTS) 2>/dev/null | awk '{s+=$$1}END{print s}'); \
	files=$$(ls $(COUNT_TESTS) 2>/dev/null | wc -l | tr -d ' '); \
	modules=$$(ls -d modules/*/doctor.sh 2>/dev/null | wc -l | tr -d ' '); \
	checks=$$(grep -rhc '^\s*check' modules/*/doctor.sh 2>/dev/null | awk '{s+=$$1}END{print s}'); \
	macos_total=$$(jq 'length' data/macos-defaults.json); \
	macos_core=$$(jq '[.[] | select(.script == "core")] | length' data/macos-defaults.json); \
	macos_visual=$$(jq '[.[] | select(.script == "visual")] | length' data/macos-defaults.json); \
	macos_apps=$$(jq '[.[] | select(.script == "apps")] | length' data/macos-defaults.json); \
	printf "Tests:   %s across %s bats files\n" "$$tests" "$$files"; \
	printf "Modules: %s\n" "$$modules"; \
	printf "Checks:  %s\n" "$$checks"; \
	printf "macOS defaults: %s total (%s core, %s visual, %s apps)\n" "$$macos_total" "$$macos_core" "$$macos_visual" "$$macos_apps"

# ── Clean: remove test artifacts and caches ──────────────────────────
clean: ## Remove test cache and tmp artifacts
	@rm -rf .bats-run-cache/
	@rm -rf tmp/ .tmp/
	@rm -rf coverage/
	@echo "✓ Cleaned test cache and artifacts"

# ── Format: auto-format shell scripts with shfmt ─────────────────────
fmt: ## Format shell scripts (requires shfmt)
	@if command -v shfmt >/dev/null 2>&1; then \
	  shfmt -w -i 2 -ci bin/ lib/ modules/ macos.sh macos-visual.sh macos-apps.sh snapshot.sh 2>/dev/null; \
	  echo "✓ Formatted shell scripts with shfmt"; \
	else \
	  echo "shfmt not found — install with: brew install shfmt"; \
	fi

# ── Coverage: run tests with custom shell-trace harness ──────────────
# We use bin/dotfiles-coverage (a portable BASH_ENV-based harness) instead
# of kcov because kcov 43 produces empty coverage.json on macOS Tahoe (SIP
# blocks the DYLD_INSERT_LIBRARIES dance kcov needs to follow bats's `bash
# CMD` subprocesses). The harness works on Linux CI and macOS local dev.
# See docs/ci-setup.md for the full rationale.
coverage: ## Run tests with line coverage (uses bin/dotfiles-coverage)
	@bin/dotfiles-coverage run tests/
	@echo ""
	@.github/scripts/check-shell-coverage.sh coverage/bats/coverage.json .shell-coverage-floor
