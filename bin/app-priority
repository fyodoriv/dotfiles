#!/bin/bash
# Keep core work apps interactive while backgrounding agent/model workers.
# Runs every 60s via LaunchAgent.
# Usage: app-priority

set -euo pipefail
{ [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; } && { sed -n '/^#!/d; /^$/q; /^[^#]/q; /^# shellcheck/d; s/^# \{0,1\}//p' "$0"; exit 0; }

clock_ms() {
  perl -MTime::HiRes=clock_gettime,CLOCK_MONOTONIC -e 'printf "%.0f\n", clock_gettime(CLOCK_MONOTONIC) * 1000' 2>/dev/null
}
start_ms=$(clock_ms) || start_ms=""

# shellcheck source=../lib/stats.sh
source "$(cd "$(dirname "$0")/.." && pwd)/lib/stats.sh"

finish_priority_run() {
  local outcome="$1" end_ms
  end_ms=$(clock_ms) || end_ms=""
  if [[ "$start_ms" =~ ^[0-9]{1,12}$ && "$end_ms" =~ ^[0-9]{1,12}$ ]] && (( end_ms >= start_ms && end_ms - start_ms <= 9999999999 )); then
    log_run app-priority 1 "$outcome" "$((end_ms - start_ms))" "" monotonic-ms rust
  else
    log_run app-priority 1 "$outcome" "" "" "" rust
  fi
}

# The installer changes this link only after a complete, checked build.
native_dir="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/native/app-priority"
if [ -L "$native_dir/current" ]; then
  native_name="$(readlink "$native_dir/current")" || native_name=""
  if [[ "$native_name" =~ ^app-priority-[0-9a-f]{64}$ ]] && [ -f "$native_dir/$native_name" ] && [ ! -L "$native_dir/$native_name" ] && [ -x "$native_dir/$native_name" ]; then
    if [ -x /sbin/sha256 ]; then
      native_hash="$(/sbin/sha256 -q "$native_dir/$native_name")" || native_hash=""
    else
      native_hash="$(shasum -a 256 "$native_dir/$native_name" | cut -d' ' -f1)" || native_hash=""
    fi
    if [ "$native_hash" = "${native_name#app-priority-}" ]; then
      native_status=0
      "$native_dir/$native_name" --apply || native_status=$?
      if [ "$native_status" -eq 0 ]; then finish_priority_run ok; else finish_priority_run error; fi
      exit "$native_status"
    fi
  fi
fi

if [ ! -e "$native_dir/current" ] && [ ! -L "$native_dir/current" ] &&
  { [ -e "$native_dir/disabled" ] || [ -L "$native_dir/disabled" ]; }; then
  exit 0
fi
echo "App Priority: verified native binary unavailable. Run dotfiles priority-native install." >&2
exit 1
