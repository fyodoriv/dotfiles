#!/bin/bash
# Install or roll back the native app-priority candidate.
# Usage:
#   dotfiles priority-native install   Build offline and enable native dispatch
#   dotfiles priority-native rollback [--native]  Restore shell or the verified previous binary
set -euo pipefail

app_priority_root="$(cd "$(dirname "$0")/.." && pwd)"
directory="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/native/app-priority"
# shellcheck source=../lib/native-delivery.sh
source "$app_priority_root/lib/native-delivery.sh"

lock_install() {
  (umask 077; mkdir -p "$directory")
  # The sourced lock library reads this installation's lock path.
  # shellcheck disable=SC2034
  DOTFILES_LOCK="$directory/.install.lock"
  # shellcheck source=../lib/lock.sh
  source "$app_priority_root/lib/lock.sh"
  wait_for_lock "app-priority-$1" "${DOTFILES_NATIVE_BUILD_MAX_WAIT:-600}" "${2:-process}"
}

verify_native_copy() {
  local status=0
  "$1" || status=$?
  if [ "$status" -ne 2 ]; then
    echo 'App Priority: expected exit 2 without --apply.' >&2
    return 1
  fi
}

verify_native_target() {
  local target="$1" artifact digest
  [[ "$target" =~ ^app-priority-[0-9a-f]{64}$ ]] || return 1
  artifact="$directory/$target"
  [ -f "$artifact" ] && [ ! -L "$artifact" ] && [ -x "$artifact" ] || return 1
  digest="$(shasum -a 256 "$artifact")" || return 1
  [ "${digest%% *}" = "${target#app-priority-}" ]
}

record_native_predecessor() (
  local prior="$1" next="$2" receipt temporary
  [ "$prior" != "$next" ] || exit 0
  receipt="$directory/predecessor-$next"
  if [ -L "$receipt" ] || { [ -e "$receipt" ] && [ ! -f "$receipt" ]; }; then
    echo 'App Priority: refusing to replace an unowned predecessor receipt.' >&2
    exit 1
  fi
  if ! verify_native_target "$prior"; then
    rm -f "$receipt"
    exit $?
  fi
  temporary="$(mktemp "$directory/.predecessor.XXXXXXXX")" || exit 1
  trap 'rm -f "$temporary"' EXIT
  printf '%s\n' "$prior" > "$temporary" || exit 1
  mv -f "$temporary" "$receipt"
)

check_rollback_hold() {
  if [ -L "$directory/disabled" ] || { [ -e "$directory/disabled" ] && [ ! -f "$directory/disabled" ]; }; then
    echo 'App Priority: unowned rollback hold.' >&2
    return 1
  fi
}

restore_native_predecessor() {
  local current prior receipt added_hold=false
  current="$(readlink "$directory/current" 2>/dev/null)" || current=""
  if [[ ! "$current" =~ ^app-priority-[0-9a-f]{64}$ ]] || [ -d "$directory/current" ]; then
    echo 'App Priority: an owned current native selection is required for rollback.' >&2
    return 1
  fi
  receipt="$directory/predecessor-$current"
  if [ ! -f "$receipt" ] || [ -L "$receipt" ] ||
    ! IFS= read -r prior < "$receipt" || [ "$prior" = "$current" ] ||
    ! verify_native_target "$prior" || ! verify_native_copy "$directory/$prior"; then
    echo 'App Priority: the previous native binary could not be verified.' >&2
    return 1
  fi
  check_rollback_hold || return 1
  if [ ! -e "$directory/disabled" ]; then
    (umask 077; touch "$directory/disabled") || return 1
    added_hold=true
  fi
  if ! native_delivery_select "$directory" "$prior"; then
    if $added_hold; then rm -f "$directory/disabled"; fi
    return 1
  fi
  echo 'Previous native App Priority restored. Automatic refresh is paused.'
}

prepare_toolchain() {
  # shellcheck source=../lib/app-priority-toolchain.sh
  source "$app_priority_root/lib/app-priority-toolchain.sh"
  app_priority_toolchain_prepare "$directory/toolchain"
}

ensure_first_native() {
  local artifact
  if [ -e "$directory/current" ] || [ -L "$directory/current" ] ||
    [ -e "$directory/disabled" ] || [ -L "$directory/disabled" ]; then return 0; fi
  # Older rollback removed current and left the verified artifact in place.
  for artifact in "$directory"/app-priority-*; do
    if [[ "${artifact##*/}" =~ ^app-priority-[0-9a-f]{64}$ ]]; then return 0; fi
  done
  prepare_toolchain
  native_delivery_install "$app_priority_root" app-priority dotfiles-app-priority "$directory" app-priority app-priority-native verify_native_copy record_native_predecessor
  record_source_hash "${1:-}"
  echo 'Native app-priority installed.'
}

record_source_hash() {
  if [ -n "${1:-}" ] && ! printf '%s\n' "$1" > "$directory/source-hash"; then
    echo 'App Priority: could not record the build source.' >&2
  fi
}

show_usage() {
  printf '%s\n' 'Usage: dotfiles priority-native install' '       dotfiles priority-native rollback [--native]'
}

case "${1:-}" in
  --help|-h) show_usage; exit 0 ;;
  install|refresh)
    lock_install "$1"
    previous_selection=""
    if [ "$1" = install ]; then
      check_rollback_hold
      if [ -f "$directory/disabled" ] && [ -L "$directory/current" ]; then
        previous_selection="$(readlink "$directory/current")"
      fi
    fi
    if [ "$1" = refresh ] && { [ ! -L "$directory/current" ] ||
      [ -e "$directory/disabled" ] || [ -L "$directory/disabled" ]; }; then exit 0; fi
    if [ -d "$directory/toolchain" ]; then prepare_toolchain; fi
    native_delivery_install "$app_priority_root" app-priority dotfiles-app-priority "$directory" app-priority app-priority-native "" record_native_predecessor
    if [ "$1" = install ]; then
      if [ -f "$directory/disabled" ] && ! rm -f "$directory/disabled"; then
        echo 'App Priority: could not clear the rollback hold.' >&2
        if [ -n "$previous_selection" ]; then
          native_delivery_select "$directory" "$previous_selection" ||
            echo 'App Priority: could not restore the previous selection.' >&2
        else
          native_delivery_rollback "$directory" app-priority app-priority-native
        fi
        exit 1
      fi
    else
      record_source_hash "${2:-}"
    fi
    echo 'Native app-priority installed.'
    ;;
  ensure)
    [ "$(uname -s)" = Darwin ] || exit 1
    # shellcheck source=../lib/app-priority-build.sh
    source "$app_priority_root/lib/app-priority-build.sh"
    app_priority_build_with_timeout "${DOTFILES_NATIVE_BUILD_MAX_WAIT:-600}" \
      "$app_priority_root/bin/app-priority-native" ensure-worker "${2:-}"
    ;;
  ensure-worker)
    [ "$(uname -s)" = Darwin ] || exit 1
    # Keep the lock while the worker builds and publishes the first install.
    lock_install ensure group
    ensure_first_native "${2:-}"
    release_lock
    ;;
  rollback)
    if [ "$#" -gt 2 ] || { [ "$#" -eq 2 ] && [ "$2" != --native ]; }; then
      show_usage >&2
      exit 2
    fi
    lock_install rollback
    if [ "${2:-}" = --native ]; then
      restore_native_predecessor
    else
      native_delivery_rollback "$directory" app-priority app-priority-native
      (umask 077; touch "$directory/disabled")
      echo 'Shell app-priority restored.'
    fi
    ;;
  *) show_usage >&2; exit 2 ;;
esac
