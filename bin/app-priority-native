#!/bin/bash
# Install or roll back the native app-priority candidate.
# Usage:
#   dotfiles priority-native install   Build offline and enable native dispatch
#   dotfiles priority-native rollback  Restore the shell dispatch
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
directory="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/native/app-priority"
# shellcheck source=../lib/native-delivery.sh
source "$root/lib/native-delivery.sh"

case "${1:-}" in
  --help|-h) echo 'Usage: dotfiles priority-native install|rollback'; exit 0 ;;
  install)
    native_delivery_install "$root" app-priority dotfiles-app-priority "$directory" app-priority app-priority-native
    echo 'Native app-priority installed.'
    ;;
  rollback)
    native_delivery_rollback "$directory" app-priority app-priority-native
    echo 'Shell app-priority restored.'
    ;;
  *) echo 'Usage: app-priority-native install|rollback' >&2; exit 2 ;;
esac
