#!/bin/bash
# bats-affected — print bats test files affected by git changes.
#
# Uses git diff to find changed files, then resolves each to the test
# files that cover it.  Falls back to running all tests when changes
# touch shared infrastructure (test_helper, Makefile, etc.).
#
# Usage:
#   bats-affected              # changed vs HEAD, plus branch commits ahead of the base
#   bats-affected --cached     # staged only
#   bats-affected HEAD~3       # changed in last 3 commits
#   bats-affected main          # changed vs main branch
#   bats-affected --pairs [ref] # "test<TAB>changed file" for each match
#
# Output: newline-separated list of test file paths (deduped, sorted).
# With --pairs, one "test<TAB>changed file" line per reason a test runs
# (make test uses them to skip a test none of whose changed files changed
# since it last passed). Exits 0 with no output when nothing is affected.

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TESTS_DIR="$DOTFILES_DIR/tests"
# shellcheck source=tests/verify-counts-doc-paths.sh
source "$DOTFILES_DIR/tests/verify-counts-doc-paths.sh"

# ── Parse args ───────────────────────────────────────────────────────
pairs=0
if [ "${1:-}" = "--pairs" ]; then
  pairs=1
  shift
fi
diff_args=()
include_untracked=0
case "${1:-}" in
  --help|-h)
    sed -n '2,/^$/s/^# //p' "$0"
    exit 0
    ;;
  --cached)
    diff_args=(--cached)
    ;;
  "")
    # Default: uncommitted changes vs HEAD, plus the branch's own commits
    # when HEAD is ahead of the base (BATS_AFFECTED_BASE, default
    # origin/feat/chezmoi), so `make check` after a commit still tests it.
    diff_args=(HEAD)
    include_untracked=1
    if base=$(git -C "$DOTFILES_DIR" merge-base HEAD "${BATS_AFFECTED_BASE:-origin/feat/chezmoi}" 2>/dev/null) &&
      [ "$base" != "$(git -C "$DOTFILES_DIR" rev-parse HEAD)" ]; then
      diff_args=("$base")
    fi
    ;;
  *)
    diff_args=("$1")
    ;;
esac

# ── Collect changed files (relative to repo root) ───────────────────
changed_files=()
while IFS= read -r file; do
  [ -n "$file" ] && changed_files+=("$file")
done < <(git -C "$DOTFILES_DIR" diff --name-only "${diff_args[@]}" 2>/dev/null || true)

# Also include untracked files (only for default/HEAD mode)
if [ "${include_untracked:-0}" -eq 1 ]; then
  while IFS= read -r file; do
    [ -n "$file" ] && changed_files+=("$file")
  done < <(git -C "$DOTFILES_DIR" ls-files --others --exclude-standard 2>/dev/null || true)
fi

# Nothing changed → nothing to test
if [ "${#changed_files[@]}" -eq 0 ]; then
  exit 0
fi

# ── Mapping tables ───────────────────────────────────────────────────

# bin/dotfiles-X → tests/X.bats  (strip "dotfiles-" prefix)
# bin/X          → tests/X.bats  (direct name)
# Special: bin/dotfiles → tests/cli.bats
#          bin/cheat    → tests/cli.bats
#          bin/gh       → tests/gh-wrapper.bats, tests/gh-wrapper-leak-guard.bats
#          bin/git      → tests/git-wrapper.bats
#          bin/dotfiles-add + bin/dotfiles-unmanage → tests/add-unmanage.bats
#          bin/dotfiles-new-module, bin/dotfiles-brew-add,
#          bin/dotfiles-defaults-add, bin/dotfiles-profile → tests/scaffolding.bats
#          plus a focused tests/dotfiles-*.bats file when one exists
#          bin/dotfiles-audit → tests/audit.bats
#          bin/dotfiles-stats → tests/stats.bats
#          bin/dotfiles-doctor → tests/doctor.bats
#          bin/dotfiles-enterprise → tests/enterprise.bats
#          bin/dotfiles-uninstall → tests/uninstall.bats
#          bin/dotfiles-sync → tests/dotfiles-sync.bats

# lib dependencies (lib file → test files that depend on it)
# Built by grepping which bin/ scripts source each lib file,
# then mapping those bin scripts to their tests.

# Files that trigger ALL tests
run_all_patterns=(
  "tests/test_helper.bash"
)

# Files that trigger smoke tests
smoke_patterns=(
  "modules/"
  "macos.sh"
  "macos-visual.sh"
  "macos-apps.sh"
  "launchagents/"
  ".chezmoiscripts/"
  "symlink_dot_"
  "dot_"
  "private_dot_"
  "home/"
)

affected=()
# --pairs: pair_owner[i] is the changed file that put affected[i] in the list.
# pairs_note runs at the top of each loop pass (and after each loop), so the
# entries added since the last note belong to the file before.
pair_owner=()
pairs_cur=""
run_all_files=()
pairs_note() {
  while [ "${#pair_owner[@]}" -lt "${#affected[@]}" ]; do pair_owner+=("$pairs_cur"); done
  pairs_cur="${1:-}"
}

for file in "${changed_files[@]}"; do
  pairs_note "$file"
  # ── Run-all triggers ─────────────────────────────────────────────
  run_all=0
  for pattern in "${run_all_patterns[@]}"; do
    if [[ "$file" == "$pattern" || "$file" == "$pattern"* ]]; then
      run_all=1
    fi
  done
  if [ "$run_all" -eq 1 ]; then
    if [ "$pairs" -eq 0 ]; then
      # Output all test files and exit
      find "$TESTS_DIR" -name '*.bats' -not -path "$TESTS_DIR/e2e/*" | sort
      exit 0
    fi
    # Every test depends on this file; pair it with each one at the end.
    run_all_files+=("$file")
    continue
  fi

  # ── Test files themselves ────────────────────────────────────────
  if [[ "$file" == tests/*.bats ]]; then
    [ -f "$DOTFILES_DIR/$file" ] && affected+=("$DOTFILES_DIR/$file")
    continue
  fi

  # ── Source-owned agent skills ─────────────────────────────────────
  if [[ "$file" == skills/update-tooling/* ]]; then
    affected+=("$TESTS_DIR/update-tooling-skill.bats")
    continue
  fi

  if [[ "$file" == skills/tooling-checkup/* ]]; then
    affected+=("$TESTS_DIR/tooling-checkup-skill.bats")
    continue
  fi

  if [[ "$file" == Agentfile.yaml ]]; then
    affected+=("$TESTS_DIR/agent-artifact-coverage.bats")
    affected+=("$TESTS_DIR/update-tooling-skill.bats")
    affected+=("$TESTS_DIR/tooling-checkup-skill.bats")
    # verify-counts.bats scans Agentfile.yaml too (is_verify_counts_doc_path)
    affected+=("$TESTS_DIR/verify-counts.bats")
    continue
  fi

  # ── bin/ scripts ─────────────────────────────────────────────────
  if [[ "$file" == bin/* ]]; then
    local_name="$(basename "$file")"

    case "$local_name" in
      dotfiles)
        affected+=("$TESTS_DIR/cli.bats")
        ;;
      cheat)
        affected+=("$TESTS_DIR/cli.bats")
        ;;
      gh)
        affected+=("$TESTS_DIR/gh-wrapper.bats" "$TESTS_DIR/gh-wrapper-leak-guard.bats")
        ;;
      git)
        affected+=("$TESTS_DIR/git-wrapper.bats")
        ;;
      dotfiles-add|dotfiles-unmanage)
        affected+=("$TESTS_DIR/add-unmanage.bats")
        ;;
      dotfiles-new-module|dotfiles-brew-add|dotfiles-defaults-add|dotfiles-profile)
        affected+=("$TESTS_DIR/scaffolding.bats")
        [ -f "$TESTS_DIR/$local_name.bats" ] && affected+=("$TESTS_DIR/$local_name.bats")
        ;;
      dotfiles-*)
        # Strip "dotfiles-" prefix → tests/<name>.bats
        short="${local_name#dotfiles-}"
        if [ -f "$TESTS_DIR/$short.bats" ]; then
          affected+=("$TESTS_DIR/$short.bats")
        elif [ -f "$TESTS_DIR/$local_name.bats" ]; then
          affected+=("$TESTS_DIR/$local_name.bats")
        fi
        ;;
      *)
        # Direct mapping: bin/X → tests/X.bats
        if [ -f "$TESTS_DIR/$local_name.bats" ]; then
          affected+=("$TESTS_DIR/$local_name.bats")
        fi
        ;;
    esac

    # Every bin/ change also triggers smoke tests
    affected+=("$TESTS_DIR/smoke.bats")
    continue
  fi

  # ── lib/ files ───────────────────────────────────────────────────
  if [[ "$file" == lib/* ]]; then
    local_name="$(basename "$file" .sh)"

    # Direct test for the lib itself (e.g. lib/output.sh → tests/output.bats)
    if [ -f "$TESTS_DIR/$local_name.bats" ]; then
      affected+=("$TESTS_DIR/$local_name.bats")
    fi

    # Find bin/ scripts that source this lib file, then map to their tests
    while IFS= read -r bin_script; do
      [ -n "$bin_script" ] || continue
      bin_name="$(basename "$bin_script")"
      # Reuse the same bin→test mapping
      case "$bin_name" in
        dotfiles)        affected+=("$TESTS_DIR/cli.bats") ;;
        cheat)           affected+=("$TESTS_DIR/cli.bats") ;;
        gh)              affected+=("$TESTS_DIR/gh-wrapper.bats" "$TESTS_DIR/gh-wrapper-leak-guard.bats") ;;
        git)             affected+=("$TESTS_DIR/git-wrapper.bats") ;;
        dotfiles-add|dotfiles-unmanage)    affected+=("$TESTS_DIR/add-unmanage.bats") ;;
        dotfiles-new-module|dotfiles-brew-add|dotfiles-defaults-add|dotfiles-profile)
          affected+=("$TESTS_DIR/scaffolding.bats")
          [ -f "$TESTS_DIR/$bin_name.bats" ] && affected+=("$TESTS_DIR/$bin_name.bats")
          ;;
        dotfiles-*)
          short="${bin_name#dotfiles-}"
          [ -f "$TESTS_DIR/$short.bats" ] && affected+=("$TESTS_DIR/$short.bats")
          [ -f "$TESTS_DIR/$bin_name.bats" ] && affected+=("$TESTS_DIR/$bin_name.bats")
          ;;
        *)
          [ -f "$TESTS_DIR/$bin_name.bats" ] && affected+=("$TESTS_DIR/$bin_name.bats")
          ;;
      esac
    done < <(grep -rl "$(basename "$file")" "$DOTFILES_DIR/bin/" 2>/dev/null || true)
    continue
  fi

  # ── git-hooks/ ───────────────────────────────────────────────────
  if [[ "$file" == git-hooks/* ]]; then
    case "$file" in
      git-hooks/pre-commit) affected+=("$TESTS_DIR/pre-commit.bats") ;;
      git-hooks/commit-msg) affected+=("$TESTS_DIR/commit-msg.bats") ;;
      git-hooks/pre-push)   affected+=("$TESTS_DIR/pre-push.bats") ;;
      *)                    affected+=("$TESTS_DIR/pre-commit.bats") ;;
    esac
    affected+=("$TESTS_DIR/smoke.bats")
    continue
  fi

  # ── Doc paths scanned by tests/verify-counts.bats ─────────────────
  if is_verify_counts_doc_path "$file"; then
    affected+=("$TESTS_DIR/verify-counts.bats")
    continue
  fi

  # ── CI helpers and make gates ─────────────────────────────────────
  case "$file" in
    .github/scripts/brew-audit-manifest.sh|.github/workflows/brew-audit.yml)
      affected+=("$TESTS_DIR/brew-audit.bats")
      continue
      ;;
    .github/scripts/check-shell-coverage.sh|.shell-coverage-floor)
      affected+=("$TESTS_DIR/coverage.bats")
      continue
      ;;
    .github/workflows/ci.yml)
      affected+=("$TESTS_DIR/coverage.bats")
      affected+=("$TESTS_DIR/tasks-lint.bats")
      continue
      ;;
    .tasks-lint-version)
      affected+=("$TESTS_DIR/tasks-lint.bats")
      continue
      ;;
    Makefile)
      affected+=("$TESTS_DIR/coverage.bats")
      affected+=("$TESTS_DIR/tasks-lint.bats")
      affected+=("$TESTS_DIR/verify-counts.bats")
      continue
      ;;
  esac

  # ── Smoke-test triggers (modules, macos, templates, home/) ───────
  for pattern in "${smoke_patterns[@]}"; do
    if [[ "$file" == "$pattern"* ]]; then
      affected+=("$TESTS_DIR/smoke.bats")
      # home/ and chezmoi template changes also affect chezmoi tests
      if [[ "$file" == home/* || "$file" == symlink_dot_* || "$file" == dot_* || "$file" == private_dot_* ]]; then
        affected+=("$TESTS_DIR/chezmoi.bats")
      fi
      # module changes affect doctor tests
      if [[ "$file" == modules/* ]]; then
        affected+=("$TESTS_DIR/doctor.bats")
      fi
      break
    fi
  done
done

# ── Tests that read a changed file by repo path ──────────────────────
# Search every bats file, subfolders included (tests/plugin/); tests/e2e/ runs
# through tests/e2e/needs-e2e.sh instead.
all_bats=()
while IFS= read -r bats_file; do
  all_bats+=("$bats_file")
done < <(find "$TESTS_DIR" -name '*.bats' -not -path "$TESTS_DIR/e2e/*" | LC_ALL=C sort)

# Per test file: the variables that point into the repo. Fixed names plus any
# variable the file assigns from $BATS_TEST_DIRNAME or $BATS_TEST_FILENAME
# (REAL_DOTFILES, ROOT, ...).
# One awk pass over every file instead of several processes per file: the
# selector runs on every test run, and process start-up dominated its time.
# Each output line is: file, roots regex, derived "VAR sub" pairs joined by ";".
# shellcheck disable=SC2016 # awk program, not shell
roots_awk='
function flush(   n, i, j, t, own, re, m, name, v, sub_, derived) {
  if (file == "") return
  n = 0
  for (i = 1; i <= nl; i++) {
    if (lines[i] !~ /^[[:space:]]*(export[[:space:]]+|local[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=.*BATS_TEST_(DIRNAME|FILENAME)/) continue
    name = var_name(lines[i])
    if (!(name in seen)) { seen[name] = 1; names[++n] = name }
  }
  for (i = 2; i <= n; i++) for (j = i; j > 1 && names[j - 1] > names[j]; j--) { t = names[j]; names[j] = names[j - 1]; names[j - 1] = t }
  own = ""
  for (i = 1; i <= n; i++) own = own (i > 1 ? "|" : "") names[i]
  roots = "REPO_ROOT|DOTFILES_DIR|REPO|root|BATS_TEST_DIRNAME/\\.\\." (own != "" ? "|" own : "")
  re = "^[[:space:]]*(export[[:space:]]+|local[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=\"?[$][{]?(" roots ")[}]?/[A-Za-z0-9_./-]+"
  derived = ""
  for (i = 1; i <= nl; i++) {
    if (!match(lines[i], re)) continue
    m = substr(lines[i], 1, RLENGTH)
    name = var_name(m)
    v = substr(m, index(m, "=") + 1)
    sub_ = substr(v, index(v, "/") + 1)
    sub(/\/$/, "", sub_)
    derived = derived (derived != "" ? ";" : "") name " " sub_
  }
  printf "%s\t%s\t%s\n", file, roots, derived
  split("", seen); split("", names); nl = 0
}
function var_name(l) {
  sub(/^[[:space:]]*/, "", l)
  if (l ~ /^(export|local)[[:space:]]+/) sub(/^(export|local)[[:space:]]+/, "", l)
  return substr(l, 1, index(l, "=") - 1)
}
FNR == 1 { flush(); file = FILENAME }
{ lines[++nl] = $0 }
END { flush() }
'
rec_files=()
rec_roots=()
rec_derived=()
while IFS=$'\t' read -r rec_file rec_root rec_pairs; do
  rec_files+=("$rec_file")
  rec_roots+=("$rec_root")
  rec_derived+=("${rec_pairs//;/$'\n'}")
done < <(awk "$roots_awk" "${all_bats[@]}" </dev/null 2>/dev/null || true)
bats_roots=()
bats_derived=()
r=0
for bats_file in "${all_bats[@]}"; do
  # awk skips empty files, so they get the fixed roots and no derived folders.
  if [ "$r" -lt "${#rec_files[@]}" ] && [ "${rec_files[$r]}" = "$bats_file" ]; then
    bats_roots+=("${rec_roots[$r]}")
    bats_derived+=("${rec_derived[$r]}")
    r=$((r + 1))
  else
    bats_roots+=("REPO_ROOT|DOTFILES_DIR|REPO|root|BATS_TEST_DIRNAME/\.\.")
    bats_derived+=("")
  fi
done
# A test that reads "$REPO_ROOT/<file>" (or $DOTFILES_DIR, $root, or
# $BATS_TEST_DIRNAME/..) depends on that file even with no rule above, so it
# runs too. A test that only names a fixture file of the same name does not,
# and neither does a fixture path whose variable only ends in a root name
# ("$TEST_REPO/Agentfile.yaml"): the match starts at the `$`.
pairs_note
for file in "${changed_files[@]}"; do
  pairs_note "$file"
  [[ "$file" == tests/*.bats ]] && continue
  # A helper or fixture under tests/ is read by its path relative to tests/
  # ("$BATS_TEST_DIRNAME/fixtures/x" or "fixtures/x").
  # A test may also read the folder that holds it (a fixture tree), so each
  # parent folder up to tests/fixtures/<name> counts as read too.
  if [[ "$file" == tests/* ]]; then
    reads="${file#tests/}"
    dir="$(dirname "$file")"
    while [ "$dir" != tests ] && [ "$dir" != tests/fixtures ] && [ "$dir" != . ]; do
      reads="$reads
${dir#tests/}"
      dir="$(dirname "$dir")"
    done
    while IFS= read -r test_file; do
      [ -n "$test_file" ] && affected+=("$test_file")
    done < <(grep -lF -f <(printf '%s\n' "$reads") "${all_bats[@]}" 2>/dev/null || true)
    continue
  fi
  escaped="$(printf '%s' "$file" | sed 's/[][\\.*^$/+?(){}|]/\\&/g')"
  # bats runs from the repo root, so a test may also read a path as written
  # ("./agent-hooks/x.sh", "launchagents/x.plist.tmpl"). A root-level file
  # needs the "./" (a bare TASKS.md is usually a fixture name).
  if [[ "$file" == */* ]]; then rel="(\./)?$escaped"; else rel="\./$escaped"; fi
  for i in "${!all_bats[@]}"; do
    if grep -qE -- "\\\$\{?(${bats_roots[$i]})\}?\"?/$escaped([^A-Za-z0-9_.-]|$)|(^|[[:space:]\"'(=])$rel([^A-Za-z0-9_.-]|$)" "${all_bats[$i]}" 2>/dev/null; then
      affected+=("${all_bats[$i]}")
      continue
    fi
    while read -r var sub; do
      [ -n "$var" ] && [[ "$file" == "$sub/"* ]] || continue
      rest="$(printf '%s' "${file#"$sub"/}" | sed 's/[][\\.*^$/+?(){}|]/\\&/g')"
      if grep -qE -- "\\\$\{?$var\}?\"?/$rest([^A-Za-z0-9_.-]|$)" "${all_bats[$i]}" 2>/dev/null; then
        affected+=("${all_bats[$i]}")
        break
      fi
    done <<< "${bats_derived[$i]}"
  done
done

pairs_note

# ── Deduplicate and sort ─────────────────────────────────────────────
if [ "$pairs" -eq 1 ]; then
  {
    if [ "${#affected[@]}" -gt 0 ]; then
      for i in "${!affected[@]}"; do printf '%s\t%s\n' "${affected[$i]}" "${pair_owner[$i]}"; done
    fi
    if [ "${#run_all_files[@]}" -gt 0 ]; then
      for f in "${run_all_files[@]}"; do
        for t in "${all_bats[@]}"; do printf '%s\t%s\n' "$t" "$f"; done
      done
    fi
  } | LC_ALL=C sort -u
  exit 0
fi

if [ "${#affected[@]}" -eq 0 ]; then
  exit 0
fi

printf '%s\n' "${affected[@]}" | sort -u
