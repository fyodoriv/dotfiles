#!/bin/bash
# cached-run — skip commands when the git working tree hasn't changed.
#
# Caches results by hashing: repo path + command + HEAD + diff + untracked files.
# On cache hit, prints the cached status and exits 0.
# On cache miss, runs the command and caches the result on success.
#
# Usage:
#   cached-run make check
#   cached-run npm test
#   cached-run --clear          # clear cache for current repo
#   cached-run --status         # show what's cached
#   cached-run --clear-all      # clear entire cache
#
# Per-file mode (make lint):
#   cached-run --per-file [--jobs N] [--key TEXT] [--deps FILE] <command...> -- <file...>
# Runs `<command...> <file>` for each file, in parallel, and skips a file
# whose content, sourced files, extra --deps inputs, command, and --key
# already passed. These passes are shared by every worktree and clone (the
# repo path is not part of the key).

set -euo pipefail

CACHE_DIR="${CACHED_RUN_DIR:-$HOME/.cache/cached-run}"
MAX_AGE_DAYS=30

usage() {
  echo "Usage: cached-run [options] <command...>"
  echo ""
  echo "Run a command only if the git working tree changed since last success."
  echo ""
  echo "Options:"
  echo "  --clear       Clear cached results for the current repo"
  echo "  --clear-all   Clear the entire cache"
  echo "  --status      Show what's cached for the current repo"
  echo "  --help, -h    Show this help"
  echo ""
  echo "Per-file mode:"
  echo "  cached-run --per-file [--jobs N] [--key TEXT] [--deps FILE] <command...> -- <file...>"
  echo "  Run '<command...> <file>' for each file (N at a time, default 1) and skip a file"
  echo "  that already passed with the same content, the same files it sources"
  echo "  (source/. with a constant path, '# shellcheck source=' directives), the"
  echo "  same command, and the same --key. Put tool versions and config in --key."
  echo "  --deps FILE adds inputs: lines of 'file<TAB>input' (bin/bats-affected"
  echo "  --pairs writes them). Passes are shared across worktrees and clones."
  echo ""
  echo "Examples:"
  echo "  cached-run make check"
  echo "  cached-run npm test"
  echo "  cached-run shellcheck bin/*"
  echo "  cached-run --per-file --key \"\$(shellcheck --version)\" shellcheck -- bin/*"
  echo ""
  echo "Environment:"
  echo "  CACHED_RUN_DIR   Cache directory (default: ~/.cache/cached-run)"
}

# Get the git repo root, or fail
repo_root() {
  git rev-parse --show-toplevel 2>/dev/null
}

# Compute a fingerprint of the current working tree state.
# Includes: HEAD SHA, all tracked file changes (staged + unstaged),
# and untracked file names plus their contents (respects .gitignore), so an
# edit to any file a step can read changes the key.
repo_hash() {
  local root="$1"
  (
    cd "$root"
    # HEAD commit (or "initial" for repos with no commits)
    git rev-parse HEAD 2>/dev/null || echo "initial"
    # All changes to tracked files (staged + unstaged vs HEAD)
    git diff HEAD 2>/dev/null || true
    # Untracked files: names (a new file invalidates) and content hashes
    # (an edit to an untracked file invalidates too)
    local untracked
    untracked="$(git ls-files --others --exclude-standard 2>/dev/null | LC_ALL=C sort)"
    printf '%s\n' "$untracked"
    if [ -n "$untracked" ]; then
      printf '%s\n' "$untracked" | git hash-object --stdin-paths 2>/dev/null || true
    fi
  ) | md5
}

# Compute cache key from repo + command + tree state
cache_key() {
  local root="$1"
  shift
  local cmd="$*"
  local state_hash
  state_hash=$(repo_hash "$root")
  printf '%s\n%s\n%s\n' "$root" "$cmd" "$state_hash" | md5
}

# Stable repo-specific cache directory name
# Uses basename + short hash of full path to avoid collisions
repo_cache_dir() {
  local root="$1"
  local path_hash
  path_hash=$(printf '%s' "$root" | md5 | head -c 8)
  echo "$CACHE_DIR/$(basename "$root")-$path_hash"
}

# Clean cache entries older than MAX_AGE_DAYS
clean_stale_cache() {
  [ -d "$CACHE_DIR" ] || return 0
  fd -t f -e result --changed-before "${MAX_AGE_DAYS}d" . "$CACHE_DIR" -x rm {} 2>/dev/null || true
  # Remove empty repo directories
  fd -t d --max-depth 1 . "$CACHE_DIR" -x rmdir {} 2>/dev/null || true
}

cmd_clear() {
  local root
  root=$(repo_root) || { echo "Error: not in a git repository" >&2; exit 1; }
  local dir
  dir=$(repo_cache_dir "$root")
  if [ -d "$dir" ]; then
    rm -rf "$dir"
    echo "✓ Cache cleared for $(basename "$root")"
  else
    echo "No cache for $(basename "$root")"
  fi
}

cmd_clear_all() {
  if [ -d "$CACHE_DIR" ]; then
    rm -rf "$CACHE_DIR"
    echo "✓ Entire cache cleared"
  else
    echo "No cache directory"
  fi
}

cmd_status() {
  local root
  root=$(repo_root) || { echo "Error: not in a git repository" >&2; exit 1; }
  local dir
  dir=$(repo_cache_dir "$root")
  if [ -d "$dir" ] && [ -n "$(ls -A "$dir" 2>/dev/null)" ]; then
    local count
    count=$(fd -t f -e result . "$dir" | wc -l | tr -d ' ')
    echo "Repo:    $(basename "$root")"
    echo "Cache:   $dir"
    echo "Entries: $count"
    if [ "$count" -gt 0 ]; then
      echo ""
      for f in "$dir"/*.result; do
        [ -f "$f" ] || continue
        local cmd timestamp
        cmd=$(sed -n '1p' "$f")
        timestamp=$(sed -n '2p' "$f")
        echo "  ✓ $cmd ($timestamp)"
      done
    fi
  else
    echo "No cached results for $(basename "$root")"
  fi
}

# ── Per-file mode ────────────────────────────────────────────────────
# Bump when the key rules below change, so passes recorded under the old
# rules stop counting.
PER_FILE_VERSION=1

# Print "file<TAB>dep" for every file that a scanned file sources: `source`
# or `.` with a constant path, and `# shellcheck source=` directives. A path
# is looked up from the current folder (as ShellCheck does) and from the
# file's own folder (SCRIPTDIR). Every path that exists counts,
# so the key can over-cover but never miss a file shellcheck reads.
# A `source-path=` directive prints "file<TAB>*": that file is never cached.
# shellcheck disable=SC2016 # awk program, not shell
SOURCES_AWK='
function dir_of(p,   d) { d = p; if (sub(/\/[^\/]*$/, "", d)) return d; return "." }
function norm(p,   n, a, out, i, k) {
  n = split(p, a, "/"); k = 0
  for (i = 1; i <= n; i++) {
    if ((a[i] == "" && i > 1) || a[i] == ".") continue
    if (a[i] == ".." && k > 0 && out[k] != ".." && out[k] != "") { k--; continue }
    out[++k] = a[i]
  }
  p = ""
  for (i = 1; i <= k; i++) p = p (i > 1 ? "/" : "") out[i]
  return p == "" ? "." : p
}
function exists(p,   line, r) { r = (getline line < p); close(p); return r >= 0 }
function add(src, p,   q) {
  gsub(/^["\047]+|["\047;]+$/, "", p)
  if (p == "" || p == "/dev/null" || p ~ /[$`]/) return
  if (p ~ /^SCRIPTDIR\//) {
    q = norm(dir_of(src) "/" substr(p, 11)); if (exists(q)) print src "\t" q
    return
  }
  q = norm(p); if (exists(q)) print src "\t" q
  if (p !~ /^\//) { q = norm(dir_of(src) "/" p); if (exists(q)) print src "\t" q }
}
/^[[:space:]]*#[[:space:]]*shellcheck[[:space:]]/ {
  n = split($0, w, /[[:space:]]+/)
  for (i = 1; i <= n; i++) {
    if (w[i] ~ /^source=/) add(FILENAME, substr(w[i], 8))
    else if (w[i] ~ /^source-path=/) print FILENAME "\t*"
  }
  next
}
{
  line = $0
  while (match(line, /(^|[;&|({[:space:]])(source|\.)[[:space:]]+[^[:space:];&|)]+/)) {
    m = substr(line, RSTART, RLENGTH)
    sub(/^[;&|({[:space:]]*(source|\.)[[:space:]]+/, "", m)
    add(FILENAME, m)
    line = substr(line, RSTART + RLENGTH)
  }
}
'

# Inputs: ledger (passed keys), hashes ("path<TAB>blob"), edges
# ("file<TAB>dep"), files (one per line, in order). Writes <tmp>/<n>.file
# and <tmp>/<n>.key for each file that needs a run and prints its number n.
# A file's key is its path and blob plus the path and blob of every file it
# sources or names in --deps, directly or through another input. An input
# that does not exist (a deleted file) counts as "-". A file with no key (an
# unknown source, or a listed file that cannot be read) always runs.
# shellcheck disable=SC2016 # awk program, not shell
KEYS_AWK='
FILENAME == ARGV[1] { passed[$0] = 1; next }
FILENAME == ARGV[2] { split($0, f, "\t"); blob[f[1]] = f[2]; next }
FILENAME == ARGV[3] { split($0, f, "\t"); deps[f[1]] = deps[f[1]] "\t" f[2]; next }
{
  file = $0; idx++
  split("", seen); split("", todo); split("", list); nt = 0; nl = 0; bad = !(file in blob)
  todo[++nt] = file; seen[file] = 1
  while (nt > 0) {
    cur = todo[nt--]
    nd = split(deps[cur], d, "\t")
    for (i = 2; i <= nd; i++) {
      if (d[i] == "*") { bad = 1; continue }
      if (!(d[i] in blob)) blob[d[i]] = "-"
      if (d[i] in seen) continue
      seen[d[i]] = 1; todo[++nt] = d[i]; list[++nl] = d[i]
    }
  }
  key = ""
  if (!bad) {
    for (i = 2; i <= nl; i++) for (j = i; j > 1 && list[j - 1] > list[j]; j--) { t = list[j]; list[j] = list[j - 1]; list[j - 1] = t }
    key = file " " blob[file]
    for (i = 1; i <= nl; i++) key = key " " list[i] ":" blob[list[i]]
    if (key in passed) { hits++; next }
  }
  print file > (tmp "/" idx ".file"); close(tmp "/" idx ".file")
  printf "%s", key > (tmp "/" idx ".key"); close(tmp "/" idx ".key")
  print idx
}
END { print hits + 0 > (tmp "/hits") }
'

# One job for xargs, run by /bin/sh so the host BASH_ENV is not loaded per
# file. Arguments: tmp ledger command... n. Never fails, so xargs keeps going;
# the file's exit status goes to <tmp>/<n>.status.
# shellcheck disable=SC2016 # sh program, not this shell
PER_FILE_JOB='
tmp=$1; ledger=$2; shift 2
n=$#; i=0
for a; do i=$((i + 1)); if [ "$i" -lt "$n" ]; then set -- "$@" "$a"; else idx=$a; fi; done
shift "$n"
IFS= read -r file < "$tmp/$idx.file"
"$@" "$file" > "$tmp/$idx.log" 2>&1
st=$?
echo "$st" > "$tmp/$idx.status"
if [ "$st" -eq 0 ] && [ -s "$tmp/$idx.key" ]; then
  IFS= read -r key < "$tmp/$idx.key" || true
  { printf "%s\n" "$key" >> "$ledger"; } 2>/dev/null || :
fi
exit 0
'

per_file_usage() {
  echo "Usage: cached-run --per-file [--jobs N] [--key TEXT] <command...> -- <file...>" >&2
  exit 2
}

cmd_per_file() {
  local jobs="" extra_key="" deps_file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --jobs) [ $# -ge 2 ] || per_file_usage; jobs="$2"; shift 2 ;;
      --jobs=*) jobs="${1#--jobs=}"; shift ;;
      --key) [ $# -ge 2 ] || per_file_usage; extra_key="$2"; shift 2 ;;
      --key=*) extra_key="${1#--key=}"; shift ;;
      --deps) [ $# -ge 2 ] || per_file_usage; deps_file="$2"; shift 2 ;;
      --deps=*) deps_file="${1#--deps=}"; shift ;;
      *) break ;;
    esac
  done
  local cmd=()
  while [ $# -gt 0 ] && [ "$1" != "--" ]; do cmd+=("$1"); shift; done
  [ $# -gt 0 ] && [ "${#cmd[@]}" -gt 0 ] || {
    echo "cached-run --per-file: give the command, then --, then the files" >&2
    per_file_usage
  }
  shift
  [ $# -gt 0 ] || { echo "cached-run: no files to check"; return 0; }
  case "$jobs" in
    ''|*[!0-9]*|0) jobs=1 ;;
  esac

  repo_root >/dev/null || { echo "Error: not in a git repository" >&2; exit 1; }
  # The key names files from the current folder (shellcheck resolves
  # sources from there too), so the folder inside the repo is part of it.
  local prefix ledger_dir ledger tmp
  prefix="$(git rev-parse --show-prefix 2>/dev/null || true)"
  ledger_dir="$CACHE_DIR/per-file"
  ledger="$ledger_dir/$(printf '%s\n' "per-file $PER_FILE_VERSION" "$prefix" "$extra_key" "${cmd[@]}" | md5).result"
  mkdir -p "$ledger_dir" 2>/dev/null || true
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/cached-run.XXXXXX")"
  # shellcheck disable=SC2064 # expand $tmp now
  trap "rm -rf '$tmp'" EXIT

  printf '%s\n' "$@" > "$tmp/files"
  # Extra inputs from --deps, then sources, two or more levels deep: scan
  # each newly found file that exists once.
  : > "$tmp/edges"
  if [ -n "$deps_file" ]; then
    [ -r "$deps_file" ] || { echo "cached-run --per-file: cannot read --deps $deps_file" >&2; exit 2; }
    grep "$(printf '\t')" "$deps_file" > "$tmp/edges" || true
  fi
  { cat "$tmp/files"; cut -f2 "$tmp/edges"; } | LC_ALL=C sort -u > "$tmp/scan"
  cp "$tmp/scan" "$tmp/scanned"
  local round=0
  while [ -s "$tmp/scan" ] && [ "$round" -lt 20 ]; do
    round=$((round + 1))
    while IFS= read -r f; do if [ -f "$f" ]; then printf '%s\0' "$f"; fi; done < "$tmp/scan" |
      xargs -0 awk "$SOURCES_AWK" 2>/dev/null > "$tmp/new-edges" || true
    cat "$tmp/new-edges" >> "$tmp/edges"
    cut -f2 "$tmp/new-edges" | grep -vxF '*' | LC_ALL=C sort -u | grep -vxF -f "$tmp/scanned" > "$tmp/scan" || true
    cat "$tmp/scan" >> "$tmp/scanned"
  done
  # Blob hashes of every file that exists (a missing input counts as "-").
  LC_ALL=C sort -u "$tmp/scanned" | while IFS= read -r f; do if [ -f "$f" ]; then printf '%s\n' "$f"; fi; done > "$tmp/hashable"
  if [ -s "$tmp/hashable" ] && git hash-object --stdin-paths < "$tmp/hashable" > "$tmp/blobs" 2>/dev/null; then
    paste "$tmp/hashable" "$tmp/blobs" > "$tmp/hashes"
  else
    : > "$tmp/hashes"
  fi
  local ledger_in="$ledger"
  [ -r "$ledger" ] || ledger_in=/dev/null
  awk -v tmp="$tmp" "$KEYS_AWK" "$ledger_in" "$tmp/hashes" "$tmp/edges" "$tmp/files" > "$tmp/todo"

  local total hits checked
  total=$#
  hits="$(cat "$tmp/hits")"
  checked="$(wc -l < "$tmp/todo" | tr -d ' ')"
  if [ "$checked" -gt 0 ]; then
    xargs -n 1 -P "$jobs" /bin/sh -c "$PER_FILE_JOB" cached-run-job "$tmp" "$ledger" "${cmd[@]}" < "$tmp/todo"
  fi

  local idx st failed=0 first_status=0
  while IFS= read -r idx; do
    st="$(cat "$tmp/$idx.status" 2>/dev/null || echo 1)"
    [ -s "$tmp/$idx.log" ] && cat "$tmp/$idx.log"
    if [ "$st" -ne 0 ]; then
      failed=$((failed + 1))
      [ "$first_status" -ne 0 ] || first_status="$st"
    fi
  done < "$tmp/todo"

  # Keep the shared ledger small: the newest passes are the useful ones.
  if [ -w "$ledger" ] && [ "$(wc -l < "$ledger" | tr -d ' ')" -gt 20000 ]; then
    tail -n 10000 "$ledger" > "$tmp/ledger" 2>/dev/null && cat "$tmp/ledger" > "$ledger" 2>/dev/null || true
  fi
  clean_stale_cache >/dev/null 2>&1 &

  if [ "$failed" -gt 0 ]; then
    echo "cached-run: $total files: $hits unchanged (passed before), $checked checked, $failed failed"
    exit "$first_status"
  fi
  echo "cached-run: $total files: $hits unchanged (passed before), $checked checked"
}

# ── Main ─────────────────────────────────────────────────────────────
case "${1:-}" in
  --help|-h)  usage; exit 0 ;;
  --per-file) shift; cmd_per_file "$@"; exit $? ;;
  --clear)    cmd_clear; exit 0 ;;
  --clear-all) cmd_clear_all; exit 0 ;;
  --status)   cmd_status; exit 0 ;;
  "")         usage; exit 1 ;;
esac

# Must be in a git repo
root=$(repo_root) || { echo "Error: not in a git repository" >&2; exit 1; }

# Compute cache key
key=$(cache_key "$root" "$@")
dir=$(repo_cache_dir "$root")
cache_file="$dir/$key.result"

# Check cache
if [ -f "$cache_file" ]; then
  cached_cmd=$(sed -n '1p' "$cache_file")
  cached_time=$(sed -n '2p' "$cache_file")
  echo "✓ $cached_cmd (cached — passed $cached_time)"
  exit 0
fi

# Run the command
exit_code=0
"$@" || exit_code=$?

# Cache on success only
if [ "$exit_code" -eq 0 ]; then
  mkdir -p "$dir"
  printf '%s\n%s\n%s\n' "$*" "$(date '+%Y-%m-%d %H:%M')" "$key" > "$cache_file"
  # Async stale cache cleanup
  clean_stale_cache &
fi

exit "$exit_code"
