#!/bin/bash
# Unified dotfiles CLI — delegates to chezmoi.
#
# Usage:
#   dotfiles                 Start screen: what is missing, what changed, what needs you
#   dotfiles <command> [args]
#   dotfiles --help

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/colors.sh
source "$DOTFILES_DIR/lib/colors.sh"

_check_for_updates() {
  # Skip if not a git repo or no remote
  [ -d "$DOTFILES_DIR/.git" ] || return 0
  git -C "$DOTFILES_DIR" remote get-url origin &>/dev/null || return 0

  # Throttle: only fetch if FETCH_HEAD is older than 1 hour (or missing)
  local fetch_head="$DOTFILES_DIR/.git/FETCH_HEAD"
  if [ -f "$fetch_head" ]; then
    local fetch_age now_epoch file_epoch
    now_epoch=$(date +%s)
    file_epoch=$(stat -f %m "$fetch_head" 2>/dev/null) || return 0
    fetch_age=$((now_epoch - file_epoch))
    [ "$fetch_age" -gt 3600 ] || {
      # Use cached fetch data to check if behind
      local local_head remote_head branch
      branch=$(git -C "$DOTFILES_DIR" branch --show-current 2>/dev/null) || return 0
      local_head=$(git -C "$DOTFILES_DIR" rev-parse HEAD 2>/dev/null) || return 0
      remote_head=$(git -C "$DOTFILES_DIR" rev-parse "origin/$branch" 2>/dev/null) || return 0
      if [ "$local_head" != "$remote_head" ]; then
        local behind
        behind=$(git -C "$DOTFILES_DIR" rev-list --count "HEAD..origin/$branch" 2>/dev/null) || return 0
        [ "$behind" -gt 0 ] && echo -e "${YELLOW}⬆ Update available ($behind commit(s) behind). Run: dotfiles update${NC}" >&2
      fi
      return 0
    }
  fi

  # Background fetch (non-blocking)
  git -C "$DOTFILES_DIR" fetch --quiet origin &>/dev/null &

  # Check with pre-fetch data if available
  local local_head remote_head branch
  branch=$(git -C "$DOTFILES_DIR" branch --show-current 2>/dev/null) || return 0
  local_head=$(git -C "$DOTFILES_DIR" rev-parse HEAD 2>/dev/null) || return 0
  remote_head=$(git -C "$DOTFILES_DIR" rev-parse "origin/$branch" 2>/dev/null) || return 0
  if [ "$local_head" != "$remote_head" ]; then
    local behind
    behind=$(git -C "$DOTFILES_DIR" rev-list --count "HEAD..origin/$branch" 2>/dev/null) || return 0
    [ "$behind" -gt 0 ] && echo -e "\033[1;33m⬆ Update available ($behind commit(s) behind). Run: dotfiles update\033[0m" >&2
  fi
}

# bin/dotfiles-actions reads this text: one line per usage form, at a
# two-space indent: the usage, two or more spaces, what it does (deeper lines
# continue it). Every dispatch arm below needs a line here; `dotfiles actions
# --check` (tests/dotfiles-actions.bats) fails otherwise.
show_help() {
  cat <<EOF
Usage: dotfiles [<command>] [options]

Start:
  (no command) [--yes] [--health]
                              Start screen: set up, applied, background jobs,
                              health, updates, then what needs you and Next.
                              Safe and fast: no sudo, applies only with a yes
                              (--yes, or y at the prompt). --health also runs
                              a fresh doctor check. Same as \`dotfiles start\`.
  config [<key>]              Show every setting (value, source, allowed) or one
  config set <key> <value>    Check a value against config/settings.yaml and save it
  actions [<name>] [--json]   Every command for agents: usage, arguments, notes
  actions --check             Fail when a command has no line in this help

Common:
  apply [--pull] [--no-fix] [--if-changed]
                              Apply dotfiles and self-heal (chezmoi + doctor --fix)
                              --pull also git-pulls latest first
                              --no-fix opts out of the auto-doctor pass
                              --if-changed skips both when nothing changed since
                              the last full apply and chezmoi status shows no drift
  update [--dry-run] [--verbose] [--yes]
                              Update the whole machine (pull/apply/agents/packages/doctor);
                              asks first (--yes skips the question)
  doctor [--fix] [...]        Audit configs; --fix auto-repairs
                              See \`doctor --help\` for all flags
  sync                        Commit local changes and pull remote updates
  upgrade [--dry-run] [--yes]  Upgrade all software (brew, casks, macOS, tools); asks first
  upgrade --node [VERSION] [--yes]
                              Switch Node in one step (links, .node-version, agentbrew plists)

Scaffolding:
  add <file> [--copy] [--module M]          Add a config file (symlink or copy mode)
  brew-add <pkg> [--cask] [--full-only]     Add a Homebrew package
  defaults-add <domain> <key> <val> <type>  Add a macOS default + doctor check
  new-module <name> [--severity S]          Create a new doctor module
  unmanage <file>                           Remove a managed file from the repo
  profile [core|full]                       Show or switch chezmoi profile

Advanced:
  init [--yes]                 chezmoi init, then apply; asks first (--yes skips it)
  diff                         Show pending changes (chezmoi diff)
  managed                      List all managed files
  status                       Show git status of dotfiles repo
  stats                        Show automation stats (runs, time saved, streak)
  install plan|run|restore     One-step install with backup and auto-restore
  metrics [--share FILE]       Agent time, hook blocks, MCP health, machine load
  contribute [--repo agentbrew] [--yes]  Open a PR upstream from your branch (forks
                               for you); asks first (--yes skips the question)
  cheat                        Show all available commands and aliases
  edit                         Open the dotfiles repo in your editor
  cd                           Print the dotfiles directory (use: cd \$(dotfiles cd))
  audit [--report]             Security audit (SSH, secrets, permissions, git)
                               (also runs as part of \`doctor\`)
  validate [--quick]           Verify repo is safe to share (paths, secrets, lint, test)
                               (also runs as part of \`doctor\`)
  defaults-preview [--changed]  Preview macOS defaults changes (no writes)
  enterprise [on|off]          Show or toggle enterprise mode
  quickstart [--check]         Interactive first-run wizard
  plugin <subcommand>          Company plugins: add, update, remove, list, trust
                               (see \`dotfiles plugin --help\`)
  leak allow --once [<sha>]    A person allows one leak-gate bypass (needs a terminal)
  memory <subcommand>          Deprecated: forwards to \`agentbrew memory\`
  uninstall [--dry-run] [--yes]  Remove dotfiles from this machine

Options:
  --help, -h         Show this help
  --version, -v      Show current dotfiles version

Examples:
  dotfiles                        What needs you now, and the next command
  dotfiles config set weekly_metrics true   Change a setting (then: dotfiles apply)
  dotfiles update                 Whole-machine update (pull/apply/agents/packages/doctor)
  dotfiles apply                  Apply + self-heal
  dotfiles apply --pull           Pull latest from git, then apply + self-heal
  dotfiles add ~/.tool-config     Add a config file (symlink mode)
  dotfiles brew-add ripgrep       Add a Homebrew package
  dotfiles profile full           Switch to full profile
  dotfiles new-module mymod       Scaffold a new doctor module
  dotfiles doctor --fix           Audit and auto-fix drift (also runs on \`apply\`)
EOF
}

show_version() {
  local version
  if version=$(cd "$DOTFILES_DIR" && git rev-parse --short HEAD 2>/dev/null); then
    echo "dotfiles $version ($(cd "$DOTFILES_DIR" && git log -1 --format='%cd' --date=short 2>/dev/null))"
  else
    echo "dotfiles (unknown version)"
  fi
}

# Start-screen flags without a command mean `start` (dotfiles --yes).
case "${1:-}" in --yes | -y | --health) set -- start "$@" ;; esac

# Normalize: strip leading dashes from subcommands (e.g. --doctor → doctor, -h → h)
cmd="${1:-}"
cmd="${cmd#--}"
cmd="${cmd#-}"

# Check for updates (skip for commands that already update or need clean stdout;
# the start screen prints its own Update line)
case "$cmd" in
  update|upgrade|sync|cd|version|v|start|""|config|actions) ;;
  *) _check_for_updates ;;
esac

# Each case arm is an action (`dotfiles actions`). Notes for agents go in the
# arm as four-space comments: `# terminal-only: <why>` (needs a person at a
# terminal), `# confirm: <what it changes>` (agents ask first; each form takes
# --yes and its code calls lib/confirm.sh, or an `# unattended: <why>` note says
# why it runs without one), `# yes-for: <subcommands>` (only those sub-forms
# need a yes), and `# agent: <what to do differently>`.
case "$cmd" in
  help|h)
    show_help
    ;;

  ""|start)
    # agent: run it bare first; it changes nothing. Add --yes only after the user says yes: it applies, or installs on a new Mac.
    [ "$cmd" = "start" ] && shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-start" "$@"
    ;;

  config)
    # agent: run `config set` only for a change the user asked for, then `dotfiles apply --if-changed` after a yes.
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-config" "$@"
    ;;

  actions)
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-actions" "$@"
    ;;

  version|v)
    show_version
    ;;

  apply)
    # confirm: overwrites the managed files in your home folder and runs doctor --fix; it can take minutes and show macOS prompts.
    # unattended: the update-tooling and tooling-checkup skills run `dotfiles apply --if-changed`, and `dotfiles --yes` runs it after its own yes; it writes only what the repo holds, so git and another apply undo it.
    # `dotfiles apply` is now the single command operators run. It:
    #   1. Optionally git-pulls latest if --pull was passed (subsumes
    #      `dotfiles update`'s primary purpose).
    #   2. Runs chezmoi apply (the existing behavior).
    #   3. Runs `dotfiles-doctor --fix --quiet` afterwards to self-heal any
    #      drift the apply couldn't fix (extension installs, plugin
    #      installs, login items, etc.). --no-fix opts out for the rare
    #      case where the operator wants raw chezmoi behavior. Doctor's
    #      --quiet means it only prints when something actually changed.
    #   --if-changed skips steps 2 and 3 when lib/apply-state.sh shows that
    #   the source, chezmoi config, plugins, and local Agentfile are unchanged since the last
    #   full apply and `chezmoi status` shows no drift. Drift is printed, then
    #   the full apply runs.
    shift
    _do_pull=0
    _do_fix=1
    _if_changed=0
    _chezmoi_args=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --pull) _do_pull=1; shift ;;
        --no-fix) _do_fix=0; shift ;;
        --if-changed) _if_changed=1; shift ;;
        *) _chezmoi_args+=("$1"); shift ;;
      esac
    done
    if [ "$_do_pull" -eq 1 ]; then
      echo "→ Pulling latest…"
      git -C "$DOTFILES_DIR" pull --rebase || {
        echo "✗ git pull failed; aborting apply" >&2
        exit 1
      }
    fi
    # Prevent concurrent doctor/sync/upgrade from racing chezmoi (shared ~/.dotfiles.lock).
    # shellcheck source=../lib/lock.sh
    source "$DOTFILES_DIR/lib/lock.sh"
    wait_for_lock "apply" 120 || exit 1
    _apply_lock_released=0
    _release_apply_lock() {
      if [ "${_apply_lock_released:-0}" -eq 0 ]; then
        release_lock
        _apply_lock_released=1
      fi
    }
    trap _release_apply_lock EXIT
    # shellcheck source=../lib/apply-state.sh
    source "$DOTFILES_DIR/lib/apply-state.sh"
    if [ "$_if_changed" -eq 1 ]; then
      if apply_state_current "$DOTFILES_DIR"; then
        _drift_rc=0
        _drift="$(apply_state_drift "$DOTFILES_DIR")" || _drift_rc=$?
        case "$_drift_rc" in
          1)
            echo "✓ Nothing changed since the last apply ($(git -C "$DOTFILES_DIR" rev-parse --short HEAD)) and chezmoi status shows no drift: skipped chezmoi apply and doctor. Run \`dotfiles apply\` for a full apply."
            exit 0
            ;;
          0)
            echo "→ Drift since the last apply (chezmoi status):"
            printf '%s\n' "$_drift" | sed 's/^/    /'
            echo "→ Running the full apply."
            ;;
          *) echo "→ chezmoi status failed; running the full apply." ;;
        esac
      else
        echo "→ Source, chezmoi config, plugins, or the local Agentfile changed since the last apply (or no record yet); running the full apply."
      fi
    fi
    if [ "${#_chezmoi_args[@]}" -gt 0 ]; then
      chezmoi apply --source "$DOTFILES_DIR" "${_chezmoi_args[@]}"
    else
      # Only a full apply (no target or flag passthrough) updates the record;
      # a failed one leaves none, so the next --if-changed run applies again.
      apply_state_clear
      chezmoi apply --source "$DOTFILES_DIR"
      apply_state_record "$DOTFILES_DIR"
    fi
    _apply_rc=$?
    _release_apply_lock
    trap - EXIT
    if [ "$_apply_rc" -ne 0 ]; then
      exit "$_apply_rc"
    fi
    if [ "$_do_fix" -eq 1 ] && [ -x "$DOTFILES_DIR/bin/dotfiles-doctor" ]; then
      bash "$DOTFILES_DIR/bin/dotfiles-doctor" --fix --quiet || true
    fi
    exit 0
    ;;

  init)
    # confirm: runs chezmoi init, then applies every managed file, like `dotfiles apply`. It asks first; agents pass --yes after the user agrees.
    # Backward-compat alias for first-time-on-a-machine. Equivalent to
    # `dotfiles apply` once the repo is already cloned; chezmoi init clones
    # the source and then applies, which we replicate by ensuring the repo
    # is present then forwarding to apply.
    shift
    # shellcheck source=../lib/confirm.sh
    source "$DOTFILES_DIR/lib/confirm.sh"
    confirm_gate "runs chezmoi init and applies every managed file in your home folder" "$@"
    set -- ${CONFIRM_ARGS[@]+"${CONFIRM_ARGS[@]}"}
    echo "→ \`dotfiles init\` is now an alias for \`dotfiles apply\`."
    exec chezmoi init --source "$DOTFILES_DIR" --apply "$@"
    ;;

  diff)
    shift
    exec chezmoi diff --source "$DOTFILES_DIR" "$@"
    ;;

  doctor)
    # agent: --fix changes the machine; add it only after the user says yes.
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-doctor" "$@"
    ;;

  plugin)
    # confirm: `add`, `remove`, and `trust` install, delete, or trust code that runs here; without a terminal they refuse unless --yes. `update` asks only when the plugin's capabilities changed; `trust --revoke` asks nothing; `list` and `verify` change nothing.
    # yes-for: add remove trust
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-plugin" "$@"
    ;;

  audit)
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-audit" "$@"
    ;;

  validate)
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-validate" "$@"
    ;;

  leak)
    # terminal-only: a person grants a leak-gate bypass at a terminal; it refuses without one, and agents never ask for it.
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-leak" "$@"
    ;;

  sync)
    # confirm: commits every local change in the dotfiles repo and pushes it (never to a public remote without a terminal).
    # unattended: the com.dotfiles.dotfiles-sync LaunchAgent runs this same script (bin/dotfiles-sync) every 30 minutes without asking, so a yes here would guard nothing. Without a terminal it does not push to a remote listed in config/public-push-remotes.txt; it does push to other remotes (for example a private mirror).
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-sync" "$@"
    ;;

  edit)
    # terminal-only: it opens the repo in your editor ($EDITOR); agents edit the files directly.
    local_editor="${EDITOR:-code}"
    exec "$local_editor" "$DOTFILES_DIR"
    ;;

  cd)
    echo "$DOTFILES_DIR"
    ;;

  update)
    # confirm: pulls, applies, and updates agents and every package; it takes minutes. Try --dry-run first. It asks first; agents pass --yes after the user agrees.
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-update" "$@"
    ;;

  managed)
    shift
    exec chezmoi managed --source "$DOTFILES_DIR" "$@"
    ;;

  status)
    cd "$DOTFILES_DIR" || { echo "Error: cannot access dotfiles dir"; exit 1; }
    echo "Branch: $(git branch --show-current)"
    echo "Commit: $(git log -1 --format='%h %s (%cr)')"
    echo ""
    git status --short
    ;;

  stats)
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-stats" "$@"
    ;;

  install)
    # confirm: `install run --yes` changes the machine (after a backup); `install restore` puts a backup back over your files and asks first. `plan` and `backups` change nothing.
    # yes-for: run restore
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-install" "$@"
    ;;

  metrics)
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-metrics" "$@"
    ;;

  contribute)
    # confirm: pushes your branch and opens a public pull request upstream (it forks the repo if needed). Try --dry-run first. It asks first; agents pass --yes after the user agrees.
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-contribute" "$@"
    ;;

  cheat)
    exec bash "$DOTFILES_DIR/bin/cheat" "${@:2}"
    ;;

  add)
    shift
    exec "$DOTFILES_DIR/bin/dotfiles-add" "$@"
    ;;

  profile)
    # agent: switching changes which modules the next apply installs or removes; switch only when the user asks (switching back undoes it).
    shift
    exec "$DOTFILES_DIR/bin/dotfiles-profile" "$@"
    ;;

  enterprise)
    # agent: `on` or `off` changes the enterprise tools the next apply installs; change it only when the user asks (the other value undoes it).
    shift
    exec "$DOTFILES_DIR/bin/dotfiles-enterprise" "$@"
    ;;

  new-module)
    shift
    exec "$DOTFILES_DIR/bin/dotfiles-new-module" "$@"
    ;;

  brew-add)
    shift
    exec "$DOTFILES_DIR/bin/dotfiles-brew-add" "$@"
    ;;

  unmanage)
    # agent: removes the file's source and doctor checks from the repo (the file in your home folder stays); run it only when the user asks; git brings the source back.
    shift
    exec "$DOTFILES_DIR/bin/dotfiles-unmanage" "$@"
    ;;

  defaults-add)
    shift
    exec "$DOTFILES_DIR/bin/dotfiles-defaults-add" "$@"
    ;;

  defaults-preview)
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-defaults-preview" "$@"
    ;;

  uninstall)
    # confirm: removes the dotfiles symlinks and LaunchAgents from this machine. Try --dry-run first; --yes skips its prompt.
    shift
    exec "$DOTFILES_DIR/bin/dotfiles-uninstall" "$@"
    ;;

  quickstart)
    # terminal-only: an interactive wizard that asks y/N questions; agents use `dotfiles install plan`, then `install run --yes`. `quickstart --check` asks nothing and only checks prerequisites, so agents may run it.
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-quickstart" "$@"
    ;;

  upgrade)
    # confirm: upgrades the software of every package manager (topgrade), or switches Node; hard to roll back. Try --dry-run. It asks first; agents pass --yes after the user agrees. The weekly com.dotfiles.dotfiles-upgrade LaunchAgent passes --yes (auto_upgrade is the owner's yes).
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-upgrade" "$@"
    ;;

  memory)
    # agent: deprecated; run `agentbrew memory` instead.
    shift
    exec bash "$DOTFILES_DIR/bin/dotfiles-memory" "$@"
    ;;

  *)
    echo "Unknown command: $cmd" >&2
    echo "" >&2
    echo "Run 'dotfiles --help' for usage." >&2
    exit 1
    ;;
esac
