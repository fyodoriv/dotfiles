#!/bin/bash
# Every dotfiles command as an action, for agents and people, read from bin/dotfiles.
#
# Usage:
#   dotfiles actions [<name>]          One line per usage form, with the notes
#   dotfiles actions [<name>] --json   The same list as JSON, for agents
#   dotfiles actions --check           Fail when a dispatched command has no help
#                                      line, or a help line names no command
#
# One source, nothing listed twice: the names come from the dispatch `case`
# in bin/dotfiles, the usage and what each one does from its show_help text,
# the sub-forms from the "Usage:" header of the script an arm runs, and the
# notes from comments in a dispatch arm:
#   # terminal-only: <why an agent cannot run it>  (needs a person at a terminal)
#   # confirm: <what it changes that is hard to undo>  (agents ask first)
#   # yes-for: <subcommands>  (only these sub-forms of a confirm action need a yes)
#   # unattended: <why a confirm action has no --yes>
#   # agent: <what an agent must do differently>
# Each form of a confirm action that needs a yes must take --yes, and a
# confirm_* call from lib/confirm.sh must be on its code path (the arm, the
# script it runs, or a function either one calls); --check fails otherwise.
# `gated` means a gate is on that path; a script may still skip the question
# on some branches (plugin update when the capabilities did not change).
# dotfiles has no UI; a UI would read this same list. It reads files only:
# no git, no network, no update check.

set -euo pipefail
{ [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; } && { sed -n '/^#!/d; /^$/q; /^[^#]/q; /^# shellcheck/d; s/^# \{0,1\}//p' "$0"; exit 0; }

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CLI="$DOTFILES_DIR/bin/dotfiles"

die() { echo "✗ $1" >&2; exit "${2:-1}"; }

mode=list json=0 want=""
while [ $# -gt 0 ]; do
  case "$1" in
    --json) json=1 ;;
    --check) mode=check ;;
    -*) die "unknown flag: $1. Run: dotfiles actions --help" 2 ;;
    *) [ -z "$want" ] || die "one action name at a time" 2; want="$1" ;;
  esac
  shift
done

command -v jq >/dev/null 2>&1 || die "jq is not installed. Fix: brew install jq"
[ -r "$CLI" ] || die "cannot read $CLI"

# Shared by the awk programs below. Their globals live for one awk run.
# shellcheck disable=SC2016 # awk program, not shell
AWK_LIB='
# prose(s): the first token of a usage that reads like description text, or
# "": a capitalized word, a number, two bare lowercase words in a row, or a bare word
# after the first [..], <..>, or --flag (a literal subcommand word comes
# right after the command name). It catches a usage and its description
# joined by one space instead of two or more.
function prose(s,   i, c, d, tok, seen, bare, n, toks) {
  n = 0; d = 0; tok = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (c == "[" || c == "<") d++
    else if ((c == "]" || c == ">") && d > 0) d--
    if (c == " " && d == 0) { if (tok != "") toks[++n] = tok; tok = "" } else tok = tok c
  }
  if (tok != "") toks[++n] = tok
  seen = 0; bare = 0
  for (i = 1; i <= n; i++) {
    if (toks[i] ~ /^([A-Z][a-z]|[0-9])/) return toks[i]
    if (toks[i] ~ /^[a-z][a-z0-9-]*$/) { if (seen || ++bare > 1) return toks[i] } else bare = 0
    if (toks[i] ~ /^(\[|<|-)/) seen = 1
  }
  return ""
}

# lastbare(s): the last top-level token of a usage when it is a bare word.
# A usage whose description is only on the next lines must not end in one
# (`cheat shows` + a continuation line is a description, not a usage).
function lastbare(s,   t) {
  t = s; gsub(/\[[^]]*\]|<[^>]*>/, " @ ", t); sub(/[ \t]+$/, "", t); sub(/.*[ \t]/, "", t)
  return (t ~ /^[a-z][a-z0-9-]*$/) ? t : ""
}

# A small shell lexer. LST: the open contexts, carried across lines, as a
# stack string: S single quote, D double quote, C inside $( ) (PC[level]
# counts its parentheses). LHD: the heredoc delimiter while inside a heredoc
# body (LHT: <<- also strips tabs).
function lex_reset() { LST = ""; LHD = ""; LHT = 0 }
# lex(line): the top-level code of a line, with quoted text replaced by Q
# (V for a double-quoted string that expands a $), $( ) replaced by x, and
# the comment removed; "" inside a heredoc body.
# LEXP is 1 when the line starts at top level (so a leading # there is a
# real comment and a case label can start there).
function lex(line,   i, n, c, nx, out, prev, top, L, j, d, q, k) {
  if (LHD != "") {
    d = line; if (LHT) sub(/^\t+/, "", d)
    if (d == LHD) LHD = ""
    LEXP = 0; return ""
  }
  LEXP = (LST == ""); out = ""; prev = " "; n = length(line)
  for (i = 1; i <= n; i++) {
    c = substr(line, i, 1); nx = substr(line, i + 1, 1); L = length(LST); top = substr(LST, L, 1)
    if (top == "S") { if (c == "\047") LST = substr(LST, 1, L - 1); continue }
    if (top == "D") {
      if (c == "\\") i++
      else if (c == "\"") { LST = substr(LST, 1, L - 1); if (L == 1) { out = out (LDV ? "V" : "Q"); prev = "Q" } }
      else if (c == "$") { if (L == 1) LDV = 1; if (nx == "(") { LST = LST "C"; PC[L + 1] = 1; i++ } }
      continue
    }
    if (c == "\\") { i++; if (top == "") { out = out "x"; prev = "x" } continue }
    if (c == "\"") { LST = LST "D"; LDV = 0; continue }
    if (c == "\047") { LST = LST "S"; if (top == "") { out = out "Q"; prev = "Q" } continue }
    if (c == "$" && nx == "(") { LST = LST "C"; PC[L + 1] = 1; i++; if (top == "") { out = out "x"; prev = "x" } continue }
    if (top == "C") {
      if (c == "(") PC[L]++
      else if (c == ")") { if (--PC[L] == 0) LST = substr(LST, 1, L - 1) }
      else if (c == "#" && (prev == " " || prev == "\t")) break
      prev = c; continue
    }
    if (c == "#" && (prev == " " || prev == "\t" || prev == ";")) break
    if (c == "<" && nx == "<" && substr(line, i + 2, 1) != "<" && prev != "<") {
      j = i + 2; LHT = 0
      if (substr(line, j, 1) == "-") { LHT = 1; j++ }
      while (substr(line, j, 1) == " " || substr(line, j, 1) == "\t") j++
      q = substr(line, j, 1)
      if (q == "\047" || q == "\"") {
        k = index(substr(line, j + 1), q)
        if (k > 0) { LHD = substr(line, j + 1, k - 1); i = j + k } else i = n
      } else {
        if (q == "\\") j++
        d = substr(line, j)
        if (match(d, /^[A-Za-z_][A-Za-z0-9_]*/)) { LHD = substr(d, 1, RLENGTH); i = j + RLENGTH - 1 }
      }
      out = out " << "; prev = " "; continue
    }
    out = out c; prev = c
  }
  return out
}

# parse_arms(st): read the case block that starts at line st of LN[1..LNN].
# An arm is the first code after `in` or after a `;;` at depth 1, at any
# indent and with any spaces around `|`; nested case blocks raise the depth,
# and quoted text and heredocs do not count. Fills ARMN and, per arm k,
# ARM_LAB[k] (labels joined by |, without quotes; "*" left out),
# ARM_CODE[k], ARM_RAW[k] (its raw code lines), ARM_NOTE[k] (its comments).
function parse_arms(st,   i, line, code, depth, expect, tmp, p, lab, n, parts, j, q, clean, cur, w, nw) {
  ARMN = 0; lex_reset(); depth = 1; expect = 1; cur = 0
  for (i = st + 1; i <= LNN; i++) {
    line = LN[i]; code = lex(line)
    if (!LEXP && code == "") continue
    if (LEXP && line ~ /^[ \t]*#/) { if (cur && !expect && depth == 1) ARM_NOTE[cur] = ARM_NOTE[cur] line "\n"; continue }
    if (depth == 1 && expect && LEXP) {
      tmp = line; sub(/^[ \t]+/, "", tmp)
      if (tmp == "") continue
      if (tmp ~ /^esac([ \t;]|$)/) return i
      sub(/^\(/, "", tmp); p = index(tmp, ")")
      if (p > 0) {
        lab = substr(tmp, 1, p - 1); expect = 0
        p = index(code, ")"); code = substr(code, p + 1)
        n = split(lab, parts, "|"); clean = ""; cur = 0
        for (j = 1; j <= n; j++) {
          q = parts[j]; gsub(/^[ \t]+|[ \t]+$/, "", q); gsub(/["\047]/, "", q)
          if (q == "*") continue
          clean = clean (j == 1 ? "" : "|") q
          if (q != "") cur = -1
        }
        if (cur == -1) { ARMN++; cur = ARMN; ARM_LAB[cur] = clean; ARM_CODE[cur] = ""; ARM_RAW[cur] = ""; ARM_NOTE[cur] = "" }
      }
    }
    if (cur) { ARM_CODE[cur] = ARM_CODE[cur] " " code; ARM_RAW[cur] = ARM_RAW[cur] line "\n" }
    # case, esac, and ;; in the order they come, so a one-line nested case
    # (`case $a in x) ;; esac`) does not end the arm.
    tmp = code; gsub(/;;&?|;&/, " \001 ", tmp); gsub(/;/, " ", tmp)
    nw = split(tmp, w, /[ \t&|()]+/)
    for (j = 1; j <= nw; j++) {
      if (w[j] == "case") depth++
      else if (w[j] == "esac") { if (--depth <= 0) return i }
      else if (w[j] == "\001" && depth == 1) expect = 1
    }
  }
  return LNN
}

# has_gate(code): a confirm_* call whose yes comes from a variable (so
# `confirm_yes 1 ...`, which never asks, does not count).
function has_gate(text) {
  return text ~ /(^|[^A-Za-z0-9_])confirm_(yes|require_yes)[ \t]+(V|\$)/ ||
    text ~ /(^|[^A-Za-z0-9_])confirm_gate[ \t]+[QV][ \t]+(V|\$)/
}
'

# Rows from bin/dotfiles, tab-separated (help text holds no tabs):
#   A <name> <arm labels>          one per dispatch arm, in order
#   S <name> <script>              the bin/ script an arm runs, if any
#   K <name>                       the arm itself calls lib/confirm.sh
#   F <name> <usage> <args> <help> one per show_help line (a usage form)
#   N <name> <key> <text>          one per note comment in an arm
#   E <problem>                    one per parity problem
# shellcheck disable=SC2016 # awk program, not shell
rows="$(awk "$AWK_LIB"'
  { LN[NR] = $0; LNN = NR }

  # show_help: one line per form, two-space indent, the usage, two or more
  # spaces, what it does; deeper-indented lines continue the description.
  /^show_help\(\) \{$/ { in_fn = 1; next }
  in_fn && /^  cat <<EOF$/ { in_help = 1; in_fn = 0; next }
  in_help && /^EOF$/ { in_help = 0; next }
  in_help {
    line = $0
    gsub(/\\`/, "`", line)
    gsub(/\\\$/, "$", line)
    if (line ~ /^[A-Z][A-Za-z ]*:$/) { skip = (line == "Examples:"); cont = 0; next }
    if (skip) next
    if (line ~ /^  [^ ]/) {
      body = substr(line, 3)
      nh++
      if (match(body, /  +/)) { hu[nh] = substr(body, 1, RSTART - 1); hd[nh] = substr(body, RSTART + RLENGTH); hsame[nh] = 1 }
      else { hu[nh] = body; hd[nh] = "" }
      cont = 1
      next
    }
    if (cont && line ~ /^   +[^ ]/) {
      t = line; sub(/^ +/, "", t)
      # A line that starts a new point (a flag or a capital) after unfinished
      # text joins with "; "; a wrapped sentence joins with a space.
      if (hd[nh] == "") hd[nh] = t
      else if (t ~ /^(-|[A-Z])/ && hd[nh] !~ /[.,:;]$/) hd[nh] = hd[nh] "; " t
      else hd[nh] = hd[nh] " " t
      next
    }
    cont = 0
    next
  }

  END {
    # The dispatch is the last `case "$cmd" in` (an earlier one skips the
    # update check).
    for (i = 1; i <= LNN; i++) if (LN[i] ~ /^[ \t]*case[ \t]+"?\$\{?cmd\}?"?[ \t]+in[ \t]*$/) start = i
    if (start) parse_arms(start)
    na = ARMN
    for (a = 1; a <= na; a++) {
      n = split(ARM_LAB[a], parts, "|"); name[a] = ""
      for (j = 1; j <= n; j++) { if (name[a] == "" && parts[j] != "") name[a] = parts[j]; arm_of[parts[j]] = a }
      labels[a] = ARM_LAB[a]
      if (match(ARM_RAW[a], /\$DOTFILES_DIR\/bin\/[A-Za-z0-9_.-]+/)) script[a] = substr(ARM_RAW[a], RSTART + 18, RLENGTH - 18)
      if (has_gate(ARM_CODE[a])) armgate[a] = 1
      m = split(ARM_NOTE[a], nl, "\n"); in_note = 0
      for (j = 1; j <= m; j++) {
        if (match(nl[j], /^[ \t]*#[ \t]*(terminal-only|confirm|yes-for|unattended|agent):[ \t]/)) {
          t = substr(nl[j], RLENGTH + 1); k = nl[j]; sub(/^[ \t]*#[ \t]*/, "", k); sub(/:.*/, "", k)
          nn++; note_key[nn] = k; note_text[nn] = t; note_arm[nn] = a; in_note = 1
        } else if (in_note && nl[j] ~ /^[ \t]*#[ \t][ \t][ \t]+[^ \t]/) {
          t = nl[j]; sub(/^[ \t]*#[ \t]+/, "", t); note_text[nn] = note_text[nn] " " t
        } else in_note = 0
      }
    }

    for (i = 1; i <= nh; i++) {
      u = hu[i]
      if (u ~ /^\(no command\)/) {
        k = ""; rest = u; sub(/^\(no command\) */, "", rest)
        shown = "dotfiles" (rest == "" ? "" : " " rest)
      } else if (u ~ /^-/) {
        k = u; sub(/[ ,].*/, "", k); shown = "dotfiles " k; sub(/^-+/, "", k); rest = ""
      } else {
        k = u; sub(/ .*/, "", k); rest = ""
        if (index(u, " ")) { rest = u; sub(/^[^ ]+ /, "", rest) }
        shown = "dotfiles " u
      }
      if (!(k in arm_of)) {
        print "E\t" (k == "" ? "(no command)" : k) ": its show_help line names a command that is not dispatched in bin/dotfiles; remove the line or add the case arm"
        continue
      }
      a = arm_of[k]; listed[a] = 1
      if ((bad = prose(rest)) != "" || (!hsame[i] && hd[i] != "" && (bad = lastbare(rest)) != "")) print "E\t" name[a] ": its show_help line \"" u "\" runs the usage into the description at \"" bad "\"; put two or more spaces between them"
      else if (hd[i] == "") print "E\t" name[a] ": its show_help line has no description; put two or more spaces between the usage and what it does"
      print "F\t" name[a] "\t" shown "\t" rest "\t" hd[i]
    }
    for (a = 1; a <= na; a++) {
      print "A\t" name[a] "\t" labels[a]
      if (a in script) print "S\t" name[a] "\t" script[a]
      if (a in armgate) print "K\t" name[a]
      if (!(a in listed)) print "E\t" name[a] ": dispatched in bin/dotfiles but has no line in show_help; add one: two-space indent, the usage, two spaces, what it does"
    }
    for (i = 1; i <= nn; i++) print "N\t" name[note_arm[i]] "\t" note_key[i] "\t" note_text[i]
  }
' "$CLI")"

# Rows from each script an arm runs:
#   G <name> <usage> <args> <help>  a sub-form from its "Usage:" header: a line
#       that starts with `dotfiles <name>` (or `dotfiles-<name>`); a more
#       indented line continues its description; a blank `#` line ends it
#   T <script> <0|1>                its top-level code reaches lib/confirm.sh
#   W <script> <subcommand> <0|1>   that arm of its own dispatch `case` does
# "Reaches" means a confirm_* call in that code or in a function it calls,
# followed through the script's own functions.
scripts=() names=()
while IFS=$'\t' read -r kind nm sc; do
  [ "$kind" = S ] && [ -r "$DOTFILES_DIR/bin/$sc" ] || continue
  names+=("$nm") scripts+=("$DOTFILES_DIR/bin/$sc")
done <<<"$rows"
if [ "${#scripts[@]}" -gt 0 ]; then
  # shellcheck disable=SC2016 # awk program, not shell
  rows="$rows"$'\n'"$(printf '%s\n' "${names[@]}" | awk "$AWK_LIB"'
    function fgates(f) {
      if (f in FG) return FG[f]
      FG[f] = 0
      FG[f] = gates(FB[f])
      return FG[f]
    }
    function gates(text,   n, w, j) {
      if (has_gate(text)) return 1
      n = split(text, w, /[^A-Za-z0-9_]+/)
      for (j = 1; j <= n; j++) if ((w[j] in FB) && fgates(w[j])) return 1
      return 0
    }
    function finish(   i, line, code, fn, top, st, en, k, n, parts, j) {
      if (LNN == 0) return
      lex_reset(); fn = ""; st = 0
      for (i = 1; i <= LNN; i++) {
        line = LN[i]; code = lex(line); TC[i] = ""
        if (fn == "" && LEXP && match(line, /^[A-Za-z_][A-Za-z0-9_]*\(\)[ \t]*\{/)) {
          fn = substr(line, 1, index(line, "(") - 1); FB[fn] = code
          if (code ~ /\}[ \t;]*$/) fn = ""
          continue
        }
        if (fn != "") { if (LEXP && line ~ /^\}[ \t]*$/) fn = ""; else FB[fn] = FB[fn] " " code; continue }
        TC[i] = code
        if (LEXP && line ~ /^case[ \t]+"?\$\{?(1(:-)?|cmd|sub|subcmd|action)\}?"?[ \t]+in[ \t]*$/) st = i
      }
      # Top-level code outside the own dispatch case of the script: the gate for
      # forms that do not start with one of its sub-commands.
      en = st ? parse_arms(st) : 0
      top = ""
      for (i = 1; i <= LNN; i++) if (!st || i < st || i > en) top = top " " TC[i]
      print "T\t" FILE "\t" gates(top)
      if (st) {
        for (k = 1; k <= ARMN; k++) {
          n = split(ARM_LAB[k], parts, "|")
          for (j = 1; j <= n; j++) if (parts[j] != "") print "W\t" FILE "\t" parts[j] "\t" gates(ARM_CODE[k])
        }
      }
      delete FB; delete FG; delete TC; LNN = 0
    }
    NR == FNR { nm_of[++nf] = $0; next }
    FNR == 1 { finish(); fi++; nm = nm_of[fi]; hdr = 1; usage = 0; cur = 0; FILE = FILENAME; sub(/.*\//, "", FILE) }
    { LN[FNR] = $0; LNN = FNR }
    !hdr || /^#!/ { next }
    /^$/ { usage = 0; cur = 0; next }
    !/^#/ { hdr = 0; next }
    {
      t = $0; sub(/^# ?/, "", t)
      if (t ~ /^Usage:/) { usage = 1; cur = 0; sub(/^Usage:[ \t]*/, "", t); if (t == "") next }
      else if (!usage) next
      if (t ~ /^[ \t]*$/) { usage = 0; cur = 0; next }
      s = t; sub(/^[ \t]+/, "", s)
      dn = "dotfiles-" nm
      if (index(s, dn) == 1 && (length(s) == length(dn) || substr(s, length(dn) + 1, 1) == " ")) s = "dotfiles " nm substr(s, length(dn) + 1)
      cmd = (nm == "start" ? "dotfiles" : "dotfiles " nm)
      if (s == cmd || index(s, cmd " ") == 1) {
        if (match(s, /  +/)) { u = substr(s, 1, RSTART - 1); d = substr(s, RSTART + RLENGTH) } else { u = s; d = "" }
        rest = substr(u, length(cmd) + 2)
        if ((bad = prose(rest)) != "") print "E\t" nm ": bin/" FILE " has the usage line \"" u "\" with description text at \"" bad "\"; put two or more spaces between them"
        ng++; gname[ng] = nm; gu[ng] = u; gr[ng] = rest; gd[ng] = d; gsame[ng] = (d != ""); gfile[ng] = FILE; cur = 1
      } else if (cur && t ~ /^[ \t][ \t]/) {
        gd[ng] = (gd[ng] == "" ? s : gd[ng] " " s)
      } else { usage = 0; cur = 0 }
    }
    END {
      finish()
      for (i = 1; i <= ng; i++) {
        if (!gsame[i] && gd[i] != "" && (bad = lastbare(gr[i])) != "") print "E\t" gname[i] ": bin/" gfile[i] " has the usage line \"" gu[i] "\" with description text at \"" bad "\"; put two or more spaces between them"
        print "G\t" gname[i] "\t" gu[i] "\t" gr[i] "\t" gd[i]
      }
    }
  ' - "${scripts[@]}")"
fi

# The catalog, as one JSON array. Arguments come from the usage tokens:
# [x] is optional, <x> and UPPER are values, a|b is a choice, --x is a flag,
# --x VALUE or --x <v> an option, ... passes more arguments through, and a
# bare word is literal. A form of a confirm action needs a yes unless it is
# a --dry-run, --help, or --check form, or `# yes-for:` leaves it out.
# shellcheck disable=SC2016 # jq program, not shell
catalog="$(printf '%s\n' "$rows" | jq -nR '
  def arg:
    (startswith("[") and endswith("]")) as $opt
    | (if $opt then .[1:-1] else . end) as $in
    | ($in | split(" ") | map(select(. != ""))) as $w
    | {kind: null, name: null, flag: null, value: null, choices: null, required: ($opt | not), raw: $in}
    | if $in == "..." then .kind = "more" | .required = false
      elif ($w[0] | startswith("-")) then
        .flag = ($w[0] | rtrimstr(",")) | .value = ($w[1:] | join(" ") | if . == "" then null else . end)
        | .kind = (if .value then "option" else "flag" end)
      elif ($in | test("^<[^>]+>$")) then .kind = "positional" | .name = ($in | .[1:-1])
      elif ($in | test("<")) then .kind = "positional" | .name = ($in | gsub("[<>]"; ""))
      elif ($in | test("\\|")) then .kind = "choice" | .choices = ($in | split("|"))
      elif ($in | test("^[A-Z][A-Z0-9_]*$")) then .kind = "positional" | .name = ($in | ascii_downcase)
      else .kind = "word" | .name = $in
      end;
  # A required --flag followed by a required <value> is one option.
  def fold: reduce .[] as $a ([];
    if length > 0 and .[length - 1].kind == "flag" and .[length - 1].required and $a.kind == "positional" and $a.required
    then (length - 1) as $k | .[$k].kind = "option" | .[$k].value = $a.raw
    else . + [$a] end);
  def args: [scan("\\[[^\\]]*\\]|[^ <\\[]*<[^>]*>[^ ]*|[^ ]+") | arg] | fold | map(del(.raw));
  def free: any(.args[]; .required and (.flag == "--dry-run" or .flag == "--help" or .flag == "-h" or .flag == "--check"));
  [inputs | select(length > 0) | split("\t")] as $rows
  | ([$rows[] | select(.[0] == "T") | {(.[1]): (.[2] == "1")}] | add // {}) as $top
  | ([$rows[] | select(.[0] == "W") | {(.[1] + " " + .[2]): (.[3] == "1")}] | add // {}) as $sub
  | [ $rows[] | select(.[0] == "A") | .[1] as $n
      | ([$rows[] | select(.[0] == "N" and .[1] == $n) | {(.[2]): .[3]}] | add // {}) as $notes
      | ([$rows[] | select(.[0] == "S" and .[1] == $n) | .[2]][0]) as $script
      | (any($rows[]; .[0] == "K" and .[1] == $n)) as $armgate
      | ($notes["yes-for"] // null | if . then split(" ") | map(select(. != "")) else null end) as $yesfor
      | def form($from_header):
          {usage: .[2], help: .[4], args: (.[3] | args)}
          | (.args[0] // {}) as $first
          | ($first | if .kind == "word" then .name elif (.kind == "flag" or .kind == "option") and .required then .flag else null end) as $key
          | .needs_yes = ($notes.confirm != null and (free | not)
              and (if $yesfor == null then true
                   else $from_header and $first.kind == "word" and any($yesfor[]; . == $first.name) end))
          | .gated = (if $key != null and $script != null and ($sub | has($script + " " + $key))
                      then $sub[$script + " " + $key]
                      else ($armgate or ($script != null and ($top[$script] // false))) end);
        [$rows[] | select(.[0] == "F" and .[1] == $n) | form(false)] as $forms
      | [$rows[] | select(.[0] == "G" and .[1] == $n) | form(true)] as $subforms
      | { name: $n,
          aliases: (.[2] | split("|") | map(select(. != $n))),
          command: ("dotfiles " + $n),
          help: ($forms[0].help // ""),
          forms: $forms,
          subforms: $subforms,
          agent: ($notes["terminal-only"] == null),
          terminal_only: $notes["terminal-only"],
          confirm: $notes.confirm,
          yes_for: $yesfor,
          unattended: $notes.unattended,
          agent_note: $notes.agent } ]
')"

# Per form: a form that needs a yes takes --yes, and a yes gate in code
# reaches it, unless an # unattended: note says why the action runs without
# one. Every # yes-for: word names a sub-form.
# shellcheck disable=SC2016 # jq program, not shell
problems="$(
  printf '%s\n' "$rows" | awk -F '\t' '$1 == "E" { print $2 }'
  printf '%s' "$catalog" | jq -r '
    .[] | select(.confirm and .unattended == null) | .name as $n
    | ((.forms[], .subforms[]) | select(.needs_yes)
        | if any(.args[]; .flag == "--yes") | not then
            "\($n): \(.usage) changes something hard to undo, but takes no --yes; add [--yes] and a yes gate (lib/confirm.sh), or an # unattended: reason"
          elif .gated | not then
            "\($n): \(.usage) takes --yes, but no yes gate in code reaches it; call confirm_yes, confirm_gate, or confirm_require_yes (lib/confirm.sh) on its path"
          else empty end),
      (. as $a | (.yes_for // [])[] | select(. as $w | any($a.subforms[]; .args[0].name == $w) | not)
        | "\($n): # yes-for: names \(.), but no sub-form in its script header starts with it"),
      (select(any(.forms[], .subforms[]; .needs_yes) | not) | "\($n): marked confirm, but no form needs a yes; add a form that takes --yes, or an # unattended: reason")'
)"

total="$(printf '%s' "$catalog" | jq 'length')"

if [ "$mode" = check ]; then
  if [ -n "$problems" ]; then
    printf '✗ %s\n' "$problems"
    echo "Fix bin/dotfiles so every case arm has a show_help line (see the comment above show_help)."
    exit 1
  fi
  echo "✓ $total actions: every dispatched command has a help line, and every help line a command (bin/dotfiles)"
  exit 0
fi

[ -z "$problems" ] || printf '! %s (run: dotfiles actions --check)\n' "$problems" >&2

if [ -n "$want" ]; then
  catalog="$(printf '%s' "$catalog" | jq --arg q "$want" 'map(select(.name == $q or any(.aliases[]; . == $q)))')"
  [ "$(printf '%s' "$catalog" | jq 'length')" -gt 0 ] || die "no action named $want. Run: dotfiles actions"
fi

if [ "$json" -eq 1 ]; then
  printf '%s\n' "$catalog"
  exit 0
fi

# One line per form; with a name, the sub-forms follow, indented.
# shellcheck disable=SC2016 # jq program, not shell
printf '%s' "$catalog" | jq -r --arg one "$want" '
  .[] | . as $a
  | ((if (.forms | length) == 0 then [{usage: .command, help: "(no help line in bin/dotfiles)"}] else .forms end)
    | to_entries[]
    | "\(.value.usage)  - \(.value.help)" + (if .key > 0 then "" else
        ($a | (if .terminal_only then "  [terminal only: \(.terminal_only)]" else "" end)
          + (if .confirm then "  [confirm: \(.confirm)]" else "" end)
          + (if .unattended then "  [no --yes: \(.unattended)]" else "" end)
          + (if .agent_note then "  [agents: \(.agent_note)]" else "" end)) end)),
    (if $one != "" then ($a.subforms[] | "  \(.usage)" + (if .help != "" then "  - \(.help)" else "" end) + (if .needs_yes then "  [needs a yes]" else "" end)) else empty end)
'
echo "$(printf '%s' "$catalog" | jq 'length') action(s) from bin/dotfiles; agents: dotfiles actions --json"
