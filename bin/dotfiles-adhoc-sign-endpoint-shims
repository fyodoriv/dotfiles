#!/bin/bash
set -uo pipefail

SHIM_DIR="${1:-}"
if [ -z "$SHIM_DIR" ]; then
  SHIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
fi

QUIET="${DOTFILES_ADHOC_SIGN_QUIET:-0}"
log() { [ "$QUIET" = "1" ] || printf '%s\n' "$*"; }

signed=0
skipped_signed=0
skipped_missing=0
failed=0

# curl/jq/python/grep/sed/awk/find/otool shims are symlinks to signed Mach-O (dotfiles-link-*-shim) — skip here.
# git is the push-guard bash wrapper — sign when present.
for name in grep ggrep find sed awk otool python3 python3.13 git; do
  path="$SHIM_DIR/$name"
  if [ ! -f "$path" ] || [ ! -x "$path" ] || [ -L "$path" ]; then
    skipped_missing=$((skipped_missing + 1))
    continue
  fi
  sig="$(codesign -dvv "$path" 2>&1 | awk '/Signature=|not signed/ { print; exit }')"
  case "$sig" in
    *"not signed"*)
      if codesign --sign - --force "$path" 2>/dev/null; then
        signed=$((signed + 1))
      else
        failed=$((failed + 1))
      fi
      ;;
    *)
      skipped_signed=$((skipped_signed + 1))
      ;;
  esac
done

log "✓ Ad-hoc signed $signed dotfiles endpoint shim(s) (endpoint agent)"
log "  (skipped: $skipped_signed already-signed, $skipped_missing missing/symlink; failed: $failed)"
exit 0
