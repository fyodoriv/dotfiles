#!/bin/bash
# dotfiles-adhoc-sign-jq — fast ad-hoc sign Homebrew jq only (login bootstrap).
#
# Full Cellar sweep (dotfiles-adhoc-sign-bottles) is too slow for RunAtLoad
# races with minsky tick-loop / daemon. This signs jq alone so endpoint-safe Mach-O
# exists before supervised loops spawn jq.
set -uo pipefail

QUIET="${DOTFILES_ADHOC_SIGN_QUIET:-0}"
log() { [ "$QUIET" = "1" ] || printf '%s\n' "$*"; }

_resolve_brew_jq() {
  local candidate
  if [ -n "${DOTFILES_BREW_PREFIX:-}" ]; then
    candidate="${DOTFILES_BREW_PREFIX}/bin/jq"
    [ -x "$candidate" ] && printf '%s\n' "$candidate" && return 0
  fi
  for candidate in /opt/homebrew/bin/jq /usr/local/bin/jq; do
    [ -x "$candidate" ] && printf '%s\n' "$candidate" && return 0
  done
  return 1
}

JQ_BIN="$(_resolve_brew_jq || true)"
if [ -z "$JQ_BIN" ]; then
  log "→ Homebrew jq not found — skipping fast jq sign"
  exit 0
fi

sig="$(codesign -dvv "$JQ_BIN" 2>&1 | awk '/Signature=|not signed/ { print; exit }')"
case "$sig" in
  *"not signed"*)
    if codesign --sign - --force "$JQ_BIN" 2>/dev/null; then
      log "✓ Ad-hoc signed jq at $JQ_BIN"
    else
      log "⚠ Failed to ad-hoc sign jq at $JQ_BIN" >&2
      exit 1
    fi
    ;;
  *)
    log "○ jq already signed at $JQ_BIN"
    ;;
esac
exit 0
