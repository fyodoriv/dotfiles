#!/bin/bash
# Usage: dotfiles-codex-agent-access [--check]
set -euo pipefail

case "${1:-}" in
  ""|--check) ;;
  *) echo "Usage: dotfiles-codex-agent-access [--check]" >&2; exit 2 ;;
esac

python3 - "${CODEX_HOME:-$HOME/.codex}/config.toml" "${1:-}" <<'PY'
from pathlib import Path
import os
import shutil
import sys
import tempfile
import tomllib

path = Path(sys.argv[1]).resolve()
try:
    original = path.read_bytes()
    config = tomllib.loads(original.decode("utf-8"))
except (OSError, ValueError):
    sys.exit("Codex config is missing or invalid")

features = config.get("features", {})
if not isinstance(features, dict):
    sys.exit("Codex features must be a table")
if "network_proxy" in features:
    proxy = features["network_proxy"]
    if proxy is True or isinstance(proxy, dict) and proxy.get("enabled") is True:
        sys.exit(0)
    sys.exit("Codex network proxy has an explicit setting; review it in config.toml")

if sys.argv[2] == "--check":
    sys.exit(1)

updated = original.rstrip(b"\r\n") + b"\n\n[features.network_proxy]\nenabled = true\n"
try:
    tomllib.loads(updated.decode("utf-8"))
except ValueError:
    sys.exit("Codex config cannot accept a separate network proxy table")

with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as staged:
    temporary = Path(staged.name)
    try:
        staged.write(updated)
        staged.close()
        shutil.copymode(path, temporary)
        if path.read_bytes() != original:
            sys.exit("Codex config changed during repair; run the check again")
        with tempfile.NamedTemporaryFile(dir=path.parent, prefix=f"{path.name}.bak-", delete=False) as saved:
            saved.write(original)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)
print("Added the Codex network proxy. Restart the ChatGPT app to apply it.")
PY
