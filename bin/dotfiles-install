#!/bin/bash
# dotfiles-install — one-step installer for dotfiles (and agentbrew). An agent
# runs it from a fresh clone; INSTALL.md is the playbook that tells it how.
#
# Usage:
#   dotfiles-install plan [--profile core|full]   Explain what will change; change nothing
#   dotfiles-install run --yes [flags]            Back up, apply, heal, verify (+ agentbrew)
#   dotfiles-install restore [BACKUP_ID] [--yes]  Put the backed-up files and macOS settings back
#   dotfiles-install backups                      List backups
#
# Flags for `run` (the answers to the INSTALL.md questions):
#   --profile core|full     core = essentials (default); full = everything, incl. visual settings and apps
#   --name NAME             git commit name
#   --email EMAIL           git commit email
#   --no-macos-defaults     Do not change macOS system settings
#   --no-agentbrew          Do not install agentbrew afterwards
#   --agentbrew-dir DIR     Where to clone agentbrew (default: next to this repo)
#   --agentbrew-flags "..." Flags passed to agentbrew's installer (for example "--no-auto-repair")
#   --tool URL              Also install another tool repo after agentbrew: a read-only
#                           clone (push URL DISABLED), then its scripts/install.sh run --yes.
#                           Repeatable.
#   --tool-flags "..."      Flags for the installer of the last --tool (for example "--plugin acme")
#   --tools-dir DIR         Where to clone --tool repos (default: next to this repo)
#   --yes                   Required: confirms the user agreed to the plan
#
# Phases: preflight -> backup (chezmoi config, every file chezmoi manages,
# dotfiles LaunchAgents, each macOS settings domain) -> apply -> heal ->
# verify -> agentbrew. A failed apply or verify restores the backup by itself.
# A restore removes the targets and folders the run created. Homebrew
# packages stay installed; script caches and tools stay and are listed.
set -uo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
BACKUP_ROOT="$STATE_DIR/install-backups"
CHEZMOI_CONFIG="$HOME/.config/chezmoi/chezmoi.yaml"
LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"
DOCTOR="${DOTFILES_INSTALL_DOCTOR:-$REPO_DIR/bin/dotfiles-doctor}"
AGENTBREW_URL="${DOTFILES_INSTALL_AGENTBREW_URL:-https://github.com/fyodoriv/agentbrew.git}"

# shellcheck source=../lib/mac-baseline.sh
source "$REPO_DIR/lib/mac-baseline.sh"
# shellcheck source=../lib/confirm.sh
source "$REPO_DIR/lib/confirm.sh"

say() { printf '%s\n' "$*"; }
step() { printf '\n== %s\n' "$*"; }
usage() { sed -n '2,27p' "$0" | sed -E 's/^# ?//'; }

# macOS settings domains that macos*.sh may change (data/macos-defaults.json).
defaults_domains() {
  jq -r '[.[]? | .domain? // empty] | unique | .[]' "$REPO_DIR/data/macos-defaults.json" 2>/dev/null
}

# The endpoint scripts accept only Homebrew jq, never /usr/bin/jq.
brew_jq_present() {
  local prefix
  for prefix in ${DOTFILES_BREW_PREFIX:-$(brew --prefix 2>/dev/null) /opt/homebrew /usr/local}; do
    [ -x "$prefix/bin/jq" ] && return 0
  done
  return 1
}

tool_label() { if [ "$1" = jq ]; then printf 'jq (Homebrew)'; else printf '%s' "$1"; fi; }
tool_present() { if [ "$1" = jq ]; then brew_jq_present; else command -v "$1" >/dev/null 2>&1; fi; }

# preflight [check|install]: `check` (plan) reports what `run` will install
# and changes nothing; `install` (run) installs a missing tool with Homebrew.
preflight() {
  local mode="${1:-install}" ok=0 tool label
  if xcode-select -p >/dev/null 2>&1 || [ -n "${DOTFILES_INSTALL_SKIP_XCODE_CHECK:-}" ]; then say "  ✓ Xcode Command Line Tools"
  else say "  ✗ Xcode Command Line Tools: run 'xcode-select --install' (a macOS dialog opens)"; ok=1; fi
  if command -v brew >/dev/null 2>&1; then say "  ✓ Homebrew"
  else say "  ✗ Homebrew: install it from https://brew.sh (it asks for your Mac password)"; ok=1; fi
  # With Homebrew present, install a missing tool instead of stopping, so the
  # README one-liner works on a Mac that has only Homebrew.
  for tool in ${DOTFILES_INSTALL_TOOLS:-git jq chezmoi}; do
    label="$(tool_label "$tool")"
    if tool_present "$tool"; then say "  ✓ $label"
    elif ! command -v brew >/dev/null 2>&1; then say "  ✗ $label: brew install $tool"; ok=1
    elif [ "$mode" = check ]; then say "  → $label: will be installed (brew install $tool)"
    elif say "  → $label: brew install $tool" && brew install "$tool" >/dev/null 2>&1 && tool_present "$tool"; then
      say "  ✓ $label (installed)"
    else say "  ✗ $label: brew install $tool"; ok=1; fi
  done
  return "$ok"
}

cmd_plan() {
  local profile="core"
  [ "${1:-}" = "--profile" ] && profile="${2:-core}"
  say "dotfiles install plan (profile: $profile; nothing has changed yet)"
  step "What you need"
  preflight check
  say "  - 10-20 minutes for core, 30-60 for full (Homebrew downloads)."
  say "  - Your Mac password once or twice (Homebrew; power settings are skipped without it)."
  say "  - Stay on power and network. You can keep working; apps may restart."
  step "Your Mac today (compare after the install: dotfiles metrics --baseline)"
  baseline_report "  - "
  say "  - Expected disk use ($profile): $(baseline_profile_disk "$profile")"
  step "What will happen"
  say "  1. Back up to $BACKUP_ROOT/<time>/:"
  say "     your chezmoi config, every config file dotfiles will manage (~/.zshrc,"
  say "     ~/.gitconfig, ~/.config/... ), dotfiles LaunchAgents, and $(defaults_domains | wc -l | tr -d ' ') macOS settings domains."
  say "  2. chezmoi apply: link shell and git config, install Homebrew packages for"
  say "     the $profile profile, set macOS settings (unless you opt out), and add"
  say "     background jobs (sync off for you, doctor weekly, load sampler)."
  say "  3. Heal: 'dotfiles doctor --fix' repairs what it can."
  say "  4. Verify: 'chezmoi verify' and a clean zsh start."
  say "  5. Install agentbrew (AI agent skills and rules) with its own installer, unless you opt out."
  say "     Then any extra tool repos you name (--tool), each with its own installer."
  say "  6. Feedback: how to send a fix (agentbrew contribute) or a report (agentbrew report)."
  step "If something goes wrong"
  say "  A critical error in apply or verify restores the backup automatically:"
  say "  files, LaunchAgents, and macOS settings, and it removes the files and folders"
  say "  the install created. Homebrew packages stay installed; caches and tools the"
  say "  install scripts made stay too, and the restore lists them."
  say "  Undo by hand any time: bash $REPO_DIR/bin/dotfiles-install restore"
  step "Your choices (the agent asks you these)"
  say "  - Profile: core (recommended) or full"
  say "  - Your git name and email"
  say "  - Change macOS system settings? (default yes)"
  say "  - Also install agentbrew? (default yes) and where to put it"
  say "  - Any other tool repo to install with it? (--tool URL; default none)"
}

# Backup ids are timestamps, so the glob's sort order is oldest first.
latest_backup() {
  local d last=""
  for d in "$BACKUP_ROOT"/*/; do [ -d "$d" ] && last="$(basename "$d")"; done
  printf '%s' "$last"
}

backup_files() {
  local dir="$1" rel plist existing=()
  : > "$dir/absent.txt"
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    if [ -e "$HOME/$rel" ] || [ -L "$HOME/$rel" ]; then existing+=("$rel"); else printf '%s\n' "$rel" >> "$dir/absent.txt"; fi
  done < <(chezmoi managed --source "$REPO_DIR" --include files,symlinks 2>/dev/null)
  # Directories apply may create (for example ~/.agent-browser). Restore
  # removes the ones that were absent, so a rollback leaves nothing behind.
  touch "$dir/absent-dirs.txt"
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    [ -e "$HOME/$rel" ] || [ -L "$HOME/$rel" ] || printf '%s\n' "$rel" >> "$dir/absent-dirs.txt"
  done < <(chezmoi managed --source "$REPO_DIR" --include dirs 2>/dev/null)
  if [ -d "$LAUNCH_AGENTS_DIR" ]; then
    : > "$dir/launchagents.txt"
    for plist in "$LAUNCH_AGENTS_DIR"/com.dotfiles.*.plist; do
      [ -e "$plist" ] && printf 'Library/LaunchAgents/%s\n' "$(basename "$plist")" >> "$dir/launchagents.txt"
    done
    while IFS= read -r rel; do [ -n "$rel" ] && existing+=("$rel"); done < "$dir/launchagents.txt"
  else
    : > "$dir/launchagents.txt"
  fi
  printf '%s\n' "${existing[@]+"${existing[@]}"}" > "$dir/present.txt"
  if [ "${#existing[@]}" -gt 0 ]; then
    (cd "$HOME" && tar -czf "$dir/files.tar.gz" "${existing[@]}") || return 1
  else
    tar -czf "$dir/files.tar.gz" -T /dev/null || return 1
  fi
  say "  ✓ ${#existing[@]} file(s) and LaunchAgent(s)"
}

backup_defaults() {
  local dir="$1" domain n=0
  mkdir -p "$dir/defaults"
  : > "$dir/defaults-absent.txt"
  while IFS= read -r domain; do
    [ -n "$domain" ] || continue
    if defaults export "$domain" "$dir/defaults/$domain.plist" >/dev/null 2>&1; then n=$((n + 1))
    else printf '%s\n' "$domain" >> "$dir/defaults-absent.txt"; fi
  done < <(defaults_domains)
  say "  ✓ $n macOS settings domain(s)"
}

restore_defaults() {
  local dir="$1" file domain
  for file in "$dir"/defaults/*.plist; do
    [ -e "$file" ] || continue
    domain="$(basename "$file" .plist)"
    defaults import "$domain" "$file" >/dev/null 2>&1 || say "  ! could not restore settings domain $domain"
  done
  while IFS= read -r domain; do
    [ -n "$domain" ] && defaults delete "$domain" >/dev/null 2>&1
  done < "$dir/defaults-absent.txt"
  killall cfprefsd Dock Finder SystemUIServer >/dev/null 2>&1 || true
}

# HOME paths up to 3 levels deep, for the "left behind" report after a restore.
# ~/Library is skipped: other apps write there all the time.
home_paths() {
  (cd "$HOME" && find . -maxdepth 3 -path ./Library -prune -o -print 2>/dev/null) | LC_ALL=C sort
}

# Install scripts also write caches and tools outside the chezmoi targets
# (for example ~/.cache/uv). Removing those is not safe, so list them.
# Sets LEFTOVER_COUNT for critical(), so it never claims a full restore.
LEFTOVER_COUNT=0
report_leftovers() {
  local left n
  LEFTOVER_COUNT=0
  [ -f "$1/home-before.txt" ] || return 0
  # Keep only the top new path of each new tree: ~/.cache, not ~/.cache/uv.
  left="$(LC_ALL=C comm -13 "$1/home-before.txt" <(home_paths) |
    awk 'last == "" || index($0, last "/") != 1 { print; last = $0 }')"
  [ -n "$left" ] || return 0
  n="$(printf '%s\n' "$left" | wc -l | tr -d ' ')"
  LEFTOVER_COUNT="$n"
  say "  ! $n new path(s) in your home folder are not chezmoi targets, so restore keeps them."
  say "    The install scripts made them (caches, tools, local config). Delete them by hand if you do not want them:"
  printf '%s\n' "$left" | head -20 | sed 's|^\./|      ~/|'
  [ "$n" -le 20 ] || say "      ... and $((n - 20)) more"
}

# Remove the directories that did not exist before the run. Never remove one
# that holds the backups. Backups made before absent-dirs.txt skip this.
remove_created_dirs() {
  local rel
  [ -f "$1/absent-dirs.txt" ] || return 0
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    case "$BACKUP_ROOT/" in "$HOME/$rel/"*) continue ;; esac
    rm -rf "${HOME:?}/$rel"
  done < "$1/absent-dirs.txt"
}

do_restore() {
  local id="${1:-$(latest_backup)}" dir rel plist
  [ -n "$id" ] || { say "No backup found in $BACKUP_ROOT"; return 1; }
  dir="$BACKUP_ROOT/$id"
  [ -f "$dir/files.tar.gz" ] || { say "Backup $id not found in $BACKUP_ROOT"; return 1; }
  if [ -d "$LAUNCH_AGENTS_DIR" ]; then
    for plist in "$LAUNCH_AGENTS_DIR"/com.dotfiles.*.plist; do
      [ -e "$plist" ] || continue
      rel="Library/LaunchAgents/$(basename "$plist")"
      launchctl bootout "gui/$(id -u)" "$plist" >/dev/null 2>&1 || true
      grep -qxF "$rel" "$dir/launchagents.txt" 2>/dev/null || rm -f "$plist"
    done
  fi
  while IFS= read -r rel; do [ -n "$rel" ] && rm -rf "${HOME:?}/$rel"; done < "$dir/absent.txt"
  remove_created_dirs "$dir"
  while IFS= read -r rel; do [ -n "$rel" ] && rm -rf "${HOME:?}/$rel"; done < "$dir/present.txt"
  (cd "$HOME" && tar -xzf "$dir/files.tar.gz") || return 1
  while IFS= read -r rel; do
    [ -n "$rel" ] && launchctl bootstrap "gui/$(id -u)" "$HOME/$rel" >/dev/null 2>&1 || true
  done < "$dir/launchagents.txt"
  if [ -f "$dir/chezmoi.yaml" ]; then
    mkdir -p "$(dirname "$CHEZMOI_CONFIG")" && cp "$dir/chezmoi.yaml" "$CHEZMOI_CONFIG"
  else
    rm -f "$CHEZMOI_CONFIG"
  fi
  restore_defaults "$dir"
  say "  ✓ Restored files, LaunchAgents, chezmoi config, and macOS settings from backup $id"
  report_leftovers "$dir"
}

# The last step of every run, success or failure (#301): how to send a fix
# or a report upstream.
feedback_step() {
  step "Feedback"
  say "  Found a bug or have an idea? Send it upstream (agentbrew scrubs private details first):"
  say "    agentbrew contribute   open a fix PR from your branch"
  say "    agentbrew report       draft an issue; it shows the exact text and posts only after you say yes"
  say "  Without agentbrew: https://github.com/fyodoriv/dotfiles/issues"
}

# clone_readonly <url> <dir>: clone once, then make the clone read-only
# (push URL DISABLED), as the dotfiles and agentbrew clones are.
clone_readonly() {
  [ -d "$2/.git" ] && return 0
  git clone -q "$1" "$2" || return 1
  git -C "$2" remote set-url --push origin DISABLED
}

critical() {
  receipt_finish false "$1"
  say ""
  say "✗ Critical error during $1. Restoring your previous setup..."
  if do_restore "$BACKUP_ID"; then
    if [ "${LEFTOVER_COUNT:-0}" -gt 0 ]; then
      say "Your managed files and settings are back to how they were, apart from the new path(s) listed above (Homebrew packages stay installed)."
    else
      say "Your Mac is back to how it was before (Homebrew packages stay installed)."
    fi
  else
    say "Automatic restore failed. Restore by hand: bash $REPO_DIR/bin/dotfiles-install restore $BACKUP_ID"
  fi
  say "Please report it: https://github.com/fyodoriv/dotfiles/issues (attach the output above)."
  feedback_step
  exit 1
}

cmd_run() {
  local yes=0 profile=core name="" email="" macos=1 agentbrew=1 ab_dir="" ab_flags="" dir rel
  local tools_dir="" url tool_dir i
  local -a tool_urls=() tool_flags=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes) yes=1 ;;
      --profile) profile="${2:-}"; shift ;;
      --name) name="${2:-}"; shift ;;
      --email) email="${2:-}"; shift ;;
      --no-macos-defaults) macos=0 ;;
      --no-agentbrew) agentbrew=0 ;;
      --agentbrew-dir) ab_dir="${2:-}"; shift ;;
      --agentbrew-flags) ab_flags="${2:-}"; shift ;;
      --tool) tool_urls+=("${2:-}"); tool_flags+=(""); shift ;;
      --tool-flags)
        [ "${#tool_urls[@]}" -gt 0 ] || { say "--tool-flags must follow a --tool"; exit 2; }
        tool_flags[${#tool_flags[@]}-1]="${2:-}"; shift ;;
      --tools-dir) tools_dir="${2:-}"; shift ;;
      *) say "Unknown flag: $1"; usage; exit 2 ;;
    esac
    shift
  done
  confirm_require_yes "$yes" "Show the plan first (dotfiles-install plan), then rerun with --yes."
  case "$profile" in core|full) ;; *) say "--profile must be core or full"; exit 2 ;; esac
  # Before anything changes: the "before" half of the install receipt.
  receipt_begin "$profile"

  step "1/6 Check prerequisites"
  preflight install || { say "Install the missing tools above, then run again. Nothing was changed."; exit 1; }

  step "2/6 Back up current settings"
  BACKUP_ID="$(date +%Y%m%d-%H%M%S)"
  dir="$BACKUP_ROOT/$BACKUP_ID"
  mkdir -p "$dir" || { say "Cannot create $dir. Nothing was changed."; exit 1; }
  # chezmoi init below creates ~/.config/chezmoi; restore removes it if it is new.
  : > "$dir/absent-dirs.txt"
  for rel in .config .config/chezmoi; do [ -e "$HOME/$rel" ] || printf '%s\n' "$rel" >> "$dir/absent-dirs.txt"; done
  home_paths > "$dir/home-before.txt"
  [ -f "$CHEZMOI_CONFIG" ] && cp "$CHEZMOI_CONFIG" "$dir/chezmoi.yaml"
  chezmoi init --source "$REPO_DIR" --promptDefaults \
    --promptChoice "Installation profile (full = all modules, core = essential only)=$profile" \
    --promptString "Git commit name for work/default identity=$name" \
    --promptString "Git commit email for work/default identity=$email" \
    --promptString "Dotfiles directory relative to home (e.g. apps/dotfiles, dotfiles)=${REPO_DIR#"$HOME"/}" \
    >/dev/null 2>&1 || critical "chezmoi init"
  backup_files "$dir" || critical "the file backup"
  backup_defaults "$dir"
  say "  Backup: $dir"

  step "3/6 Apply"
  export DOTFILES_SNAPSHOT_DONE=1 DOTFILES_GIT_NAME="$name" DOTFILES_GIT_EMAIL="$email"
  [ "$macos" -eq 1 ] || export DOTFILES_SKIP_MACOS_DEFAULTS=1
  chezmoi apply --source "$REPO_DIR" --force || critical "chezmoi apply"

  step "4/6 Heal"
  if ! bash "$DOCTOR" --fix; then
    say "  ! Some checks still fail. Your setup works; run 'dotfiles doctor' to see them."
  fi

  step "5/6 Verify"
  # Scripts never "match" a target state, so verify the managed files only.
  chezmoi verify --source "$REPO_DIR" --exclude scripts >/dev/null 2>&1 || critical "verification (chezmoi verify)"
  # `exit 0`, not `exit`: a plain exit returns the last startup line's status,
  # and macOS /etc/zshrc ends with a test that is false outside Terminal.app.
  # So zsh fails the install only when it cannot run (as the zsh timing, #290);
  # errors it prints while starting are a warning, not a rollback.
  zsh_err="$(zsh -i -c 'exit 0' 2>&1 >/dev/null </dev/null)" || critical "verification (zsh does not run)"
  [ -z "$zsh_err" ] || say "  ! zsh printed errors while starting: ${zsh_err%%$'\n'*}"

  step "6/6 agentbrew"
  if [ "$agentbrew" -eq 1 ]; then
    ab_dir="${ab_dir:-$(dirname "$REPO_DIR")/agentbrew}"
    clone_readonly "$AGENTBREW_URL" "$ab_dir" || say "  ! Could not clone agentbrew; install it later from INSTALL.md."
    if [ -f "$ab_dir/scripts/install.sh" ]; then
      # shellcheck disable=SC2086  # ab_flags is a list of flags on purpose
      bash "$ab_dir/scripts/install.sh" run --yes $ab_flags ||
        say "  ! agentbrew did not install (it restored its own backup). dotfiles is installed."
    fi
  else
    say "  skipped (you chose not to install agentbrew)"
  fi

  # Extra tool repos (--tool): the same hand-off as agentbrew.
  for ((i = 0; i < ${#tool_urls[@]}; i++)); do
    url="${tool_urls[$i]}"
    [ -n "$url" ] || continue
    tool_dir="${tools_dir:-$(dirname "$REPO_DIR")}/$(basename "${url%.git}")"
    step "Extra tool: $(basename "$tool_dir")"
    # A folder of that name from another repo (agentbrew, say) is not this tool.
    if [ -d "$tool_dir/.git" ] && [ "$(git -C "$tool_dir" remote get-url origin 2>/dev/null)" != "$url" ]; then
      say "  ! $tool_dir is a clone of another repo; skipped (use --tools-dir to pick another folder)."
      continue
    fi
    if ! clone_readonly "$url" "$tool_dir"; then
      say "  ! Could not clone $url; install it later by hand. dotfiles is installed."
      continue
    fi
    if [ -f "$tool_dir/scripts/install.sh" ]; then
      # shellcheck disable=SC2086  # the flags are a list of flags on purpose
      bash "$tool_dir/scripts/install.sh" run --yes ${tool_flags[$i]} ||
        say "  ! $(basename "$tool_dir") did not install. dotfiles is installed."
    else
      say "  ! $tool_dir has no scripts/install.sh; cloned only."
    fi
  done

  receipt_finish true
  step "Done"
  say "dotfiles is installed. Backup: $dir"
  say "Undo any time: bash $REPO_DIR/bin/dotfiles-install restore $BACKUP_ID"
  say "Open a new terminal to load the new shell. See how it runs: dotfiles metrics"
  say "In a week, see what changed since the install: dotfiles metrics --gains"
  say ""
  say "Found something to fix in dotfiles while installing? Send it upstream:"
  say "  cd $REPO_DIR && git switch -c fix/<short-name>"
  say "  # change the code, add a test and update the docs, then run: make check"
  say "  dotfiles contribute --dry-run && dotfiles contribute"
  feedback_step
}

case "${1:-}" in
  plan) shift; cmd_plan "$@" ;;
  run) shift; cmd_run "$@" ;;
  restore)
    shift
    _yes=0 _id=""
    for _a in "$@"; do
      case "$_a" in
        --yes) _yes=1 ;;
        -h | --help) usage; exit 0 ;;
        -*) say "Unknown flag: $_a"; usage; exit 2 ;;
        *) _id="$_a" ;;
      esac
    done
    confirm_yes "$_yes" "replaces your managed files, LaunchAgents, chezmoi config, and macOS settings with backup ${_id:-(the latest)}"
    do_restore "$_id" ;;
  backups) ls -1 "$BACKUP_ROOT" 2>/dev/null || say "No backups yet." ;;
  -h|--help|help|"") usage ;;
  *) say "Unknown command: $1"; usage; exit 2 ;;
esac
