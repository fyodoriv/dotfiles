#!/bin/bash
# Check that each loaded com.dotfiles.* LaunchAgent runs what its plist says
# (issue #297). After `dotfiles apply`, a plist on disk can be right while
# launchd still runs the old loaded copy until the job is reloaded, and a
# KeepAlive job bootstrapped from a non-GUI shell can stay "not running".
#
# Usage: dotfiles-launchagent-drift [--fix]
#   One line per job:
#     ok <label>
#     drift <label>: the loaded job runs other arguments than its plist
#     log-path <label>: a log path still contains an unexpanded HOME placeholder
#     tool-path <label>: the registered sync job cannot find chezmoi
#     stopped <label>: KeepAlive job is not running
#     unloaded <label>: the plist is not loaded
#   --fix reloads a drifted job (bootout, then bootstrap), kickstarts a
#   stopped one, and bootstraps an unloaded one. A job disabled in launchd
#   (launchctl print-disabled) is left alone: it is off on purpose. In
#   endpoint safe mode (~/.local/state/dotfiles/endpoint-node-publisher-blocked)
#   --fix only reports, like the other reload scripts. Only KeepAlive <true/>
#   counts as "must run": a KeepAlive dictionary (SuccessfulExit) may exit.
#   Render log paths before repairing a job with a HOME placeholder.
#   A missing tool or unverified tool check also stops repair for the sync job.
#
# Exit: 0 when every job is ok (or was fixed); 1 when a problem is left.

set -uo pipefail
{ [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; } && { sed -n '/^#!/d; /^$/q; /^[^#]/q; s/^# \{0,1\}//p' "$0"; exit 0; }

fix=false
[ "${1:-}" = --fix ] && fix=true
if $fix && [ -f "$HOME/.local/state/dotfiles/endpoint-node-publisher-blocked" ] &&
  [ "${DOTFILES_ALLOW_BLOCKED_NODE_PUBLISHER:-0}" != 1 ]; then
  echo "endpoint safe mode: --fix only reports (no job is loaded or reloaded)"
  fix=false
fi
LAUNCHCTL="${DOTFILES_LAUNCHCTL:-launchctl}"
domain="gui/$(id -u)"
agents="$HOME/Library/LaunchAgents"
disabled="$("$LAUNCHCTL" print-disabled "$domain" 2>/dev/null || true)"

# is_disabled <label>: launchd marks it disabled (`=> disabled`, or `=> true`
# on older macOS).
is_disabled() {
  grep -Fq -e "\"$1\" => disabled" -e "\"$1\" => true" <<< "$disabled"
}

# shellcheck source=../lib/launchagent-args.sh
repo_root="$(cd "$(dirname "$0")/.." && pwd -P)"
source "$repo_root/lib/launchagent-args.sh"

# The sync job uses chezmoi by name. Inspect its registered entry point and
# search the plist PATH as data. Never run a script or executable from it.
sync_job_has_chezmoi() {
  local file="$1" args launcher script script_dir env_type job_path directory
  local -a search_dirs
  args="$(/usr/bin/plutil -extract ProgramArguments raw -expect array -o - "$file" 2>/dev/null)" || return 2
  [ "$args" = 2 ] || return 2
  launcher="$(/usr/bin/plutil -extract ProgramArguments.0 raw -expect string -o - "$file" 2>/dev/null)" || return 2
  script="$(/usr/bin/plutil -extract ProgramArguments.1 raw -expect string -o - "$file" 2>/dev/null)" || return 2
  [ "$launcher" = /bin/bash ] && [[ "$script" == /*/dotfiles-sync ]] || return 2
  [ -f "$script" ] && [ ! -L "$script" ] || return 2
  script_dir="$(cd -P -- "${script%/*}" 2>/dev/null && pwd -P)" || return 2
  [ "$script_dir" = "$repo_root/bin" ] || return 2
  if /usr/bin/plutil -type Program "$file" >/dev/null 2>&1 ||
    /usr/bin/plutil -type EnvironmentVariables.BASH_ENV "$file" >/dev/null 2>&1; then
    return 2
  fi
  env_type="$(/usr/bin/plutil -type EnvironmentVariables "$file" 2>/dev/null)" || env_type=""
  [ -z "$env_type" ] || [ "$env_type" = dictionary ] || return 2
  job_path=/usr/bin:/bin
  if /usr/bin/plutil -type EnvironmentVariables.PATH "$file" >/dev/null 2>&1; then
    job_path="$(/usr/bin/plutil -extract EnvironmentVariables.PATH raw -expect string -o - "$file" 2>/dev/null)" || return 2
  fi
  case "$job_path" in
    ""|:*|*:|*::*|*$'\n'*) return 2 ;;
  esac
  IFS=: read -r -a search_dirs <<< "$job_path"
  for directory in "${search_dirs[@]}"; do
    [[ "$directory" == /* ]] || return 2
  done
  for directory in "${search_dirs[@]}"; do
    [ -f "$directory/chezmoi" ] && [ -x "$directory/chezmoi" ] && return 0
  done
  return 1
}

# reload <label> <plist>: bootout, wait until launchd lets the job go (a
# Chrome can outlive the bootout for a few seconds), then bootstrap.
reload() {
  local _
  "$LAUNCHCTL" bootout "$domain/$1" >/dev/null 2>&1
  for _ in $(seq 30); do
    "$LAUNCHCTL" print "$domain/$1" >/dev/null 2>&1 || break
    sleep 0.5
  done
  "$LAUNCHCTL" bootstrap "$domain" "$2" >/dev/null 2>&1 ||
    { sleep 2; "$LAUNCHCTL" bootstrap "$domain" "$2" >/dev/null 2>&1; }
}

problems=0
home_placeholder='${HOME}'
for plist in "$agents"/com.dotfiles.*.plist; do
  [ -f "$plist" ] || continue
  label="$(/usr/bin/plutil -extract Label raw -o - "$plist" 2>/dev/null || basename "$plist" .plist)"
  loaded=true
  if ! out="$("$LAUNCHCTL" print "$domain/$label" 2>/dev/null)"; then
    if is_disabled "$label"; then continue; fi
    loaded=false
  fi
  log_fields=""
  for field in StandardOutPath StandardErrorPath; do
    path="$(/usr/bin/plutil -extract "$field" raw -o - "$plist" 2>/dev/null)" || continue
    if [[ "$path" == *"$home_placeholder"* ]]; then
      log_fields="${log_fields:+$log_fields, }$field"
    fi
  done
  if [ -z "$log_fields" ] && $loaded && [[ "$out" == *"$home_placeholder"* ]]; then
    log_fields="$(awk -v marker="$home_placeholder" '
      index($0, marker) {
        if ($0 ~ /^\tstdout path = /) stdout=1
        if ($0 ~ /^\tstderr path = /) stderr=1
      }
      END {
        if (stdout) printf "loaded StandardOutPath"
        if (stderr) printf "%sloaded StandardErrorPath", (stdout ? ", " : "")
      }
    ' <<< "$out")"
  fi
  if [ -n "$log_fields" ]; then
    printf 'log-path %s: unexpanded HOME in %s. Check the rendered plist before loading or restarting it.\n' "$label" "$log_fields"
    problems=$((problems + 1))
    continue
  fi
  if [ "$label" = com.dotfiles.dotfiles-sync ] && ! is_disabled "$label"; then
    sync_job_has_chezmoi "$plist"
    case "$?" in
      1)
        printf 'tool-path %s: chezmoi is missing from the planned job PATH. Fix it before loading or restarting the job.\n' "$label"
        problems=$((problems + 1))
        continue ;;
      2)
        printf 'tool-path-unverified %s: the rendered job does not match the registered tool check.\n' "$label" >&2
        if $fix; then
          problems=$((problems + 1))
          continue
        fi ;;
    esac
  fi
  if ! $loaded; then
    if $fix && "$LAUNCHCTL" bootstrap "$domain" "$plist" >/dev/null 2>&1; then
      echo "bootstrapped $label"
    else
      echo "unloaded $label: the plist is not loaded"; problems=$((problems + 1))
    fi
    continue
  fi
  if [ "$(launchagent_loaded_args "$out")" != "$(launchagent_plist_args "$plist")" ]; then
    if $fix; then
      if reload "$label" "$plist"; then
        echo "reloaded $label"
      else
        echo "drift $label: the reload failed (run: launchctl bootstrap $domain $plist)"; problems=$((problems + 1))
      fi
    else
      echo "drift $label: the loaded job runs other arguments than its plist"; problems=$((problems + 1))
    fi
    continue
  fi
  state="$(sed -n 's/^\tstate = //p' <<< "$out" | head -n 1)"
  if [ "$(/usr/bin/plutil -extract KeepAlive raw -o - "$plist" 2>/dev/null)" = true ] && [ "$state" != running ]; then
    if $fix && "$LAUNCHCTL" kickstart "$domain/$label" >/dev/null 2>&1; then
      echo "kickstarted $label"
    else
      echo "stopped $label: KeepAlive job is not running"; problems=$((problems + 1))
    fi
    continue
  fi
  echo "ok $label"
done
[ "$problems" -eq 0 ]
