#!/bin/bash
set -euo pipefail

SHIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SHIM="$SHIM_DIR/find"

_resolve_brew_gfind() {
  local candidate
  if [ -n "${DOTFILES_BREW_PREFIX:-}" ]; then
    for candidate in \
      "${DOTFILES_BREW_PREFIX}/bin/gfind" \
      "${DOTFILES_BREW_PREFIX}/opt/findutils/libexec/gnubin/find"; do
      [ -x "$candidate" ] && printf '%s\n' "$candidate" && return 0
    done
  fi
  for candidate in \
    /opt/homebrew/bin/gfind \
    /usr/local/bin/gfind \
    /opt/homebrew/opt/findutils/libexec/gnubin/find \
    /usr/local/opt/findutils/libexec/gnubin/find; do
    [ -x "$candidate" ] && printf '%s\n' "$candidate" && return 0
  done
  return 1
}

BREW_FIND="$(_resolve_brew_gfind || true)"
if [ -z "$BREW_FIND" ]; then
  echo "find: Homebrew gfind not found — install findutils" >&2
  exit 1
fi

if [ -e "$SHIM" ] && [ ! -L "$SHIM" ]; then
  rm -f "$SHIM"
fi

ln -sfn "$BREW_FIND" "$SHIM"
chmod +x "$SHIM" 2>/dev/null || true
