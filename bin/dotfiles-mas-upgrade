#!/bin/bash
# dotfiles-mas-upgrade — upgrade Mac App Store apps, tolerating Xcode.
#
# WHY: `mas upgrade` (topgrade's built-in `mas` step) upgrades ALL outdated
# apps and FAILS the whole step if any single app fails. Xcode (App Store id
# 497799835) installs to /Applications/Xcode.app owned by root:wheel, so mas
# can't write its _MASReceipt and errors "Operation not permitted" — which
# fails every `dotfiles upgrade` whenever the App Store re-reports Xcode as
# outdated, even though Xcode is current and is best updated via `xcodes` or
# the App Store GUI. mas has no per-app exclude, so this wrapper upgrades each
# outdated app individually and SKIPS Xcode (soft warning), letting the step
# pass while still upgrading everything else (Tailscale, etc.).
#
# WHEN: replaces topgrade's built-in `mas` step — `mas` is in the `disable`
# list in dot_config/topgrade.toml.tmpl and this runs via the [commands] block.
#
# Some apps need sudo to upgrade (WhatsApp, id 310633997: "sudo: a terminal is
# required to read the password"). A LaunchAgent has no tty, so such an
# upgrade always fails. Two guards keep the step green:
#   1. DOTFILES_MAS_SKIP_IDS: space- or comma-separated App Store ids never
#      upgraded here. Default: 310633997 (WhatsApp; the owner chose to skip
#      it). Set it to "" to skip nothing extra. Company plugins add ids
#      through the core option mas.skip_ids (config/plugin-options.yaml).
#   2. Any other upgrade that fails with a sudo password prompt is reported as
#      "skipped (needs sudo)", not as a failure: no unattended run can pass it.
#      Other failures still fail the step.
#
# Env (for tests): MAS_BIN overrides the mas binary; XCODE_MAS_ID overrides
# the skipped Xcode id.

set -uo pipefail

MAS_BIN="${MAS_BIN:-mas}"
XCODE_MAS_ID="${XCODE_MAS_ID:-497799835}"
DOTFILES_MAS_SKIP_IDS="${DOTFILES_MAS_SKIP_IDS-310633997}"
skip_ids=" ${DOTFILES_MAS_SKIP_IDS//,/ } "
# Company plugins add ids through the core option mas.skip_ids (issue #145).
_dotfiles_dir="$(cd "$(dirname "$0")/.." && pwd)"
if [ -f "$_dotfiles_dir/lib/plugin-extensions.sh" ] && command -v yq >/dev/null 2>&1; then
  for _plib in plugin plugin-capabilities plugin-extensions; do
    # shellcheck source=/dev/null
    source "$_dotfiles_dir/lib/$_plib.sh"
  done
  skip_ids="$skip_ids$(plugin_option mas.skip_ids 2>/dev/null | tr '\n' ' ')"
fi
export MAS_NO_AUTO_INDEX=1   # suppress mas's Spotlight auto-reindex warning noise

if ! command -v "$MAS_BIN" >/dev/null 2>&1; then
  echo "⚠ mas not installed — skipping App Store upgrades"
  exit 0
fi

# `mas outdated` lines look like: "497799835 Xcode (26.4 -> 26.5)". Take the
# first field of lines whose first field is a numeric app id — this skips the
# "Warning: ... not indexed in Spotlight" noise mas prints to stdout.
ids="$("$MAS_BIN" outdated 2>/dev/null | awk '$1 ~ /^[0-9]+$/ {print $1}')"

if [ -z "$ids" ]; then
  echo "✓ App Store: nothing outdated"
  exit 0
fi

upgraded=0
skipped_xcode=0
needs_sudo=()
rc=0
out_file="$(mktemp "${TMPDIR:-/tmp}/dotfiles-mas-upgrade.XXXXXX")"
trap 'rm -f "$out_file"' EXIT
for id in $ids; do
  if [ "$id" = "$XCODE_MAS_ID" ]; then
    echo "⏭  Skipping Xcode (id $id) — update via 'xcodes' or the App Store GUI;"
    echo "    'mas upgrade' can't write Xcode.app's root-owned _MASReceipt."
    skipped_xcode=1
    continue
  fi
  if [[ "$skip_ids" == *" $id "* ]]; then
    echo "⏭  Skipping App Store app (id $id): listed in DOTFILES_MAS_SKIP_IDS."
    continue
  fi
  echo "→ Upgrading App Store app (id $id)..."
  if "$MAS_BIN" upgrade "$id" 2>&1 | tee "$out_file"; [ "${PIPESTATUS[0]}" -eq 0 ]; then
    upgraded=$((upgraded + 1))
  elif grep -qE '^sudo: (a terminal is required|a password is required)' "$out_file"; then
    echo "⏭  Skipped App Store app (id $id): the upgrade needs sudo. Run 'mas upgrade $id' in a terminal, or add $id to DOTFILES_MAS_SKIP_IDS."
    needs_sudo+=("$id")
  else
    echo "✗ Failed to upgrade App Store app (id $id)"
    rc=1
  fi
done

echo "✓ App Store: upgraded $upgraded app(s); Xcode skipped: $skipped_xcode${needs_sudo[0]:+; skipped (needs sudo): ${needs_sudo[*]}}"
exit "$rc"
