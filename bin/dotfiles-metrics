#!/bin/bash
# dotfiles-metrics — one local report of how the tooling behaves on this Mac:
# agent tool time, hook blocks and MCP health (from `agentbrew metrics`), plus
# machine load (dotfiles-load-sampler) and automation runs (dotfiles-stats).
# Nothing is uploaded.
#
# Usage:
#   dotfiles metrics [--days N] [--share FILE]
#   dotfiles metrics --table
#   dotfiles metrics --baseline
#
# Flags:
#   --days N      Window in days (default: 7).
#   --share FILE  Write an aggregate-only Markdown snapshot to FILE, to attach
#                 to an issue or PR. No project names, paths, or prompts.
#   --table       Run every command in docs/metrics.md and print each metric
#                 with its value, goal, and pivot. A failing command prints
#                 (stub), never a made-up 0.
#   --baseline    Print zsh start median, free disk, and LaunchAgent count:
#                 the same lines `dotfiles-install plan` shows before install.
#   --help, -h    Print this message.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
AGENTBREW="${DOTFILES_AGENTBREW_BIN:-$DOTFILES_DIR/bin/agentbrew}"
SAMPLER="${DOTFILES_LOAD_SAMPLER_BIN:-$DOTFILES_DIR/bin/dotfiles-load-sampler}"

days=7
share=""
table=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --days) days="${2:-7}"; shift 2 ;;
    --share) share="${2:-}"; [ -n "$share" ] || { echo "dotfiles metrics: --share needs a file" >&2; exit 2; }; shift 2 ;;
    --table) table=1; shift ;;
    --baseline)
      # shellcheck source=../lib/mac-baseline.sh
      source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)/lib/mac-baseline.sh"
      baseline_report ""; exit 0 ;;
    --help|-h) sed -n '2,22p' "$0" | sed -E 's/^# ?//'; exit 0 ;;
    *) echo "dotfiles metrics: unknown flag $1" >&2; exit 2 ;;
  esac
done
case "$days" in '' | *[!0-9]*) echo "dotfiles metrics: --days needs a number" >&2; exit 2 ;; esac
hours=$((days * 24))

# Rows of the "## Metrics" table in docs/metrics.md, one per line, with the
# cells joined by a tab. "\|" inside a cell is a literal pipe.
metric_rows() {
  awk '
    /^## / { on = ($0 == "## Metrics"); next }
    on && /^\| / && !/^\| *Metric *\|/ && !/^\|[-| ]+\|$/ {
      line = $0
      gsub(/\\\|/, "\001", line)
      n = split(line, c, "|")
      out = ""
      for (i = 2; i < n; i++) {
        cell = c[i]
        gsub(/^ +| +$/, "", cell)
        gsub(/\001/, "|", cell)
        out = out (i > 2 ? "\t" : "") cell
      }
      print out
    }' "$1"
}

# The command is the first backtick span of the Command cell.
metric_value() {
  local cmd value
  cmd="$(printf '%s' "$1" | sed -nE 's/^`([^`]*)`.*/\1/p')"
  [ -n "$cmd" ] || { echo "(stub)"; return; }
  if value="$(cd "$DOTFILES_DIR" && bash -o pipefail -c "$cmd" 2>/dev/null | tail -1)" \
      && printf '%s' "$value" | grep -qE '^-?[0-9]+(\.[0-9]+)?$'; then
    echo "$value"
  else
    echo "(stub)"
  fi
}

if [ "$table" = 1 ]; then
  file="${DOTFILES_METRICS_FILE:-$DOTFILES_DIR/docs/metrics.md}"
  [ -f "$file" ] || { echo "dotfiles metrics: $file not found" >&2; exit 1; }
  printf '%-8s | %-10s | %s\n' "Now" "Story" "Metric (goal; pivot)"
  metric_rows "$file" | while IFS="$(printf '\t')" read -r name goal pivot command story; do
    printf '%-8s | %-10s | %s (goal %s; pivot %s)\n' "$(metric_value "$command")" "$story" "$name" "$goal" "$pivot"
  done
  exit 0
fi

# The full load report names the top processes; the shared one keeps only
# the numeric lines.
load_report() {
  [ -x "$SAMPLER" ] || { echo "no load samples (dotfiles-load-sampler missing)"; return; }
  "$SAMPLER" --report "$hours" 2>/dev/null || echo "no load samples yet"
}
load_summary() {
  load_report | grep -E '^(last|overload|peak CPU|no load)' || true
}

if [ -n "$share" ]; then
  {
    if "$AGENTBREW" metrics --days "$days" --share 2>/dev/null | sed -n '/^## agentbrew metrics/,$p'; then :; fi
    printf '\n### Machine load (%s days)\n\n' "$days"
    load_summary | sed 's/^/- /'
  } > "$share"
  echo "Wrote $share. Review it, then attach it to an issue or PR."
  exit 0
fi

if ! "$AGENTBREW" metrics --days "$days" 2>/dev/null | grep -v '^⚡'; then
  echo "agentbrew metrics: not available (install agentbrew to see agent time and hooks)"
fi
printf '\nMachine load (last %s days)\n' "$days"
load_report | sed 's/^/  /'
if [ -x "$DOTFILES_DIR/bin/dotfiles-stats" ]; then
  printf '\nAutomation runs\n'
  bash "$DOTFILES_DIR/bin/dotfiles-stats" 2>/dev/null | sed -n '/Last 7 days/p' | sed 's/^ */  /'
fi
