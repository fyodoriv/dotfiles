#!/bin/bash
# Company plugin manager (issue #145; docs/plugins.md). `dotfiles plugin`
# dispatches here.
#
# Usage:
#   dotfiles plugin add <git-url>@<tag> [--signer <key>] [--yes]
#                                                 clone, check the signed tag,
#                                                 validate, approve, lock
#   dotfiles plugin add --dev <path> [--yes]      link a local checkout (no pin)
#   dotfiles plugin update <name> [<tag>] [--yes]
#                                                 move to another signed tag (the
#                                                 newest newer one when omitted);
#                                                 swap and re-lock only after checks
#   dotfiles plugin remove <name> [--yes]         delete checkout and lock entry
#   dotfiles plugin list                          name, ref, commit, state
#   dotfiles plugin verify [<name>]               re-check the lock against disk
#   dotfiles plugin options                       effective core option values
#   dotfiles plugin lint <name>                   exported secrets, unpinned packages
#   dotfiles plugin new <name> [<dir>]            scaffold a plugin repo (manifest,
#                                                 .gitignore, tests, CI workflow)
#   dotfiles plugin migrate <v1 overlay dir>      write a draft manifest; list
#                                                 files it could not map
#   dotfiles plugin trust <name> --signer <key> [--revoke] [--yes]
#                                                 add or remove a trusted signer
#
# `add` runs no plugin code. It pins the commit, the HEAD tree hash, and a
# hash of the approved capabilities in plugins.lock (see lib/plugin.sh).
# A release tag must be an annotated tag signed with an SSH key that the
# shared allowed-signers file trusts for the plugin name (lib/plugin-signers.sh).

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/plugin.sh
source "$DOTFILES_DIR/lib/plugin.sh"
# shellcheck source=../lib/confirm.sh
source "$DOTFILES_DIR/lib/confirm.sh"

die() { echo "dotfiles plugin: $*" >&2; exit 1; }

usage() { sed -n '/^#!/d; /^$/q; /^set /q; s/^# \{0,1\}//p' "$0"; }

command -v yq >/dev/null 2>&1 || die "yq is required (brew install yq)"
command -v jq >/dev/null 2>&1 || die "jq is required (brew install jq)"

# Prints the capability block for a person to approve.
show_capabilities() {
  echo "Capabilities requested by plugin $1:"
  yq -P '.capabilities // {}' "$2" | sed 's/^/  /'
}

# Asks once (lib/confirm.sh). --yes approves without a prompt; no terminal
# and no --yes refuses.
approve() {
  confirm_yes "$1" "installs, changes, or trusts code that runs on this machine" \
    "dotfiles plugin: approval needed: rerun in a terminal, or pass --yes after reading the capabilities"
}

# The lock's temp file while a write is in flight (script scope: one
# dotfiles-plugin run); exit handlers delete it.
LOCK_TMP=""

# _lock_yq <expression>: applies a yq expression to plugins.lock in one
# rename. The new lock is written to a 0600 temp file in the same folder,
# so a reader or an interrupt sees the old lock or the new one, never half.
_lock_yq() {
  local lock
  lock="$(plugin_lock_file)"
  mkdir -p "$(dirname "$lock")" || return 1
  (umask 077; [ -f "$lock" ] || printf 'plugins: {}\n' > "$lock") || return 1
  LOCK_TMP="$(mktemp "$lock.tmp.XXXXXX")" || { LOCK_TMP=""; return 1; }
  if yq "$1" "$lock" > "$LOCK_TMP" && chmod 600 "$LOCK_TMP" && mv -f "$LOCK_TMP" "$lock"; then
    LOCK_TMP=""
    return 0
  fi
  rm -f "$LOCK_TMP"
  LOCK_TMP=""
  return 1
}

lock_write_entry() {
  N="$1" _lock_yq '.plugins[strenv(N)] = {
      "source": strenv(SRC), "ref": strenv(REF), "version": strenv(VER),
      "commit": strenv(COMMIT), "tree_hash": strenv(TREE),
      "capabilities_sha": strenv(CAPS), "signer": strenv(SIGNER), "path": strenv(DEST),
      "dev": (strenv(DEV) == "true"), "locked_at": strenv(AT)}'
}

# Regenerates outputs that follow the lock (shell fragment loader).
refresh_outputs() {
  # shellcheck source=../lib/plugin-capabilities.sh
  source "$DOTFILES_DIR/lib/plugin-capabilities.sh"
  # shellcheck source=../lib/plugin-extensions.sh
  source "$DOTFILES_DIR/lib/plugin-extensions.sh"
  plugin_shell_pass || true
}

cmd_add() {
  local yes=0 dev=0 spec="" url ref manifest name dest errors signer="" new_signer="" key
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes) yes=1 ;;
      --dev) dev=1 ;;
      --signer) shift; new_signer="${1:-}" ;;
      -*) die "unknown flag: $1" ;;
      *) spec="$1" ;;
    esac
    shift
  done
  [ -n "$spec" ] || die "usage: dotfiles plugin add <git-url>@<ref> | --dev <path>"

  if [ "$dev" = 1 ]; then
    dest="$(cd "$spec" 2>/dev/null && pwd -P)" || die "no such folder: $spec"
    manifest="$dest/dotfiles-plugin.yaml"
    url="$dest" ref="dev"
  else
    url="${spec%@*}" ref="${spec##*@}"
    case "$ref" in "" | */* | *:*) ref="" ;; esac
    [ "$url" != "$spec" ] && [ -n "$ref" ] || die "pin a ref: dotfiles plugin add <git-url>@<tag>"
    mkdir -p "$(plugin_home)"
    STAGING="$(mktemp -d "$(plugin_home)/.staging.XXXXXX")"
    trap 'rm -rf "${STAGING:-}"; rm -f "${LOCK_TMP:-}"' EXIT
    git clone --quiet --no-checkout -- "$url" "$STAGING/src" || die "clone failed: $url"
    # The exact tag ref: a branch with the same name never wins.
    git -C "$STAGING/src" -c advice.detachedHead=false checkout --quiet --detach "refs/tags/$ref" 2>/dev/null ||
      die "ref not found: $ref"
    manifest="$STAGING/src/dotfiles-plugin.yaml"
  fi

  errors="$(plugin_validate_manifest "$manifest")" || die "invalid manifest:"$'\n'"$errors"
  # shellcheck source=../lib/plugin-capabilities.sh
  source "$DOTFILES_DIR/lib/plugin-capabilities.sh"
  # shellcheck source=../lib/plugin-extensions.sh
  source "$DOTFILES_DIR/lib/plugin-extensions.sh"
  errors="$(plugin_validate_options "$manifest")" || die "invalid manifest:"$'\n'"$errors"
  name="$(yq -r '.name' "$manifest")"
  [ -z "$(plugin_lock_get "$name" path 2>/dev/null)" ] ||
    die "plugin $name is already installed; remove it first"

  if [ "$dev" = 0 ]; then
    if [ -n "$new_signer" ]; then
      key="$(plugin_normalize_key "$new_signer")" || die "--signer is not an SSH public key"
      signer="$(plugin_verify_signed_tag "$STAGING/src" "$ref" "$name" "$key")" || die "$signer"
    else
      signer="$(plugin_verify_signed_tag "$STAGING/src" "$ref" "$name")" || die "$signer"
    fi
    _checkout_is_tag "$STAGING/src" "$ref"
  fi

  echo "Source: $url"
  [ "$dev" = 1 ] || echo "Ref:    $ref ($(git -C "$STAGING/src" rev-parse HEAD))"
  [ "$dev" = 0 ] || echo "Dev:    yes (not pinned; doctor warns on every run)"
  [ -z "$signer" ] || echo "Signer: $signer"
  if [ -n "$signer" ] && ! plugin_signers_for "$name" | grep -qxF -- "$signer"; then
    echo "        (new signer: approving also trusts it for plugin $name)"
  fi
  show_capabilities "$name" "$manifest"
  approve "$yes"
  [ -z "$signer" ] || plugin_trust_signer "$name" "$signer"

  if [ "$dev" = 0 ]; then
    dest="$(plugin_home)/$name"
    [ ! -e "$dest" ] || die "folder already exists: $dest"
    mv "$STAGING/src" "$dest"
  fi

  SRC="$url" REF="$ref" VER="$(yq -r '.version' "$dest/dotfiles-plugin.yaml")" \
  COMMIT="$(git -C "$dest" rev-parse HEAD 2>/dev/null || true)" \
  TREE="$(git -C "$dest" rev-parse 'HEAD^{tree}' 2>/dev/null || true)" \
  CAPS="$(plugin_capabilities_sha "$dest/dotfiles-plugin.yaml")" \
  SIGNER="$signer" DEST="$dest" DEV="$([ "$dev" = 1 ] && echo true || echo false)" \
  AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    lock_write_entry "$name"
  refresh_outputs
  echo "✓ Installed plugin $name at $dest"
}

# A version tag: [v]MAJOR.MINOR.PATCH[-pre-release][+build] (semver.org).
SEMVER_RE='^v?(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-([0-9A-Za-z.-]+))?(\+[0-9A-Za-z.-]+)?$'
# A stable release: [v]MAJOR.MINOR.PATCH, nothing after it.
STABLE_RE='^v?(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'

# _num_cmp <a> <b>: prints -1, 0 or 1 for two digit strings of any length.
_num_cmp() {
  local a="$1" b="$2"
  if [ "${#a}" -ne "${#b}" ]; then
    [ "${#a}" -lt "${#b}" ] && echo -1 || echo 1
  elif [ "$a" = "$b" ]; then echo 0
  elif [[ "$a" < "$b" ]]; then echo -1
  else echo 1; fi
}

# _semver_cmp <a> <b>: prints -1, 0 or 1 by semver.org precedence (build
# metadata ignored). Prints nothing and fails when either is not a version.
_semver_cmp() {
  local LC_ALL=C a b i c x y
  local -a pa pb
  [[ "$1" =~ $SEMVER_RE ]] || return 1
  a="${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]}"; pa=("${BASH_REMATCH[5]}")
  [[ "$2" =~ $SEMVER_RE ]] || return 1
  b="${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]}"; pb=("${BASH_REMATCH[5]}")
  read -r -a x <<< "$a"
  read -r -a y <<< "$b"
  for i in 0 1 2; do
    c="$(_num_cmp "${x[i]}" "${y[i]}")"
    [ "$c" = 0 ] || { echo "$c"; return 0; }
  done
  # A release outranks its pre-releases; pre-releases compare field by field.
  if [ -z "${pa[0]}" ] || [ -z "${pb[0]}" ]; then
    if [ -z "${pa[0]}" ] && [ -z "${pb[0]}" ]; then echo 0
    elif [ -z "${pa[0]}" ]; then echo 1
    else echo -1; fi
    return 0
  fi
  IFS=. read -r -a x <<< "${pa[0]}"
  IFS=. read -r -a y <<< "${pb[0]}"
  for ((i = 0; ; i++)); do
    if [ "$i" -ge "${#x[@]}" ] || [ "$i" -ge "${#y[@]}" ]; then
      _num_cmp "${#x[@]}" "${#y[@]}"
      return 0
    fi
    if [[ "${x[i]}" =~ ^[0-9]+$ ]] && [[ "${y[i]}" =~ ^[0-9]+$ ]]; then c="$(_num_cmp "${x[i]}" "${y[i]}")"
    elif [[ "${x[i]}" =~ ^[0-9]+$ ]]; then c=-1
    elif [[ "${y[i]}" =~ ^[0-9]+$ ]]; then c=1
    elif [ "${x[i]}" = "${y[i]}" ]; then c=0
    elif [[ "${x[i]}" < "${y[i]}" ]]; then c=-1
    else c=1; fi
    [ "$c" = 0 ] || { echo "$c"; return 0; }
  done
}

# _newer_stable_tags <dir> <installed ref>: stable release tags newer than
# the installed ref, newest first. Pre-releases and other names never count.
_newer_stable_tags() {
  local tag
  git -C "$1" tag -l | while IFS= read -r tag; do
    [[ "$tag" =~ $STABLE_RE ]] || continue
    printf '%s %s %s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "$tag"
  done | sort -k1,1nr -k2,2nr -k3,3nr | while read -r _ _ _ tag; do
    [ "$(_semver_cmp "$tag" "$2")" = 1 ] && printf '%s\n' "$tag"
  done
  return 0
}

# _checkout_is_tag <dir> <ref>: dies unless HEAD is the commit of the
# exact tag object that plugin_verify_signed_tag checked.
_checkout_is_tag() {
  local oid
  oid="$(plugin_tag_object "$1" "$2")" || die "$oid"
  [ "$(git -C "$1" rev-parse HEAD)" = "$(git -C "$1" rev-parse "$oid^{commit}")" ] ||
    die "the checkout is not the commit of the signed tag $2"
}

# Update run state for _update_cleanup (script scope: one cmd_update run).
UPD_STAGING="" UPD_PATH="" UPD_LOCK="" UPD_HAD_OLD=0 UPD_SWAPPING=0 UPD_DONE=0

# _update_signal <status>: INT and TERM end the update through the cleanup.
_update_signal() {
  echo "dotfiles plugin: interrupted; the update stops and the installed version stays" >&2
  exit "$1"
}

# Runs once when cmd_update exits for any reason, INT and TERM included.
# While the swap is not finished, it puts the old checkout and the old lock
# back. It deletes only the staging folder this run made, and keeps it when
# it still holds the old checkout or lock.
_update_cleanup() {
  trap '' INT TERM
  trap - EXIT
  [ -z "$LOCK_TMP" ] || rm -f "$LOCK_TMP"
  [ -n "$UPD_STAGING" ] || return 0
  if [ "$UPD_SWAPPING" = 1 ] && [ "$UPD_DONE" != 1 ]; then
    if [ -e "$UPD_STAGING/old" ]; then
      [ ! -e "$UPD_PATH" ] || mv "$UPD_PATH" "$UPD_STAGING/new" || true
      mv "$UPD_STAGING/old" "$UPD_PATH" || true
    elif [ "$UPD_HAD_OLD" = 0 ] && [ -e "$UPD_PATH" ] && [ ! -e "$UPD_STAGING/src" ]; then
      mv "$UPD_PATH" "$UPD_STAGING/new" || true
    fi
    if ! cmp -s "$UPD_STAGING/plugins.lock.before" "$UPD_LOCK"; then
      if ! { cp "$UPD_STAGING/plugins.lock.before" "$UPD_LOCK.restore.$$" 2>/dev/null &&
          chmod 600 "$UPD_LOCK.restore.$$" && mv -f "$UPD_LOCK.restore.$$" "$UPD_LOCK"; }; then
        rm -f "$UPD_LOCK.restore.$$"
      fi
    fi
  fi
  if [ "$UPD_SWAPPING" = 1 ] && [ "$UPD_DONE" != 1 ] &&
    { [ -e "$UPD_STAGING/old" ] || ! cmp -s "$UPD_STAGING/plugins.lock.before" "$UPD_LOCK"; }; then
    echo "dotfiles plugin: could not restore everything; the old checkout and lock are in $UPD_STAGING" >&2
    return 0
  fi
  case "$(basename "$UPD_STAGING")" in .staging.*) rm -rf "$UPD_STAGING" ;; esac
}

# Moves an installed plugin to another signed tag (issue #265). The new tag
# is cloned and checked beside the current checkout: a tag name (never an
# object ID), signed by a trusted signer, valid manifest and options, same
# plugin name. Without a tag it takes the newest stable release newer than
# the installed one. Changed capabilities need approval again. Only then
# the checkouts swap and the lock is rewritten; until the new checkout
# passes plugin_verify, any failure or interrupt puts the old checkout and
# lock back (_update_cleanup). No plugin code runs.
cmd_update() {
  local yes=0 name="" ref="" path url cur_ref cur_commit manifest errors="" signer="" tag lock new_commit oid order
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes) yes=1 ;;
      -*) die "unknown flag: $1" ;;
      *)
        if [ -z "$name" ]; then name="$1"
        elif [ -z "$ref" ]; then ref="$1"
        else die "usage: dotfiles plugin update <name> [<tag>] [--yes]"; fi ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: dotfiles plugin update <name> [<tag>] [--yes]"
  path="$(plugin_lock_get "$name" path)"
  [ -n "$path" ] || die "plugin $name is not installed"
  [ "$(plugin_lock_get "$name" dev)" != true ] ||
    die "plugin $name is a dev checkout; update it with git in $path"
  case "$ref" in */* | *:*) die "not a tag: $ref" ;; esac
  url="$(plugin_lock_get "$name" source)"
  cur_ref="$(plugin_lock_get "$name" ref)"
  cur_commit="$(plugin_lock_get "$name" commit)"
  if [ -z "$ref" ] && ! [[ "$cur_ref" =~ $SEMVER_RE ]]; then
    die "the installed ref $cur_ref is not a version, so no tag counts as newer; name one: dotfiles plugin update $name <tag>"
  fi

  mkdir -p "$(dirname "$path")"
  UPD_STAGING="$(mktemp -d "$(dirname "$path")/.staging.XXXXXX")"
  UPD_PATH="$path"
  UPD_LOCK="$(plugin_lock_file)"
  trap _update_cleanup EXIT
  trap '_update_signal 130' INT
  trap '_update_signal 143' TERM
  git clone --quiet --no-checkout -- "$url" "$UPD_STAGING/src" || die "clone failed: $url"

  if [ -z "$ref" ]; then
    # Newest stable release first; take the first a trusted signer signed.
    while IFS= read -r tag; do
      if signer="$(plugin_verify_signed_tag "$UPD_STAGING/src" "$tag" "$name")"; then
        ref="$tag"
        break
      fi
      echo "skipped $tag: $signer"
      signer=""
    done < <(_newer_stable_tags "$UPD_STAGING/src" "$cur_ref")
    if [ -z "$ref" ]; then
      echo "✓ Plugin $name is up to date at $cur_ref (no newer signed release)"
      return 0
    fi
  else
    signer="$(plugin_verify_signed_tag "$UPD_STAGING/src" "$ref" "$name")" || die "$signer"
  fi
  # Check out the exact tag object that was verified, and prove it.
  oid="$(plugin_tag_object "$UPD_STAGING/src" "$ref")" || die "$oid"
  git -C "$UPD_STAGING/src" -c advice.detachedHead=false checkout --quiet --detach "$oid" 2>/dev/null ||
    die "ref not found: $ref"
  _checkout_is_tag "$UPD_STAGING/src" "$ref"
  new_commit="$(git -C "$UPD_STAGING/src" rev-parse HEAD)"
  if [ "$ref" = "$cur_ref" ] && [ "$new_commit" = "$cur_commit" ] && plugin_verify "$name" >/dev/null 2>&1; then
    echo "✓ Plugin $name is already at $ref"
    return 0
  fi

  manifest="$UPD_STAGING/src/dotfiles-plugin.yaml"
  errors="$(plugin_validate_manifest "$manifest")" || die "invalid manifest:"$'\n'"$errors"
  # shellcheck source=../lib/plugin-capabilities.sh
  source "$DOTFILES_DIR/lib/plugin-capabilities.sh"
  # shellcheck source=../lib/plugin-extensions.sh
  source "$DOTFILES_DIR/lib/plugin-extensions.sh"
  errors="$(plugin_validate_options "$manifest")" || die "invalid manifest:"$'\n'"$errors"
  [ "$(yq -r '.name' "$manifest")" = "$name" ] ||
    die "the manifest at $ref names plugin $(yq -r '.name' "$manifest"), not $name"

  echo "Source: $url"
  echo "Update: $cur_ref → $ref ($new_commit)"
  if [ "$ref" != "$cur_ref" ]; then
    order="$(_semver_cmp "$ref" "$cur_ref" || true)"
    case "$order" in
      1) ;;
      0) echo "        (same version as $cur_ref)" ;;
      -1) echo "        (downgrade: $ref is older than $cur_ref)" ;;
      *) echo "        (not both versions: cannot tell whether $ref is newer than $cur_ref)" ;;
    esac
  fi
  echo "Signer: $signer"
  if [ "$(plugin_capabilities_sha "$manifest")" = "$(plugin_lock_get "$name" capabilities_sha)" ]; then
    echo "Capabilities: unchanged since you approved $cur_ref"
  else
    echo "Capabilities changed since you approved $cur_ref."
    show_capabilities "$name" "$manifest"
    approve "$yes"
  fi

  # Swap. The old checkout and lock wait in staging until the new one verifies.
  lock="$UPD_LOCK"
  cp -p "$lock" "$UPD_STAGING/plugins.lock.before"
  [ ! -e "$path" ] || UPD_HAD_OLD=1
  UPD_SWAPPING=1
  if [ "$UPD_HAD_OLD" = 1 ]; then
    mv "$path" "$UPD_STAGING/old" || die "could not move $path aside; $name stays at $cur_ref"
  fi
  mv "$UPD_STAGING/src" "$path" || die "could not move the new checkout into place; $name stays at $cur_ref"
  if ! SRC="$url" REF="$ref" VER="$(yq -r '.version' "$path/dotfiles-plugin.yaml")" \
      COMMIT="$new_commit" TREE="$(git -C "$path" rev-parse 'HEAD^{tree}')" \
      CAPS="$(plugin_capabilities_sha "$path/dotfiles-plugin.yaml")" \
      SIGNER="$signer" DEST="$path" DEV=false AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      lock_write_entry "$name" 2>/dev/null ||
    ! errors="$(plugin_verify "$name" 2>&1)"; then
    die "the new checkout failed its check, so $name stays at $cur_ref${errors:+:$'\n'$errors}"
  fi
  UPD_DONE=1
  refresh_outputs
  echo "✓ Updated plugin $name: $cur_ref → $ref"
  echo "  Run dotfiles apply to load its LaunchAgents, Brewfile, and Agentfile."
}

cmd_remove() {
  local name="" yes=0 path
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes) yes=1 ;;
      -*) die "unknown flag: $1" ;;
      *) name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: dotfiles plugin remove <name> [--yes]"
  path="$(plugin_lock_get "$name" path)"
  [ -n "$path" ] || die "plugin $name is not installed"
  confirm_yes "$yes" "deletes plugin $name: its checkout, its lock entry, and its LaunchAgents"
  # shellcheck source=../lib/plugin-capabilities.sh
  source "$DOTFILES_DIR/lib/plugin-capabilities.sh"
  # shellcheck source=../lib/plugin-extensions.sh
  source "$DOTFILES_DIR/lib/plugin-extensions.sh"
  plugin_launchagents_remove "$name"
  if [ "$(plugin_lock_get "$name" dev)" != true ] && [ "$path" = "$(plugin_home)/$name" ]; then
    rm -rf "$path"
  fi
  N="$name" _lock_yq 'del(.plugins[strenv(N)])'
  refresh_outputs
  echo "✓ Removed plugin $name"
}

cmd_trust() {
  local name="" key="" revoke=0 yes=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --signer) shift; key="${1:-}" ;;
      --revoke) revoke=1 ;;
      --yes) yes=1 ;;
      -*) die "unknown flag: $1" ;;
      *) name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] && [ -n "$key" ] || die "usage: dotfiles plugin trust <name> --signer <key> [--revoke]"
  key="$(plugin_normalize_key "$key")" || die "--signer is not an SSH public key"
  if [ "$revoke" = 1 ]; then
    plugin_revoke_signer "$name" "$key" || exit 1
    echo "✓ Revoked signer for $name. A plugin signed by it is now disabled."
    return 0
  fi
  echo "Trust this key to sign releases of plugin $name?"
  echo "  $key"
  echo "  fingerprint $(_plugin_key_fingerprint "$key")"
  approve "$yes"
  plugin_trust_signer "$name" "$key"
  echo "✓ Trusted signer for $name in $(plugin_signers_file)"
}

cmd_new() {
  local name="${1:-}" dir tmpl
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || die "usage: dotfiles plugin new <name> [<dir>] (name: a-z, 0-9, -)"
  dir="${2:-dotfiles-$name}"
  [ ! -e "$dir" ] || die "already exists: $dir"
  tmpl="$DOTFILES_DIR/data/plugin-template"
  mkdir -p "$dir"
  cp -R "$tmpl/." "$dir/"
  mv "$dir/gitignore" "$dir/.gitignore"
  find "$dir" -type f \( -name '*.yaml' -o -name '*.md' \) -exec sed -i.bak "s/@NAME@/$name/g" {} \; -exec rm -f {}.bak \;
  git -C "$dir" init -q 2>/dev/null || true
  echo "✓ Created plugin $name in $dir"
  echo "  Next: edit dotfiles-plugin.yaml, run its tests (DOTFILES_CORE=$DOTFILES_DIR bats $dir/tests),"
  echo "  then release a signed tag and run: dotfiles plugin add <git-url>@<tag>"
}

cmd_migrate() {
  local src="${1:-}" draft hooks unmapped f
  [ -d "$src" ] || die "usage: dotfiles plugin migrate <v1 overlay dir>"
  src="$(cd "$src" && pwd -P)"
  draft="$src/dotfiles-plugin.yaml.draft"
  hooks="$(find "$src/hooks" -maxdepth 1 -type f -perm -111 -exec basename {} \; 2>/dev/null | sort | paste -sd, -)"
  {
    echo "schema: 1"
    echo "name: $(basename "$src" | sed 's/^dotfiles-//' | tr '[:upper:]_' '[:lower:]-')"
    echo "version: 0.1.0"
    echo "capabilities:"
    echo "  sudo: false"
    [ -z "$hooks" ] || echo "  hooks: [$hooks]"
    [ ! -f "$src/brewfile/Brewfile" ] || echo "  brew: {taps: [$(sed -nE 's/^[[:space:]]*tap[[:space:]]+"([^"]+)".*/\1/p' "$src/brewfile/Brewfile" | paste -sd, -)], casks: $(grep -qE '^[[:space:]]*cask ' "$src/brewfile/Brewfile" && echo true || echo false)}"
    echo "contributes:"
    [ ! -d "$src/modules" ] || echo "  doctor_modules: modules"
    [ ! -d "$src/validate" ] || echo "  validate: validate"
    [ ! -f "$src/brewfile/Brewfile" ] || echo "  brewfile: brewfile/Brewfile"
    [ ! -d "$src/hooks" ] || echo "  hooks: hooks"
    [ ! -f "$src/vscode/settings.json" ] || echo "  settings: {vscode: vscode/settings.json}"
    [ ! -f "$src/Agentfile.yaml" ] || echo "  agentbrew: ."
  } > "$draft"
  echo "✓ Wrote $draft (nothing else changed)"
  unmapped="$(cd "$src" && git ls-files 2>/dev/null || find . -type f | sed 's|^\./||')"
  echo "Files the draft does not cover (map them by hand, or move the logic into a core option):"
  while IFS= read -r f; do
    case "$f" in
      modules/* | validate/* | brewfile/Brewfile | hooks/* | vscode/settings.json | Agentfile.yaml | oss-readiness.env | dotfiles-plugin.yaml* | README* | .gitignore) ;;
      *) echo "  $f" ;;
    esac
  done <<< "$unmapped"
  echo "Review the draft, rename it to dotfiles-plugin.yaml, release a signed tag, then: dotfiles plugin add <url>@<tag>"
}

cmd_list() {
  local name state
  for name in $(plugin_lock_names); do
    if plugin_verify "$name" >/dev/null 2>&1; then state=ok; else state=DISABLED; fi
    [ "$(plugin_lock_get "$name" dev)" != true ] || state="$state (dev)"
    printf '%s\t%s\t%.12s\t%s\n' "$name" "$(plugin_lock_get "$name" ref)" \
      "$(plugin_lock_get "$name" commit)" "$state"
  done
}

cmd_verify() {
  local name failed=0
  for name in ${1:-$(plugin_lock_names)}; do
    plugin_verify "$name" || failed=1
  done
  return "$failed"
}

case "${1:-}" in
  add) shift; cmd_add "$@" ;;
  update) shift; cmd_update "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  list) cmd_list ;;
  verify) shift; cmd_verify "$@" ;;
  trust) shift; cmd_trust "$@" ;;
  new) shift; cmd_new "$@" ;;
  migrate) shift; cmd_migrate "$@" ;;
  lint)
    shift
    # shellcheck source=../lib/plugin-capabilities.sh
    source "$DOTFILES_DIR/lib/plugin-capabilities.sh"
    # shellcheck source=../lib/plugin-extensions.sh
    source "$DOTFILES_DIR/lib/plugin-extensions.sh"
    _lint_path="$(plugin_lock_get "${1:-}" path)"
    [ -n "$_lint_path" ] || die "usage: dotfiles plugin lint <installed name>"
    plugin_lint "$_lint_path" ;;
  options)
    # shellcheck source=../lib/plugin-capabilities.sh
    source "$DOTFILES_DIR/lib/plugin-capabilities.sh"
    # shellcheck source=../lib/plugin-extensions.sh
    source "$DOTFILES_DIR/lib/plugin-extensions.sh"
    plugin_options_report ;;
  -h | --help | help | "") usage ;;
  *) die "unknown command: $1" ;;
esac
