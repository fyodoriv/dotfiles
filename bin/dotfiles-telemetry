#!/bin/bash
# Anonymous performance telemetry to PostHog EU. Asked at install; on only
# after you say yes (at install, Enter counts as yes).
#
# Usage:
#   dotfiles telemetry status          Show on/off, why, your answer, the key
#                                      source, pending events, last send
#   dotfiles telemetry on | off        Record your answer: yes or no
#   dotfiles telemetry send [--dry-run]  Send pending events now; --dry-run prints
#                                      the exact request body (key hidden), sends nothing
#   dotfiles telemetry ask [--install] [--no]
#                                      Ask the question once, on a terminal.
#                                      --install is the installer's form: it also
#                                      honors the opt-outs and says what it did.
#                                      --no records no without asking.
#   dotfiles telemetry example         Show what is sent, one real event, and the
#                                      privacy promise; changes nothing
#   dotfiles telemetry daily           Send at most once a day (lib/stats.sh calls it)
#
# This script is the only sender. It reads two content-free local logs
# (lib/stats.sh): the stats log (~/.dotfiles-stats.jsonl, one line per
# automation run) and the commands log (~/.local/state/dotfiles/commands.jsonl,
# one line per `dotfiles <command>` run). A move to a self-hosted endpoint
# changes only this file. Same contract as agentbrew's core/telemetry.ts.
#
# What leaves the Mac, per log line: the event name (`dotfiles.run` or
# `dotfiles.command`), its time, the task or command name, ok, duration_ms,
# and count fields (seconds_saved, units, pass, fail, fixed, warn, skip).
# Added at send time: the dotfiles version (git short SHA), os, arch, and
# runtime "shell". All keyed by a random install id. Never a path, a file
# name, a host name, a user name, an argument, a message, or content. Every
# text value comes from a fixed list (TASK_NAMES, the dispatch arms of
# bin/dotfiles), so typed text cannot leave. Person profiles and GeoIP are
# off. PostHog receives the request IP address, like any web server; GeoIP
# lookup is disabled and no location is stored.
#
# Consent has three values: unset, yes, no. Nothing is sent unless it is yes.
# `bin/dotfiles-install run` asks on a terminal. With no terminal the answer
# stays unset, and the first `dotfiles` command on a terminal asks once; that
# question needs a typed y or n (a stray Enter is not a yes). Keys typed before
# the question shows are thrown away. A yes covers only later events: both
# cursors move to the end of the logs, so nothing recorded before it is sent.
# Opt out without a question: `dotfiles-install run --no-telemetry`,
# DOTFILES_TELEMETRY=0, or DO_NOT_TRACK=1 at install record no, also over an
# earlier yes. An answer is never asked again, and an install without one of
# these opt-outs never changes it.
#
# The key is write-only (it can add events, never read them). Lookup order:
# DOTFILES_POSTHOG_KEY, then the committed file config/telemetry-key, then
# the macOS Keychain item service "dotfiles", account "posthog_key". The
# Keychain is read only when the first two hold no key. A value that is not
# `phc_` plus letters and digits is no key. No key means nothing is sent.
#
# It sends only when all hold: the answer is yes, a key is found, and
# DO_NOT_TRACK, CI, and DOTFILES_TELEMETRY=0 are not set. A send never fails a
# command. The cursor moves only after the endpoint answers 2xx. One send
# takes at most the newest 2,000 events of the last 30 days per log, 500 per
# request; older events are skipped for good. The automatic daily send runs
# in the background and stops after 3 seconds in total; a request that hangs
# is killed. A `telemetry off` during a send stops it before the next request.
#
# Lifecycle: the install id, the answer and its day, the two cursors (log
# lines already handled), the last send day, and the last try time live in one
# file, ${XDG_STATE_HOME:-~/.local/state}/dotfiles/telemetry.json (mode 600,
# written with a temp file and a rename). Failures go to telemetry.log next
# to it. Delete the state file to reset: a new install id, the answer is unset
# again, and at most the capped newest events are sent after a new yes.
# A state file that cannot be read resets the same way (unset, never yes),
# and starts both cursors at the end of the logs, so nothing old is sent.
# A file from before the question (no answer in it) is unset; if it says
# telemetry was turned off, the answer is no.

set -uo pipefail
{ [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; } && { sed -n '/^#!/d; /^$/q; /^[^#]/q; /^# shellcheck/d; s/^# \{0,1\}//p' "$0"; exit 0; }

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
STATS="${DOTFILES_STATS_FILE:-$HOME/.dotfiles-stats.jsonl}"
COMMANDS="${DOTFILES_COMMANDS_FILE:-$STATE_DIR/commands.jsonl}"
STATE="${DOTFILES_TELEMETRY_STATE:-$STATE_DIR/telemetry.json}"
ERROR_LOG="${STATE%.json}.log"
LOCK="$STATE.lock"
KEY_FILE="${DOTFILES_TELEMETRY_KEY_FILE:-$DOTFILES_DIR/config/telemetry-key}"
URL="${DOTFILES_TELEMETRY_URL:-https://eu.i.posthog.com}"
URL="${URL%/}/batch/"
CURL="${DOTFILES_TELEMETRY_CURL:-curl}"
BATCH_SIZE=500       # events per request
MAX_EVENTS=2000      # newest events per log that one send may take
MAX_AGE_DAYS=30      # older events are never sent
AUTO_TIMEOUT=3       # seconds in total for one automatic daily send
MANUAL_TIMEOUT=10    # seconds per request for `telemetry send`
RETRY_SECONDS=3600   # the daily path tries at most once in this time
# Every task name a stats log line may carry (the log_run callers, the doctor,
# and the shell start timer). A line with another name sends no name.
# tests/telemetry.bats fails when a caller is missing here.
TASK_NAMES="app-priority audit cleanup doctor git-maintain hotfix install morning pr review shell-start sync upgrade"
PRIVACY_URL="https://github.com/fyodoriv/dotfiles/blob/feat/chezmoi/docs/observability.md#telemetry"

command -v jq >/dev/null 2>&1 || { echo "✗ jq is not installed. Fix: brew install jq" >&2; exit 1; }

today() { date -u +%F; }
line_count() { if [ -f "$1" ]; then wc -l <"$1" | tr -d ' '; else echo 0; fi; }

# ── State ───────────────────────────────────────────────────────────────
# Script-scope copies of the state file fields. load_state fills them;
# state_set changes some and writes the file.
S_ID="" S_SENT=0 S_SENT_COMMANDS=0 S_CONSENT=unset S_CONSENT_AT="" S_LAST_SEND="" S_LAST_TRY=0

new_install_id() { od -An -tx1 -N16 /dev/urandom | tr -d ' \n'; }

save_state() {
  local tmp="$STATE.tmp.$$"
  mkdir -p "$(dirname "$STATE")" 2>/dev/null || return 0
  (
    umask 077
    jq -n -c \
      --arg id "$S_ID" --arg consent "$S_CONSENT" --arg consent_at "$S_CONSENT_AT" \
      --argjson sent "$S_SENT" --argjson sent_commands "$S_SENT_COMMANDS" \
      --arg last_send "$S_LAST_SEND" --argjson last_try "$S_LAST_TRY" \
      '{install_id: $id, consent: $consent, consent_at: $consent_at, sent: $sent,
        sent_commands: $sent_commands, last_send: $last_send, last_try: $last_try}' \
      >"$tmp" && mv -f "$tmp" "$STATE"
  ) 2>/dev/null || rm -f "$tmp"
}

# Read the state file. Every field is checked, so a hand-edited value cannot
# break the arithmetic below. No file: a new install, answer unset. A file
# that is not a JSON object with an install id: reset to unset, with both
# cursors at the end of the logs, so a broken file never means yes and never
# sends the whole history again. A file from before the question has no
# answer: unset, or no when it says telemetry was turned off.
load_state() {
  local fields=""
  if [ -e "$STATE" ]; then
    fields="$(jq -r '
      def count: if type == "number" and . >= 0 then floor else 0 end;
      def day: if type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") then . else "-" end;
      select(type == "object")
      | select((.install_id | type) == "string" and (.install_id | test("^[0-9a-f]{32}$")))
      | [.install_id, (.sent | count), (.sent_commands | count),
         (if .consent == "yes" or .consent == "no" then .consent
          elif .enabled == false then "no"
          else "unset" end),
         (.consent_at | day), (.last_send | day), (.last_try | count)]
      | map(tostring) | join(" ")' "$STATE" 2>/dev/null | head -n 1)"
    if [ -z "$fields" ]; then
      S_ID="$(new_install_id)" S_CONSENT=unset S_CONSENT_AT="" S_LAST_SEND="" S_LAST_TRY=0
      S_SENT="$(line_count "$STATS")" S_SENT_COMMANDS="$(line_count "$COMMANDS")"
      log_error "state file could not be read; reset, answer unset"
      save_state
      return 0
    fi
  fi
  if [ -z "$fields" ]; then
    S_ID="$(new_install_id)"
    save_state
    return 0
  fi
  read -r S_ID S_SENT S_SENT_COMMANDS S_CONSENT S_CONSENT_AT S_LAST_SEND S_LAST_TRY <<<"$fields"
  [ "$S_CONSENT_AT" != "-" ] || S_CONSENT_AT=""
  [ "$S_LAST_SEND" != "-" ] || S_LAST_SEND=""
}

# state_set NAME VALUE [NAME VALUE ...]: read the file again first, so a change
# another run made meanwhile (for example `telemetry off`) is kept.
state_set() {
  load_state
  while [ "$#" -ge 2 ]; do
    printf -v "$1" '%s' "$2"
    shift 2
  done
  save_state
}

# One line per failure, no content: a time and a fixed text. Kept short.
log_error() {
  mkdir -p "$(dirname "$ERROR_LOG")" 2>/dev/null || return 0
  (
    umask 077
    printf '%s %s\n' "$(date -u +%FT%TZ)" "$1" >>"$ERROR_LOG"
    if [ "$(line_count "$ERROR_LOG")" -gt 200 ]; then
      tail -n 100 "$ERROR_LOG" >"$ERROR_LOG.tmp.$$" && mv -f "$ERROR_LOG.tmp.$$" "$ERROR_LOG"
    fi
  ) 2>/dev/null || true
}

# ── Key and switches ────────────────────────────────────────────────────
# Sets KEY and KEY_SOURCE (env, keychain, default, or none). The value is
# never printed or logged. A bats test never reads the real Keychain.
KEY="" KEY_SOURCE="none"
valid_key() { [[ "$1" =~ ^phc_[A-Za-z0-9]+$ ]]; }
resolve_key() {
  local line="" security_bin=""
  KEY="" KEY_SOURCE="none"
  if valid_key "${DOTFILES_POSTHOG_KEY:-}"; then
    KEY="$DOTFILES_POSTHOG_KEY" KEY_SOURCE="env"
    return 0
  fi
  if [ -f "$KEY_FILE" ]; then IFS= read -r line <"$KEY_FILE" || true; fi
  if valid_key "$line"; then
    KEY="$line" KEY_SOURCE="default"
    return 0
  fi
  # The Keychain is last, so a run with a key from the env or the file starts
  # no `security` process. In a test only a fake (the seam) is ever called.
  if [ -n "${BATS_TEST_FILENAME:-}" ]; then security_bin="${DOTFILES_TELEMETRY_SECURITY:-}"
  elif [ "$(uname -s)" = "Darwin" ]; then security_bin="security"; fi
  [ -n "$security_bin" ] || return 0
  line="$("$security_bin" find-generic-password -s dotfiles -a posthog_key -w 2>/dev/null || true)"
  if valid_key "$line"; then
    KEY="$line" KEY_SOURCE="keychain"
  fi
  return 0
}

# Why a run-time switch stops sending whatever the stored answer is, or "".
blocked() {
  case "${DO_NOT_TRACK:-}" in "" | 0) ;; *) echo "DO_NOT_TRACK is set"; return 0 ;; esac
  [ -z "${CI:-}" ] || { echo "CI is set"; return 0; }
  [ "${DOTFILES_TELEMETRY:-}" != "0" ] || echo "DOTFILES_TELEMETRY=0 is set"
}

# Why nothing may be sent in this run, or "": a switch, or no yes.
not_now() {
  local why
  why="$(blocked)"
  [ -z "$why" ] || { echo "$why"; return 0; }
  case "$S_CONSENT" in
    yes) ;;
    no) echo "you said no; change it: dotfiles telemetry on" ;;
    *) echo "not asked yet; answer: dotfiles telemetry on, or off" ;;
  esac
}

# A person can answer: stdin and stderr are a terminal and this is not CI.
# DOTFILES_TELEMETRY_TTY=1 is for tests only (bats has no terminal).
interactive() {
  [ -z "${CI:-}" ] || return 1
  [ -n "${DOTFILES_TELEMETRY_TTY:-}" ] || { [ -t 0 ] && [ -t 2 ]; }
}

# ── What to send ────────────────────────────────────────────────────────
cutoff_time() {
  date -u -v-"${MAX_AGE_DAYS}"d +%FT%TZ 2>/dev/null || date -u -d "$MAX_AGE_DAYS days ago" +%FT%TZ 2>/dev/null || true
}

# plan FILE CURSOR prints "FROM TOTAL": send lines FROM+1..TOTAL of FILE.
# FROM is the cursor after the caps: at most MAX_EVENTS newest lines, and no
# leading line older than MAX_AGE_DAYS. A cursor past the end (the log was
# cut or rotated) moves to the end, never to 0.
plan() {
  local file="$1" from="$2" total old
  total="$(line_count "$file")"
  [ "$from" -le "$total" ] || from="$total"
  [ $((total - from)) -le "$MAX_EVENTS" ] || from=$((total - MAX_EVENTS))
  if [ "$from" -lt "$total" ]; then
    old="$(tail -n "+$((from + 1))" "$file" 2>/dev/null | awk -v cutoff="$(cutoff_time)" '
      {
        time = ""
        if (match($0, /"timestamp":"[^"]*"/)) time = substr($0, RSTART + 13, RLENGTH - 14)
        if (time != "" && time >= cutoff) exit
        old++
      }
      END { print old + 0 }')"
    from=$((from + ${old:-0}))
  fi
  echo "$from $total"
}

os_name() { case "$(uname -s)" in Darwin) echo darwin ;; Linux) echo linux ;; *) echo other ;; esac; }
arch_name() { case "$(uname -m)" in arm64 | aarch64) echo arm64 ;; x86_64 | amd64) echo x64 ;; *) echo other ;; esac; }

# The command names: the dispatch arms of bin/dotfiles, one per line.
command_names() {
  grep -E '^  [a-z0-9"|-]+\)' "$DOTFILES_DIR/bin/dotfiles" 2>/dev/null |
    sed -e 's/).*//' -e 's/[" ]//g' | tr '|' '\n' | grep -E '^[a-z][a-z0-9-]{0,39}$' | sort -u
}

# events_body EVENT KEY: the log lines on stdin as one PostHog batch body, or
# nothing when no line holds an event. This is the privacy boundary:
# allowlisted fields only; anything else in a line never leaves the Mac. A
# task or command name leaves only when it is on the fixed list.
events_body() {
  local event="$1" key="$2" version
  version="$(git -C "$DOTFILES_DIR" rev-parse --short HEAD 2>/dev/null || true)"
  [[ "$version" =~ ^[0-9a-f]{4,40}$ ]] || version="unknown"
  jq -R -s -c \
    --arg key "$key" --arg id "$S_ID" --arg event "$event" \
    --arg version "$version" --arg os "$(os_name)" --arg arch "$(arch_name)" \
    --arg tasks "$TASK_NAMES" --arg commands "$(command_names | tr '\n' ' ')" '
    def is_number: type == "number" and isinfinite == false and isnan == false;
    def is_time: type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$");
    def name_field($line; $field; $allowed):
      $line[$field] as $name
      | if ($name | type) == "string" and any($allowed | split(" ")[]; length > 0 and . == $name)
        then {($field): $name} else {} end;
    def number_fields($line):
      [("seconds_saved", "units", "pass", "fail", "fixed", "warn", "skip", "duration_ms") as $field
        | select($line[$field] | is_number)
        | {($field): $line[$field]}]
      | add // {};
    def ok_field($line):
      if ($line.ok | type) == "boolean" then {ok: $line.ok} else {} end;
    def time_field($line):
      if ($line.timestamp | is_time) then {timestamp: $line.timestamp} else {} end;

    [split("\n")[]
      | select(length > 0)
      | (try fromjson catch null)
      | select(type == "object")
      | . as $line
      | {event: $event, distinct_id: $id,
         properties: (
           {"$process_person_profile": false, "$geoip_disable": true,
            app_version: $version, os: $os, arch: $arch, runtime: "shell"}
           + name_field($line; "task"; $tasks)
           + name_field($line; "command"; $commands)
           + number_fields($line)
           + ok_field($line))}
        + time_field($line)]
    | select(length > 0)
    | {api_key: $key, batch: .}'
}

# build_body FILE FROM COUNT EVENT KEY: COUNT lines after line FROM as a body.
build_body() {
  tail -n "+$(($2 + 1))" "$1" 2>/dev/null | head -n "$3" | events_body "$4" "$5"
}

# One real event, built by the same code that builds a send.
example_event() {
  printf '{"command":"doctor","timestamp":"%s","ok":true,"duration_ms":1840}\n' "$(date -u +%FT%TZ)" |
    events_body dotfiles.command "" | jq '.batch[0]'
}

what_is_sent() {
  echo "What is sent, at most once a day: the command or task name, its duration,"
  echo "ok or error, counts, the dotfiles version, OS, CPU type, and a random"
  echo "install id. One real event from this Mac:"
  echo ""
  example_event
  echo ""
  echo "The privacy promise: never a path, file name, host name, user name,"
  echo "argument, message, or content. No person profile. PostHog receives the"
  echo "request IP address, like any web server; GeoIP lookup is disabled and no"
  echo "location is stored. Only events recorded after your yes are sent."
  echo "The code that enforces this is bin/dotfiles-telemetry; see"
  echo "$PRIVACY_URL"
  echo "Where it goes: PostHog EU, for a public performance dashboard."
  echo "Change your answer any time: dotfiles telemetry off (or on)."
}

# POST stdin to the endpoint within $1 seconds; prints the HTTP status, or
# nothing when the request could not run. The body (with the key) goes through
# stdin, so the key never shows in a process list. curl has its own time
# limit; a watchdog also kills a request that is still there one second later.
post() {
  local pid watchdog
  exec 7<&0
  "$CURL" -sS -o /dev/null -w '%{http_code}' --connect-timeout "$1" --max-time "$1" -X POST \
    -H 'Content-Type: application/json' --data-binary @- "$URL" <&7 2>/dev/null &
  pid=$!
  exec 7<&-
  (
    sleep "$(($1 + 1))" &
    nap=$!
    trap 'kill "$nap" 2>/dev/null; exit 0' TERM
    wait "$nap"
    kill "$pid" 2>/dev/null
  ) >/dev/null 2>&1 &
  watchdog=$!
  wait "$pid" 2>/dev/null
  kill "$watchdog" 2>/dev/null
  wait "$watchdog" 2>/dev/null
  return 0
}

# ── Sending ─────────────────────────────────────────────────────────────
# One send at a time (a mkdir lock; a lock older than 10 minutes is stale).
HAVE_LOCK=0
unlock() { [ "$HAVE_LOCK" -eq 0 ] || rmdir "$LOCK" 2>/dev/null; HAVE_LOCK=0; }
lock() {
  mkdir -p "$(dirname "$LOCK")" 2>/dev/null
  if ! mkdir "$LOCK" 2>/dev/null; then
    [ -n "$(find "$LOCK" -maxdepth 0 -mmin +10 2>/dev/null)" ] || return 1
    rmdir "$LOCK" 2>/dev/null
    mkdir "$LOCK" 2>/dev/null || return 1
  fi
  HAVE_LOCK=1
  trap unlock EXIT
}

# send_log FILE CURSOR_NAME EVENT TIMEOUT: send what plan allows from one log.
# Adds to SENT_COUNT and SKIPPED_COUNT; sets FAILED_CODE and returns 1 when the
# endpoint does not answer 2xx. The cursor moves after each request that worked.
# Every state write reads the file again first (state_set), so this never
# saves a copy from before a request. It stops before the next request when
# the answer is no longer yes (STOPPED_WHY) or the time is up: DEADLINE is a
# value of $SECONDS, 0 for no limit.
SENT_COUNT=0 SKIPPED_COUNT=0 FAILED_CODE="" STOPPED_WHY="" DEADLINE=0
send_log() {
  local file="$1" cursor_name="$2" event="$3" timeout="$4"
  local cursor from total count body code left
  [ -z "$STOPPED_WHY" ] || return 0
  cursor="${!2}"
  read -r from total <<<"$(plan "$file" "$cursor")"
  if [ "$from" -ne "$cursor" ]; then
    [ "$from" -lt "$cursor" ] || SKIPPED_COUNT=$((SKIPPED_COUNT + from - cursor))
    state_set "$cursor_name" "$from"
  fi
  while [ "$from" -lt "$total" ]; do
    [ "$S_CONSENT" = "yes" ] || { STOPPED_WHY="turned off during the send"; return 0; }
    if [ "$DEADLINE" -gt 0 ]; then
      left=$((DEADLINE - SECONDS))
      [ "$left" -gt 0 ] || { STOPPED_WHY="out of time; the rest goes later"; return 0; }
      [ "$timeout" -le "$left" ] || timeout="$left"
    fi
    count=$((total - from))
    [ "$count" -le "$BATCH_SIZE" ] || count="$BATCH_SIZE"
    body="$(build_body "$file" "$from" "$count" "$event" "$KEY")"
    if [ -n "$body" ]; then
      code="$(printf '%s' "$body" | post "$timeout")"
      if [[ "$code" =~ ^2[0-9][0-9]$ ]]; then
        SENT_COUNT=$((SENT_COUNT + count))
      else
        [[ "$code" =~ ^[0-9]{3}$ ]] || code="000"
        FAILED_CODE="$code"
        return 1
      fi
    fi
    from=$((from + count))
    state_set "$cursor_name" "$from"
  done
}

# send_all TIMEOUT: prints one result line. Never fails.
send_all() {
  local timeout="$1" why skipped=""
  why="$(not_now)"
  [ -z "$why" ] || { echo "telemetry: not sent ($why)"; return 0; }
  lock || { echo "telemetry: not sent (another send is running)"; return 0; }
  # The try time is saved before the key lookup, so a Mac with no key looks
  # for one (and may ask the Keychain) at most once per RETRY_SECONDS.
  state_set S_LAST_TRY "$(date +%s)"
  resolve_key
  [ -n "$KEY" ] || { echo "telemetry: not sent (no key)"; unlock; return 0; }
  if send_log "$STATS" S_SENT dotfiles.run "$timeout" && send_log "$COMMANDS" S_SENT_COMMANDS dotfiles.command "$timeout"; then
    [ "$SKIPPED_COUNT" -eq 0 ] || skipped=" (skipped $SKIPPED_COUNT older event(s))"
    if [ -n "$STOPPED_WHY" ]; then
      echo "telemetry: sent $SENT_COUNT event(s)$skipped, then stopped ($STOPPED_WHY)"
    elif [ "$SENT_COUNT" -eq 0 ]; then
      echo "telemetry: nothing new$skipped"
    else
      state_set S_LAST_SEND "$(today)"
      echo "telemetry: sent $SENT_COUNT event(s)$skipped"
    fi
  else
    log_error "send failed (http $FAILED_CODE)"
    echo "telemetry: send failed (http $FAILED_CODE); will retry"
  fi
  unlock
}

# Print the first request of each log, exactly as a send would build it, with
# the key hidden. Changes nothing and sends nothing.
dry_run() {
  local file cursor event from total count body pending=0
  for file in "$STATS" "$COMMANDS"; do
    if [ "$file" = "$STATS" ]; then cursor="$S_SENT" event="dotfiles.run"; else cursor="$S_SENT_COMMANDS" event="dotfiles.command"; fi
    read -r from total <<<"$(plan "$file" "$cursor")"
    count=$((total - from))
    pending=$((pending + count))
    [ "$count" -le "$BATCH_SIZE" ] || count="$BATCH_SIZE"
    [ "$count" -gt 0 ] || continue
    body="$(build_body "$file" "$from" "$count" "$event" "<posthog_key>")"
    [ -n "$body" ] || continue
    echo "POST $URL"
    jq . <<<"$body"
  done
  echo "dry run: nothing sent. $pending event(s) pending, at most $BATCH_SIZE per request."
}

# Events a send would take now, and older ones it would skip: "PENDING SKIPPED".
pending_counts() {
  local from total pending=0 skipped=0 cursor
  read -r from total <<<"$(plan "$STATS" "$S_SENT")"
  cursor="$S_SENT"; [ "$cursor" -le "$total" ] || cursor="$total"
  pending=$((pending + total - from)); skipped=$((skipped + from - cursor))
  read -r from total <<<"$(plan "$COMMANDS" "$S_SENT_COMMANDS")"
  cursor="$S_SENT_COMMANDS"; [ "$cursor" -le "$total" ] || cursor="$total"
  pending=$((pending + total - from)); skipped=$((skipped + from - cursor))
  echo "$pending $skipped"
}

# ── Commands ────────────────────────────────────────────────────────────
cmd_status() {
  local why pending skipped
  why="$(not_now)"
  resolve_key
  if [ -n "$why" ]; then echo "telemetry: off ($why)"
  elif [ -z "$KEY" ]; then echo "telemetry: off (no key, so nothing is sent)"
  else echo "telemetry: on"; fi
  case "$S_CONSENT" in
    yes | no) echo "consent: $S_CONSENT (given ${S_CONSENT_AT:-on an unknown day})" ;;
    *) echo "consent: unset (not asked yet; dotfiles asks once on your next run in a terminal)" ;;
  esac
  echo "key: $KEY_SOURCE"
  echo "endpoint: $URL"
  read -r pending skipped <<<"$(pending_counts)"
  if [ "$skipped" -gt 0 ]; then echo "pending: $pending event(s) ($skipped older event(s) will be skipped, never sent)"
  else echo "pending: $pending event(s)"; fi
  echo "last send: ${S_LAST_SEND:-never}"
  [ ! -s "$ERROR_LOG" ] || echo "last problem: $(tail -n 1 "$ERROR_LOG")"
}

cmd_send() {
  if [ "${1:-}" = "--dry-run" ]; then dry_run; else send_all "$MANUAL_TIMEOUT"; fi
}

# The automatic path: quiet, at most one working send a day, at most
# AUTO_TIMEOUT seconds in total, and after a try it waits RETRY_SECONDS.
cmd_daily() {
  [ -z "$(not_now)" ] || return 0
  [ "$S_LAST_SEND" != "$(today)" ] || return 0
  [ $(($(date +%s) - S_LAST_TRY)) -ge "$RETRY_SECONDS" ] || return 0
  DEADLINE=$((SECONDS + AUTO_TIMEOUT))
  send_all "$AUTO_TIMEOUT" >/dev/null 2>&1 || true
}

# record_consent yes|no. A new yes covers only later events: both cursors move
# to the end of the logs, so nothing recorded before the yes is ever sent.
record_consent() {
  load_state
  if [ "$1" = "yes" ] && [ "$S_CONSENT" != "yes" ]; then
    state_set S_CONSENT yes S_CONSENT_AT "$(today)" \
      S_SENT "$(line_count "$STATS")" S_SENT_COMMANDS "$(line_count "$COMMANDS")"
  else
    state_set S_CONSENT "$1" S_CONSENT_AT "$(today)"
  fi
}

# Throw away keys typed before the question shows, so a stray Enter is never
# an answer. Only on a real terminal: a pipe is read as it is.
drain_input() {
  local saved
  [ -t 0 ] || return 0
  saved="$(stty -g 2>/dev/null)" || return 0
  stty -icanon min 0 time 0 2>/dev/null || return 0
  cat >/dev/null 2>&1 || true
  stty "$saved" 2>/dev/null || true
}

cmd_on() {
  record_consent yes
  what_is_sent
  echo ""
  echo "telemetry: turned on. Turn it off: dotfiles telemetry off"
}

cmd_off() {
  record_consent no
  echo "telemetry: turned off. Nothing is sent. Turn it on: dotfiles telemetry on"
}

# The consent question. It is asked once: an answer is never asked again. The
# question goes to stderr and the answer comes from stdin, only where a person
# can answer. Where nobody can, the answer stays unset and nothing is sent.
# At install Enter counts as yes. On the first-run path (no --install) the
# person did not expect a question, so only a typed y or n is an answer.
cmd_ask() {
  local install=0 optout="" answer tries choices="[y/n]"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --install) install=1 ;;
      --no) optout="--no-telemetry" ;;
      *) echo "Unknown flag: $1 (see dotfiles telemetry --help)" >&2; exit 2 ;;
    esac
    shift
  done
  if [ "$install" -eq 1 ] && [ -z "$optout" ]; then
    if [ "${DOTFILES_TELEMETRY:-}" = "0" ]; then optout="DOTFILES_TELEMETRY=0"; fi
    case "${DO_NOT_TRACK:-}" in "" | 0) ;; *) optout="DO_NOT_TRACK is set" ;; esac
  fi
  # An opt-out always wins, also over an earlier yes.
  if [ -n "$optout" ]; then
    [ "$S_CONSENT" = "no" ] || record_consent no
    echo "telemetry: off ($optout). Nothing is sent. Turn it on later: dotfiles telemetry on"
    return 0
  fi
  if [ "$S_CONSENT" != "unset" ]; then
    [ "$install" -eq 0 ] || echo "telemetry: your answer is $S_CONSENT (given ${S_CONSENT_AT:-earlier}); not asked again. Change it: dotfiles telemetry on, or off"
    return 0
  fi
  if ! interactive; then
    [ "$install" -eq 0 ] || echo "telemetry: not asked (no terminal), so nothing is sent. dotfiles asks once on your next run in a terminal. Answer now: dotfiles telemetry on, or off"
    return 0
  fi
  [ "$install" -eq 0 ] || choices="[Y/n]"
  drain_input
  {
    echo ""
    echo "========================================================================"
    echo "  Help make dotfiles faster: share anonymous performance numbers?"
    echo "========================================================================"
    what_is_sent
    echo ""
  } >&2
  for tries in 1 2 3; do
    printf 'Share anonymous performance numbers? %s ' "$choices" >&2
    IFS= read -r answer || { echo "" >&2; break; }
    [ -n "$answer" ] || [ "$install" -eq 0 ] || answer="y"
    case "$answer" in
      y | Y | yes | YES | Yes)
        record_consent yes
        echo "telemetry: on. Thank you. Turn it off any time: dotfiles telemetry off" >&2
        return 0 ;;
      n | N | no | NO | No)
        record_consent no
        echo "telemetry: off. Nothing is sent. Turn it on any time: dotfiles telemetry on" >&2
        return 0 ;;
    esac
    [ "$tries" -eq 3 ] || echo "Please answer y or n." >&2
  done
  echo "telemetry: no answer, so nothing is sent. dotfiles asks again on your next run in a terminal." >&2
}

load_state
case "${1:-status}" in
  status) cmd_status ;;
  on) cmd_on ;;
  off) cmd_off ;;
  send) shift; cmd_send "$@" ;;
  ask) shift; cmd_ask "$@" ;;
  example) what_is_sent ;;
  daily) cmd_daily ;;
  *) echo "Unknown subcommand: $1 (see dotfiles telemetry --help)" >&2; exit 2 ;;
esac
exit 0
