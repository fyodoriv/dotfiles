#!/bin/bash
# Say once a day that background updates landed and the checkup should run
# (#301). Reads the record that tooling-sync and dotfiles-upgrade write
# (lib/updates-landed.sh). Prints nothing when nothing new landed.
#
# Usage: dotfiles-updates-landed           one line, at most once a day
#        dotfiles-updates-landed --always  the line every time (no daily limit)
#        dotfiles-updates-landed --ack     mark everything so far as seen (the checkup runs this)

set -uo pipefail
{ [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; } && { sed -n '/^#!/d; /^$/q; /^[^#]/q; s/^# \{0,1\}//p' "$0"; exit 0; }

# shellcheck source=../lib/updates-landed.sh
source "$(cd "$(dirname "$0")/.." && pwd)/lib/updates-landed.sh"
file="$(updates_landed_file)"
ack="$file.ack"
shown="$file.shown"

if [ "${1:-}" = --ack ]; then
  mkdir -p "$(dirname "$ack")"
  if [ -f "$file" ]; then wc -l < "$file" | tr -d ' ' > "$ack"; else echo 0 > "$ack"; fi
  exit 0
fi

[ -f "$file" ] || exit 0
total="$(wc -l < "$file" | tr -d ' ')"
seen="$(cat "$ack" 2>/dev/null || echo 0)"
case "$seen" in '' | *[!0-9]*) seen=0 ;; esac
# The record keeps the newest 100 lines, so an old ack can exceed the count.
[ "$seen" -le "$total" ] || seen=0
new=$((total - seen))
[ "$new" -gt 0 ] || exit 0
today="$(date +%Y-%m-%d)"
if [ "${1:-}" != --always ] && [ "$(cat "$shown" 2>/dev/null)" = "$today" ]; then exit 0; fi
sources="$(tail -n "$new" "$file" | cut -f2 | sort -u | paste -sd ',' - | sed 's/,/, /g')"
echo "$new update(s) landed since the last checkup ($sources): run the tooling-checkup to see what changed."
[ "${1:-}" = --always ] || printf '%s\n' "$today" > "$shown"
exit 0
