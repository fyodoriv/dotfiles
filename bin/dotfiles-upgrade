#!/bin/bash
# Upgrade all installed software via topgrade.
#
# topgrade is the canonical "GET, don't IMPLEMENT" choice (AGENTS.md Rule 0):
# it detects ~80+ package managers automatically (Homebrew, mas, npm, pipx,
# uv, fnm, gh extensions, JetBrains, VS Code variants, Ollama, etc.) and
# runs the right upgrade command for each. Replaces the prior 239-line
# hand-rolled implementation that covered ~6 of those managers.
#
# This wrapper adds the dotfiles-specific glue topgrade can't do itself:
#   - Lock acquisition (prevents concurrent runs with auto-sync launchagents)
#   - Skip-if-grind-active safety (don't fight an in-flight minsky/Devin loop)
#   - Logging to ~/.local/share/dotfiles/logs/dotfiles-upgrade.log
#   - macOS notification on completion
#   - last-upgrade timestamp file for `dotfiles stats`
#   - Company plugins: each pinned plugin moves to its newest stable signed
#     tag (`dotfiles plugin update --unattended`, docs/plugins.md)
#
# topgrade's own behaviour is configured via dot_config/topgrade.toml.tmpl
# (lands at ~/.config/topgrade.toml — topgrade reads the file directly,
# not a subdir).
# Run `topgrade --edit-config` to open + edit that file.
#
# Usage:
#   dotfiles-upgrade [--yes]      Run full upgrade
#   dotfiles-upgrade --dry-run    Show what would be upgraded (no changes)
#   dotfiles-upgrade --node [VER] [--yes]
#                                 Switch Node (latest LTS or VER) in one step:
#                                 fnm, ~/.node-version, ~/.local/bin links,
#                                 agentbrew plists (bin/dotfiles-node-upgrade)
#
# It asks first (lib/confirm.sh): y/N at a terminal; without a terminal it
# needs --yes. --dry-run needs no yes.
# Schedule: com.dotfiles.dotfiles-upgrade LaunchAgent (weekly, Sunday 09:00).
# It passes --yes: turning on auto_upgrade is the owner's yes.

# shellcheck disable=SC2154  # counters defined in lib/output.sh

set -euo pipefail

# --yes is the person's yes (or the weekly LaunchAgent's, see above). It is
# read first, so `--yes --help` still only prints the help.
YES=0 _args=()
for _a in "$@"; do
  case "$_a" in --yes) YES=1 ;; *) _args+=("$_a") ;; esac
done
set -- ${_args[@]+"${_args[@]}"}
{ [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; } && { sed -n '/^#!/d; /^$/q; /^[^#]/q; /^# shellcheck/d; s/^# \{0,1\}//p' "$0"; exit 0; }

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/confirm.sh
source "$DOTFILES_DIR/lib/confirm.sh"

# A Node switch is deliberate (macOS may prompt once for the new binary), so
# it runs only on request, never in the weekly topgrade pass.
case "${1:-}" in
  --node)
    shift
    case " $* " in
      *" --dry-run "*) ;;
      *) confirm_yes "$YES" "switches Node for your shell, ~/.local/bin, and the agentbrew LaunchAgents" ;;
    esac
    exec bash "$DOTFILES_DIR/bin/dotfiles-node-upgrade" "$@"
    ;;
esac

# Topgrade discovers and executes Node/npm/fnm, Ollama, uv/Python, and editor
# update CLIs. Do not run that unattended publisher fan-out while this managed
# endpoint blocks the Node.js Foundation runtime.
if [ -x "$DOTFILES_DIR/bin/dotfiles-disable-blocked-node-automation" ]; then
  "$DOTFILES_DIR/bin/dotfiles-disable-blocked-node-automation" >/dev/null || true
fi
if [ -f "$HOME/.local/state/dotfiles/endpoint-node-publisher-blocked" ] \
    && [ "${DOTFILES_ALLOW_BLOCKED_NODE_PUBLISHER:-0}" != "1" ]; then
  echo "○ Software upgrade skipped: Node.js Foundation publisher is blocked (endpoint-policy safe mode)"
  exit 0
fi

# shellcheck source=../lib/colors.sh
source "$DOTFILES_DIR/lib/colors.sh"
# shellcheck source=../lib/stats.sh
source "$DOTFILES_DIR/lib/stats.sh"
# shellcheck source=../lib/updates-landed.sh
source "$DOTFILES_DIR/lib/updates-landed.sh"
# shellcheck source=../lib/lock.sh
source "$DOTFILES_DIR/lib/lock.sh"

DRY_RUN=false
[ "${1:-}" = "--dry-run" ] && DRY_RUN=true

LOG_DIR="$HOME/.local/share/dotfiles/logs"
mkdir -p "$LOG_DIR"
UPGRADE_LOG="$LOG_DIR/dotfiles-upgrade.log"
# The log holds plugin update output (source URLs, git errors): owner only.
(umask 077; touch "$UPGRADE_LOG") && chmod 600 "$UPGRADE_LOG" 2>/dev/null || true
LAST_UPGRADE_FILE="$HOME/.local/share/dotfiles/last-upgrade"

# ── Safety: skip when a real autonomous loop is in flight ───────────
# Original check was over-eager: it skipped on ANY process matching
# `minsky` (would have matched a vim editing ~/apps/tooling/minsky/...)
# AND on any `devin --permission-mode` process (would have matched an
# interactive `dvb` session where the operator is at the keyboard).
# Both cases triggered false-positive skips that confused operators.
#
# Sharper signal: `pgrep -f 'minsky run\b'` matches the iteration
# process minsky's autonomous daemon spawns (`minsky run`, `minsky run
# --hosts-dir <p>`, etc.). That's the actual "don't race brew upgrade
# against an in-flight Cargo build / npm install" case. The minsky
# launchd supervisor itself (`com.minsky.daemon`) doesn't match —
# only an active iteration does.
#
# Interactive Devin sessions (including `dvb`) no longer trigger the
# skip. The operator initiated the upgrade; they know what they're
# doing. If they're mid-build and want to defer, they Ctrl-C.
is_minsky_loop_active() {
  pgrep -f 'minsky run\b' >/dev/null 2>&1
}

if is_minsky_loop_active; then
  echo -e "${YELLOW}⚠${NC} Skipping upgrade — minsky autonomous iteration in flight"
  echo -e "  Run \`minsky daemon status\` for details; retry once the loop completes."
  exit 0
fi

# ── Ensure topgrade is installed ────────────────────────────────────
if ! command -v topgrade >/dev/null 2>&1; then
  echo -e "${RED}✗${NC} topgrade not installed."
  echo -e "  Run \`dotfiles apply\` to install via Brewfile,"
  echo -e "  or install directly: \`brew install topgrade\`"
  exit 1
fi

# ── Acquire lock so the weekly launchagent + manual invocation can't race
if ! $DRY_RUN; then
  confirm_yes "$YES" "upgrades the software of every package manager on this Mac (topgrade); that is hard to roll back"
  acquire_lock "upgrade" || exit 0
fi

echo -e "${BLUE}── dotfiles-upgrade $(date '+%Y-%m-%d %H:%M') ──${NC}" \
  | tee -a "$UPGRADE_LOG"

# ── Corporate CA for Node-based steps ───────────────────────────────
# topgrade's npm and editor-extension steps shell out to Node, whose bundled
# Mozilla root store doesn't include a corporate TLS-inspection root CA.
# Under launchd this script does NOT source
# ~/.zshenv (where the same export lives for interactive shells — see
# home/zshenv), so set it here too. Without it, `code --update-extensions`
# and npm fail with "self signed certificate in
# certificate chain". NODE_EXTRA_CA_CERTS only APPENDS to Node's built-in
# roots. Guarded so a missing bundle doesn't point Node at a missing
# file, and so an existing value (e.g. from ~/.zshenv.secrets) wins.
if [ -z "${NODE_EXTRA_CA_CERTS:-}" ]; then
  # DOTFILES_CORPORATE_CA_BUNDLES: optional colon-separated extra candidates.
  IFS=':' read -r -a _extra_ca <<< "${DOTFILES_CORPORATE_CA_BUNDLES:-}"
  for _corp_ca in \
    ${_extra_ca[@]+"${_extra_ca[@]}"} \
    "$HOME/.config/ssl/corporate-combined-ca.pem" \
    "$HOME/.config/ssl/macos-trust-bundle.pem"; do
    if [ -f "$_corp_ca" ]; then
      export NODE_EXTRA_CA_CERTS="$_corp_ca"
      break
    fi
  done
  unset _corp_ca _extra_ca
fi

# ── OpenCode on PATH (#260) ─────────────────────────────────────────
# topgrade's OpenCode step runs `opencode upgrade`, which re-runs the OpenCode
# install script. That script appends an `export PATH=...` line to ~/.zshrc
# (a link to the tracked home/zshrc) unless ~/.opencode/bin is already on
# PATH. launchd and agent shells often lack it, so add it here.
_opencode_bin="$HOME/.opencode/bin"
if [ -d "$_opencode_bin" ]; then
  case ":$PATH:" in
    *":$_opencode_bin:"*) ;;
    *) export PATH="$_opencode_bin:$PATH" ;;
  esac
fi
unset _opencode_bin

# ── Run topgrade ────────────────────────────────────────────────────
# topgrade flags:
#   --no-tmux      Don't auto-launch inside tmux — we want headless
#                  (launchagent has no tty; user-shell tmux nesting is noisy)
#   --yes          Don't prompt on retry; assume yes for everything
#   --dry-run      When this wrapper's --dry-run is passed
#
# NOTE: we intentionally do NOT pass --cleanup. topgrade's global --cleanup
# makes each step run its cache-prune phase inline, and the uv step's
# `uv cache prune` then blocks on (and times out against) the cache lock
# held by any live `uvx` / `uv tool run` MCP server — common on this machine
# whenever a Devin/minsky session is up — which fails the whole upgrade
# (the original symptom: "Timeout (300s) when waiting for lock on .../uv").
# Cache pruning instead runs via the [post_commands] `cleanup` step
# (bin/cleanup) in dot_config/topgrade.toml.tmpl: it already covers brew / npm /
# yarn and is lock-tolerant (errors swallowed; its uv prune uses a short
# UV_LOCK_TIMEOUT so it skips fast when the cache is busy).
#
# Per-step configuration (which managers to run, brew greedy mode,
# post-upgrade bottle re-signing + cache cleanup) lives in
# dot_config/topgrade.toml.tmpl — don't override via flags here.
_args=(--no-tmux --yes)
if $DRY_RUN; then
  _args+=(--dry-run)
fi

# Versions before the run, so the updates-landed record names what moved.
_versions_before="$(updates_brew_versions 2>/dev/null || true)"
_plugins_updated=""
if topgrade "${_args[@]}" 2>&1 | tee -a "$UPGRADE_LOG"; then
  rc=0
else
  rc=$?
fi

# ── Re-sign bottles after brew upgrade (belt-and-suspenders) ─────────
# topgrade [post_commands] also runs dotfiles-adhoc-sign-bottles; this covers
# the case where post_commands fail silently or topgrade.toml path is stale.
if ! $DRY_RUN && [ "$rc" -eq 0 ]; then
  export DOTFILES_ADHOC_SIGN_QUIET=1
  if [ -x "$DOTFILES_DIR/bin/dotfiles-adhoc-sign-bottles" ]; then
    "$DOTFILES_DIR/bin/dotfiles-adhoc-sign-bottles" 2>&1 | tee -a "$UPGRADE_LOG" || true
  fi
  if [ -x "$DOTFILES_DIR/bin/dotfiles-adhoc-sign-uv-pythons" ]; then
    "$DOTFILES_DIR/bin/dotfiles-adhoc-sign-uv-pythons" 2>&1 | tee -a "$UPGRADE_LOG" || true
  fi
  if [ -x "$DOTFILES_DIR/bin/dotfiles-link-jq-shim" ]; then
    "$DOTFILES_DIR/bin/dotfiles-link-jq-shim" 2>&1 | tee -a "$UPGRADE_LOG" || true
  fi
fi

# ── Company plugins (docs/plugins.md "Update") ──────────────────────
# Each pinned plugin in plugins.lock moves to its newest stable signed tag
# through `dotfiles plugin update --unattended`, with all of its checks
# (exact signed tag object, trusted signer, manifest, rollback). This runs
# after the --yes gate above. A plugin whose capabilities changed is
# skipped and named with the command to run: approving new capabilities
# needs a person, and the weekly run has none. A failed update is named and
# fails the run, as a failed topgrade step does; the other plugins still
# update. --dry-run lists what would change. --dev links are left alone.
plugin_failed=0 plugin_skipped=0
if command -v yq >/dev/null 2>&1 && [ -f "$DOTFILES_DIR/lib/plugin.sh" ]; then
  # shellcheck source=../lib/plugin.sh
  source "$DOTFILES_DIR/lib/plugin.sh"
  _plugin_lines=() _plugin_updated=0
  _lock="$(plugin_lock_file)"
  if [ -f "$_lock" ] && ! yq '.' "$_lock" >/dev/null 2>&1; then
    plugin_failed=1
    _plugin_lines+=("✗ $_lock cannot be read, so no plugin was updated (check it with: dotfiles plugin list)")
  fi
  for _plugin in $(plugin_lock_names); do
    [ "$(plugin_lock_get "$_plugin" dev)" != true ] || continue
    _mode=--unattended
    ! $DRY_RUN || _mode=--dry-run
    _prc=0
    # The update runs under this upgrade's dotfiles lock (lib/lock.sh).
    _out="$(DOTFILES_LOCK_HOLDER=$$ bash "$DOTFILES_DIR/bin/dotfiles-plugin" update "$_plugin" "$_mode" < /dev/null 2>&1)" || _prc=$?
    # Plugin output is bytes from git and remote hosts: read it in the C
    # locale (sed and grep stop on invalid UTF-8 otherwise), and never let
    # one line of it stop the upgrade. The log drops user:token@ parts of URLs.
    _out="$(LC_ALL=C sed -E 's#(://)[^/@[:space:]]+@#\1#g' <<< "$_out" || true)"
    printf '%s\n' "$_out" >> "$UPGRADE_LOG" || true
    _line=""
    case "$_prc" in
      0)
        _line="$(LC_ALL=C grep -aE '^(✓ |✗ |Would update plugin |Skipped plugin )' <<< "$_out" | tail -1 || true)"
        case "$_line" in
          "✓ Updated plugin "*)
            _plugin_updated=1
            _plugins_updated="${_plugins_updated:+$_plugins_updated, }$_plugin" ;;
          "Skipped plugin "*) plugin_skipped=1 ;;
          "✗ "*) plugin_failed=1 ;;
        esac ;;
      3)
        _line="$(LC_ALL=C grep -aE '^Skipped plugin ' <<< "$_out" | tail -1 || true)"
        plugin_skipped=1 ;;
    esac
    if [ -z "$_line" ]; then
      # A failure, or a result this step does not know (exit 3 included).
      plugin_failed=1
      _line="✗ plugin $_plugin: update failed (exit $_prc): $(LC_ALL=C grep -av '^[[:space:]]*$' <<< "$_out" | tail -1 | LC_ALL=C sed 's/^✗ //' || true)"
    fi
    _plugin_lines+=("$_line")
  done
  [ "$_plugin_updated" = 0 ] || _plugin_lines+=("Run dotfiles apply to load the updated plugins' LaunchAgents, Brewfile, and Agentfile.")
  if [ "${#_plugin_lines[@]}" -gt 0 ]; then
    echo -e "${BLUE}── Plugins ──${NC}" | tee -a "$UPGRADE_LOG"
    printf '  %s\n' "${_plugin_lines[@]}" | tee -a "$UPGRADE_LOG"
  fi
  unset _plugin _mode _prc _out _line _plugin_lines _plugin_updated _lock
fi
if [ "$plugin_failed" = 1 ] && [ "$rc" -eq 0 ]; then
  rc=1
fi

# ── Record last-upgrade timestamp (used by `dotfiles stats` + the morning
# script's "X days since last upgrade" hint).
if ! $DRY_RUN; then
  date '+%s' > "$LAST_UPGRADE_FILE"
  log_run "upgrade" 1
fi

# ── Trim log to last 1000 lines — topgrade is verbose enough that the
# old 500-line cap was rotating mid-run.
if [ -f "$UPGRADE_LOG" ]; then
  rm -f "$UPGRADE_LOG.tmp"
  (umask 077; tail -1000 "$UPGRADE_LOG" > "$UPGRADE_LOG.tmp") \
    && mv "$UPGRADE_LOG.tmp" "$UPGRADE_LOG"
fi

# ── What changed, for the "updates landed" nudge (#301) ─────────────
# Only a run that moved a package version or updated a plugin is recorded,
# so the nudge means something.
_changes="$(updates_version_summary "$_versions_before" "$(updates_brew_versions)" 2>/dev/null || true)"
[ -z "$_plugins_updated" ] || _changes="${_changes:+$_changes; }plugin(s) updated: $_plugins_updated"

# ── Outcome notification ────────────────────────────────────────────
if [ "$rc" -ne 0 ]; then
  echo -e "${RED}✗${NC} Upgrade complete with failures (rc=$rc). See $UPGRADE_LOG" \
    | tee -a "$UPGRADE_LOG"
  if ! $DRY_RUN; then
    notify "dotfiles-upgrade" "Upgrade finished with failures (see log)" "Basso"
    [ -z "$_changes" ] || updates_landed_record dotfiles-upgrade "$_changes (with failures, see $UPGRADE_LOG)"
  fi
  exit "$rc"
fi

echo -e "${GREEN}✓${NC} Upgrade complete." | tee -a "$UPGRADE_LOG"
if ! $DRY_RUN; then
  [ -z "$_changes" ] || updates_landed_record dotfiles-upgrade "$_changes"
  if [ "$plugin_skipped" = 1 ]; then
    notify "dotfiles-upgrade" "Upgrade done; a plugin needs your approval (see log)" ""
  else
    notify "dotfiles-upgrade" "All software upgraded successfully" ""
  fi
fi
