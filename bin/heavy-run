#!/bin/bash
# heavy-run — run heavy commands on this Mac in a few parallel slots, at low priority.
#
# Every agent session and worker shares one state folder at a fixed path, so
# full suites, e2e runs, and timing runs queue instead of piling up.
# $TMPDIR is not used: sandboxed sessions can see different temp dirs.
#
# Slots: a run holds an flock on one slot file ($dir/slots/<n>) and a shared
# flock on $dir/lock. The slot count comes from the machine (half the CPU
# cores, one per 8 GB of memory, at least 1) unless HEAVY_RUN_SLOTS or the
# heavy_run_slots setting says otherwise. A second or later run starts only
# when a slot is free, memory pressure is normal, the last run started at
# least HEAVY_RUN_RAMP seconds ago (a new gate needs time to show its memory),
# and the 1-minute load is under HEAVY_RUN_MAX_LOAD (when set). The first run
# always starts, as with the old single lock. `heavy-run --exclusive` takes an
# exclusive flock on $dir/lock instead: it waits until no run is active and
# blocks every other run until it ends (use it for timing runs). An old
# heavy-run binary takes the same exclusive flock, so it mixes in safely.
#
# Weight: `--weight N` (or HEAVY_RUN_WEIGHT) makes a run hold N slots at once
# (capped at the slot count), for a gate that runs several suites inside itself.
# Light lane: `--light` is a small run (a 1-file rerun) that takes the single
# lane slot ($dir/light/1), never a heavy slot. So at most one light run runs
# beside the heavy runs, and a light run never lets an extra heavy run start.
# Light runs and heavy runs keep arrival order each in their own line: a light
# run waits only for the lights ahead of it and passes a heavy queue head
# without taking anything the head needs, so the head cannot starve. A light
# run starts when the lane is free and, while a heavy run is active, the ramp
# has passed and memory pressure is normal. It never moves the heavy ramp. An
# exclusive run waits for the lane too, and no light run starts while an
# exclusive run is queued.
#
# Waiters are served in arrival order. Each caller takes a numbered ticket
# file in $dir/queue (numbers come from $dir/seq under a short flock) and holds
# an flock on that file while it waits. Only the lowest live ticket tries to
# start; it writes why it waits into its ticket for --status. A ticket nobody
# holds (its owner died, even by SIGKILL) is deleted by the next waiter. A
# crashed run frees its slot because the kernel drops its flock; liveness never
# depends on a pid. If the queue folder is unusable, heavy-run warns once and
# waits without arrival order. A waiter whose caller died (getppid() changes:
# the kernel reparents it) drops its ticket and exits 129; a waiter started
# with no caller (parent pid 1) or with HEAVY_RUN_KEEP_ORPHAN=1 keeps waiting.
# Each run appends "waited=<seconds> ... weight=<n> lane=<heavy|light>" to the wait
# log (skipped if its folder cannot be made). Known limits: a stopped (Ctrl-Z)
# waiter at the head blocks the queue until it resumes; callers on the fallback
# path can overtake the head.
#
# A perl parent holds the flocks (fds closed on exec, so no child or leftover
# daemon inherits them), runs the command, forwards TERM/INT/HUP to it, and
# exits with its status. A slot lasts exactly as long as the command. The
# command sees HEAVY_RUN_SLOT (its first slot number, or "exclusive") and
# HEAVY_RUN_SLOT_LIST (all its slots, comma-separated), so a gate can pick
# ports or folders per slot. heavy-run itself shares no writable temp path
# between runs. The folder is mode 0700 and its files 0600.
#
# Usage:
#   heavy-run make check
#   heavy-run npm run verify
#   heavy-run --exclusive scripts/metrics.sh   # alone on the machine
#   heavy-run --weight 3 scripts/check.sh      # a gate that runs 3 suites inside
#   heavy-run --light npx playwright test one.spec.ts   # a 1-file rerun
#   heavy-run --status          # running slots, the queue, and why each waits
#
# Env (each wins over its setting in ~/.config/chezmoi/chezmoi.yaml):
#   HEAVY_RUN_DIR       state folder (default ~/.local/state/heavy-run)
#   HEAVY_RUN_NICE      absolute nice level (default 15); never raises priority
#   HEAVY_RUN_SLOTS     parallel slots, 1-64 (setting heavy_run_slots; default auto)
#   HEAVY_RUN_RAMP      seconds between run starts while others run, 0-3600
#                       (setting heavy_run_ramp_seconds; default 15)
#   HEAVY_RUN_MAX_LOAD  1-minute load above which no extra run starts; 0 = off
#                       (setting heavy_run_max_load; default 0)
#   HEAVY_RUN_WEIGHT    slots a run holds, 1-64 (default 1); --weight wins
#   HEAVY_RUN_LIGHT     1 = a light run, like --light (default 0)
#   HEAVY_RUN_KEEP_ORPHAN  1 = keep waiting after the caller dies (default 0)
#   HEAVY_RUN_PROBE     a command whose non-empty output is a reason to wait;
#                       replaces the built-in memory pressure check
#   HEAVY_RUN_WAIT_LOG  wait log (default ~/.local/state/dotfiles/heavy-run-waits.log,
#                       or $HEAVY_RUN_DIR/waits.log when HEAVY_RUN_DIR is set)

set -euo pipefail
umask 077

dir="${HEAVY_RUN_DIR:-$HOME/.local/state/heavy-run}"
lock="$dir/lock"
owner="$dir/owner"
queue="$dir/queue"
if [ -n "${HEAVY_RUN_WAIT_LOG:-}" ]; then waitlog="$HEAVY_RUN_WAIT_LOG"
elif [ -n "${HEAVY_RUN_DIR:-}" ]; then waitlog="$dir/waits.log"
else waitlog="$HOME/.local/state/dotfiles/heavy-run-waits.log"; fi
level="${HEAVY_RUN_NICE:-15}"

usage() {
  echo "Usage: heavy-run [--exclusive | --weight N | --light] <command...> | heavy-run --status"
}

# Settings: env first, then the chezmoi data, then the default ("" = auto).
setting() {
  local env="$1" key="$2" def="$3" cfg="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/chezmoi.yaml" v
  if [ -n "${!env:-}" ]; then printf '%s\n' "${!env}"; return; fi
  v=$(sed -n "s/^  $key: *\"\{0,1\}\([0-9.]*\)\"\{0,1\} *$/\1/p" "$cfg" 2>/dev/null | head -n 1) || v=""
  printf '%s\n' "${v:-$def}"
}
slots_set=$(setting HEAVY_RUN_SLOTS heavy_run_slots "")
ramp=$(setting HEAVY_RUN_RAMP heavy_run_ramp_seconds 15)
maxload=$(setting HEAVY_RUN_MAX_LOAD heavy_run_max_load 0)

check_num() {
  case "$2" in
    '' | *[!0-9.]* | *.*.*) echo "heavy-run: $1 must be a number, got '$2'" >&2; exit 2 ;;
  esac
}
case "$slots_set" in
  '') ;;
  *[!0-9]* | 0 | 0*) echo "heavy-run: HEAVY_RUN_SLOTS must be 1-64, got '$slots_set'" >&2; exit 2 ;;
  *) [ "$slots_set" -le 64 ] || { echo "heavy-run: HEAVY_RUN_SLOTS must be 1-64, got '$slots_set'" >&2; exit 2; } ;;
esac
check_num HEAVY_RUN_RAMP "$ramp"
check_num HEAVY_RUN_MAX_LOAD "$maxload"

# Shared by the run and --status: machine size, slot count, and wait reasons.
common_code='
  use strict; use warnings;
  use Fcntl qw(:flock O_RDWR O_CREAT);
  sub cmd_out { my $o = `$_[0] 2>/dev/null`; $o //= ""; chomp $o; return $o; }
  sub ncpu {
    my $n = cmd_out("sysctl -n hw.ncpu");
    $n = cmd_out("getconf _NPROCESSORS_ONLN") unless $n =~ /^\d+$/ && $n > 0;
    return ($n =~ /^\d+$/ && $n > 0) ? $n : 1;
  }
  sub mem_gb {
    my $b = cmd_out("sysctl -n hw.memsize");
    return $b / 2**30 if $b =~ /^\d+$/ && $b > 0;
    if (open(my $m, "<", "/proc/meminfo")) { while (<$m>) { return $1 / 2**20 if /^MemTotal:\s+(\d+)/; } }
    return 0;
  }
  sub slot_count {
    my ($set) = @_;
    return $set if $set ne "";
    my $by_cpu = int(ncpu() / 2);
    my $gb = mem_gb();
    my $n = $gb > 0 ? (sort { $a <=> $b } $by_cpu, int($gb / 8))[0] : $by_cpu;
    return $n < 1 ? 1 : $n;
  }
  sub load1 {
    my $l = cmd_out("sysctl -n vm.loadavg");
    return $1 if $l =~ /([\d.]+)/;
    if (open(my $f, "<", "/proc/loadavg")) { my $x = <$f> // ""; return $1 if $x =~ /^([\d.]+)/; }
    return 0;
  }
  # Empty when memory looks fine (or cannot be read), else why to wait.
  sub pressure {
    if (defined $ENV{HEAVY_RUN_PROBE} && $ENV{HEAVY_RUN_PROBE} ne "") {
      my $r = cmd_out($ENV{HEAVY_RUN_PROBE}); $r =~ s/\s+/ /g; return $r;
    }
    my $lvl = cmd_out("sysctl -n kern.memorystatus_vm_pressure_level");
    if ($lvl =~ /^\d+$/) {
      return "" if $lvl <= 1;
      return $lvl >= 4 ? "memory pressure critical" : "memory pressure warn";
    }
    if (open(my $p, "<", "/proc/pressure/memory")) {
      my $x = <$p> // "";
      return "memory pressure some avg10=$1" if $x =~ /avg10=([\d.]+)/ && $1 > 10;
    }
    if (open(my $m, "<", "/proc/meminfo")) {
      my %k; while (<$m>) { $k{$1} = $2 if /^(\w+):\s+(\d+)/; }
      return "low free memory" if $k{MemTotal} && defined $k{MemAvailable} && $k{MemAvailable} < $k{MemTotal} / 10;
    }
    return "";
  }
  # Is someone holding an flock on this file? (We can not get it at once.)
  sub held { my ($p, $mode) = @_; open(my $f, "<", $p) or return 0; return flock($f, ($mode // LOCK_EX) | LOCK_NB) ? 0 : 1; }
  sub slot_files { my ($d) = @_; opendir(my $h, $d) or return (); return sort { $a <=> $b } grep { /^\d+$/ } readdir $h; }
'

case "${1:-}" in
  "" | -h | --help)
    usage
    [ -n "${1:-}" ] && exit 0
    exit 2
    ;;
  --status)
    exec perl -e "$common_code"'
      my ($dir, $lock, $owner, $queue, $set) = @ARGV;
      my $n = slot_count($set);
      my @busy;
      for my $s (slot_files("$dir/slots")) {
        next unless held("$dir/slots/$s");
        my $line = "";
        if (open(my $o, "<", "$dir/slots/$s.owner")) { $line = <$o> // ""; chomp $line; }
        push @busy, "slot $s: $line";
      }
      my $excl = "";
      if (!@busy && -e $lock && held($lock, LOCK_SH)) {
        if (open(my $o, "<", $owner)) { $excl = <$o> // ""; chomp $excl; }
        $excl ||= "an older heavy-run";
      }
      if ($excl ne "") { print "exclusive: $excl\n"; }
      elsif (@busy) { printf "busy: %d/%d slots\n", scalar @busy, $n; print "$_\n" for @busy; }
      else { print "free: 0/$n slots busy\n"; }
      if (held("$dir/light/1")) {
        my $line = "";
        if (open(my $o, "<", "$dir/light/1.owner")) { $line = <$o> // ""; chomp $line; }
        print "light: $line\n";
      }
      opendir(my $d, $queue) or exit 0;
      # Heavy and light runs each keep their own order; a later entry waits
      # behind the head of its own line.
      my ($i, %head) = (0);
      for my $t (sort grep { /^\d+-\d+$/ } readdir $d) {
        open(my $h, "<", "$queue/$t") or next;
        next if flock($h, LOCK_EX | LOCK_NB);
        my $l = <$h> // ""; chomp $l;
        my $w = <$h> // ""; chomp $w; $w =~ s/^wait=//;
        my $lane = $l =~ /\[light\]$/ ? "light" : "heavy";
        $i++;
        if (defined $head{$lane}) { $w = "behind queue $head{$lane}"; } else { $head{$lane} = $i; }
        $w = "starting" if $w eq "";
        printf "queue %d: %s (waiting: %s)\n", $i, $l, $w;
      }' "$dir" "$lock" "$owner" "$queue" "$slots_set"
    ;;
esac

exclusive=0
weight="${HEAVY_RUN_WEIGHT:-1}"
light="${HEAVY_RUN_LIGHT:-0}"
sized=0
while [ $# -gt 0 ]; do
  case "$1" in
    --exclusive) exclusive=1; shift ;;
    --light) light=1; weight=1; sized=1; shift ;;
    --weight) [ $# -ge 2 ] || { usage >&2; exit 2; }; weight="$2"; sized=1; shift 2 ;;
    --weight=*) weight="${1#--weight=}"; sized=1; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || { usage >&2; exit 2; }
case "$weight" in
  '' | *[!0-9]* | 0 | 0*) echo "heavy-run: the weight must be 1-64, got '$weight'" >&2; exit 2 ;;
  *) [ "$weight" -le 64 ] || { echo "heavy-run: the weight must be 1-64, got '$weight'" >&2; exit 2; } ;;
esac
case "$light" in
  0 | 1) ;;
  *) echo "heavy-run: HEAVY_RUN_LIGHT must be 0 or 1, got '$light'" >&2; exit 2 ;;
esac
if [ "$exclusive" = 1 ]; then
  [ "$sized" = 0 ] || { echo "heavy-run: --exclusive takes no --weight or --light" >&2; exit 2; }
  weight=1 light=0
fi
[ "$light" = 0 ] || [ "$weight" = 1 ] || { echo "heavy-run: a light run has weight 1" >&2; exit 2; }
keep_orphan=0
[ "${HEAVY_RUN_KEEP_ORPHAN:-0}" = 0 ] || keep_orphan=1

case "$level" in
  '' | *[!0-9]* | 2[1-9] | [3-9][0-9] | [0-9][0-9][0-9]*) echo "heavy-run: HEAVY_RUN_NICE must be 0-20, got '$level'" >&2; exit 2 ;;
esac

priority_code='
  my ($level, @cmd) = @ARGV;
  my $current = getpriority(0, 0);
  if (!defined $current || $current > $level) {
    print STDERR "heavy-run: cannot raise priority to nice $level\n";
    exit 2;
  }
  if (($current < $level && !setpriority(0, 0, $level)) || getpriority(0, 0) != $level) {
    print STDERR "heavy-run: cannot set absolute nice level $level\n";
    exit 2;
  }
  exec {$cmd[0]} @cmd;
  print STDERR "heavy-run: cannot run $cmd[0]: $!\n";
  exit 127;
'

# Already inside a heavy-run that still holds its slot: run at once.
# A leftover daemon keeps HEAVY_RUN_HELD after the run ends, so check the flock.
if [ -n "${HEAVY_RUN_HELD:-}" ] && [ -e "$HEAVY_RUN_HELD" ] &&
  ! perl -e 'use Fcntl qw(:flock); open(my $f, "<", $ARGV[0]) or exit 0; exit(flock($f, LOCK_SH | LOCK_NB) ? 0 : 1)' "$HEAVY_RUN_HELD"; then
  exec perl -e "$priority_code" "$level" "$@"
fi

mkdir -p "$dir"
# The folder holds who runs what: keep it private to this user.
[ -O "$dir" ] || { echo "heavy-run: $dir is not owned by you" >&2; exit 2; }
chmod 700 "$dir"
mkdir -p "$(dirname "$waitlog")" 2>/dev/null || true

exec perl -e "$common_code"'
  use POSIX ();
  my ($lock, $owner, $level, $queue, $seqfile, $waitlog, $priority_code, $dir, $set, $ramp, $maxload, $exclusive, $weight, $light, $keep_orphan, @cmd) = @ARGV;
  my $t0 = time;
  my $slotdir = "$dir/slots";
  my $lanedir = "$dir/light";
  # When the caller dies, the kernel reparents this process: getppid() changes.
  my $caller = getppid();
  my ($ticket, $tfh, $name);
  # The tag at the end of the ticket line tells other waiters which line it is in.
  my $tag = $exclusive ? " [exclusive]" : $light ? " [light]" : $weight > 1 ? " [weight $weight]" : "";
  # Take the next ticket number. The ticket is written and locked under a
  # temporary name, then renamed, so no sweeper sees it before it is locked.
  my $info = sprintf("pid=%d cwd=%s cmd=%s%s", $$, $ENV{PWD} // "", join(" ", @cmd), $tag);
  my $queued = eval {
    -d $queue or mkdir $queue or die "cannot create $queue: $!\n";
    sysopen(my $sf, $seqfile, O_RDWR | O_CREAT, 0600) or die "cannot open $seqfile: $!\n";
    flock($sf, LOCK_EX) or die "cannot lock $seqfile: $!\n";
    my $max = scalar <$sf> // 0; $max = 0 unless $max =~ /^\d+/;
    if (opendir(my $qd, $queue)) {
      for my $t (readdir $qd) { $max = $1 + 0 if $t =~ /^(\d+)-\d+$/ && $1 + 0 > $max; }
      closedir $qd;
    }
    my $n = $max + 1;
    seek($sf, 0, 0); truncate($sf, 0); print $sf "$n\n"; $sf->flush;
    my $tmp = "$queue/.new-$$";
    open($tfh, ">", $tmp) or die "cannot create $tmp: $!\n";
    flock($tfh, LOCK_EX) or die "cannot lock $tmp: $!\n";
    print $tfh "$info\n";
    $tfh->flush;
    $name = sprintf("%010d-%d", $n, $$);
    rename($tmp, "$queue/$name") or do { unlink $tmp; die "cannot rename $tmp: $!\n" };
    $ticket = "$queue/$name";
    close $sf;
    1;
  };
  if (!$queued) { my $e = $@; chomp $e; print STDERR "heavy-run: queue unavailable ($e); waiting without arrival order\n"; }
  for my $d ($slotdir, $lanedir) { -d $d or mkdir $d or die "heavy-run: cannot create $d: $!\n"; }
  open(my $lfh, ">>", $lock) or do { unlink $ticket if $ticket; die "heavy-run: cannot open $lock: $!\n"; };
  chmod 0600, $lock;

  my $last_start = "$dir/last-start";
  sub busy_in { my ($d) = @_; return scalar grep { held("$d/$_") } slot_files($d); }
  # Empty when an extra run may start now, else why to wait. $ramped: heavy
  # runs are active, so wait out the ramp after the last heavy start.
  sub machine_why {
    my ($ramped) = @_;
    if ($ramped) {
      my $age = -e $last_start ? time - (stat $last_start)[9] : 1e9;
      return sprintf("ramp: last run started %ds ago, next after %ds", $age, $ramp) if $age < $ramp;
    }
    if ($maxload > 0) { my $l = load1(); return "load $l above $maxload" if $l > $maxload; }
    return pressure();
  }
  # One try to start. Returns what it took ("exclusive", or a list of
  # [slot, file handle]), or undef and the reason to wait.
  sub try_start {
    if ($exclusive) {
      return ("exclusive") if flock($lfh, LOCK_EX | LOCK_NB);
      my $k = busy_in($slotdir) + busy_in($lanedir);
      return (undef, $k ? "exclusive: waiting for $k running run(s) to end" : "exclusive: waiting for an older heavy-run");
    }
    return (undef, "an exclusive run is active") unless flock($lfh, LOCK_SH | LOCK_NB);
    my (@take, $why);
    if ($light) {
      # The lane has one slot; a light run never takes a heavy slot.
      my $fh;
      if (sysopen($fh, "$lanedir/1", O_RDWR | O_CREAT, 0600) && flock($fh, LOCK_EX | LOCK_NB)) {
        @take = ([1, $fh]);
        my $heavy = busy_in($slotdir);
        $why = machine_why($heavy > 0) if $heavy > 0;
      } else { $why = "light lane busy"; }
    } else {
      my $n = slot_count($set);
      my $need = $weight < $n ? $weight : $n;
      my ($free, $busy) = (0, 0);
      my %seen = map { $_ => 1 } slot_files($slotdir);
      $seen{$_} = 1 for 1 .. $n;
      for my $s (sort { $a <=> $b } keys %seen) {
        sysopen(my $fh, "$slotdir/$s", O_RDWR | O_CREAT, 0600) or next;
        if (flock($fh, LOCK_EX | LOCK_NB)) {
          next unless $s <= $n;
          $free++;
          push @take, [$s, $fh] if @take < $need;
        } else { $busy++; }
      }
      if ($free < $need) {
        $why = $need == 1 ? "no free slot ($busy/$n busy)" : "needs $need slots, $free free ($busy/$n busy)";
      } elsif ($busy > 0 || busy_in($lanedir) > 0) {
        $why = machine_why($busy > 0);
      }
    }
    if (defined $why && $why ne "") { @take = (); flock($lfh, LOCK_UN); return (undef, $why); }
    return (\@take);
  }
  # Rewrite in place, then cut: a reader never sees an empty first line.
  sub note_wait {
    my ($why) = @_;
    return unless $tfh;
    seek($tfh, 0, 0); print $tfh "$info\nwait=$why\n"; $tfh->flush; truncate($tfh, tell($tfh));
  }

  my ($got, $why);
  if ($ticket) {
    # A waiter stopped before it starts takes its ticket with it.
    my %signo = (TERM => 15, INT => 2, HUP => 1);
    for my $sig (keys %signo) { $SIG{$sig} = sub { unlink $ticket; exit(128 + $signo{$sig}) }; }
  }
  my $noted = "";
  while (1) {
    # Nobody waits for this run any more: give the place up.
    if (!$keep_orphan && $caller > 1 && getppid() != $caller) {
      print STDERR "heavy-run: the caller (pid $caller) is gone; dropping this waiting run\n";
      unlink $ticket if $ticket;
      exit 129;
    }
    # Heavy runs (exclusive ones too) and light runs each wait for the oldest
    # live ticket of their own line. $heavy_head is the heavy line head.
    my ($first, $heavy_head);
    if ($ticket && opendir(my $qd, $queue)) {
      my @all = readdir $qd;
      # A temp ticket nobody holds (and older than 5 s) is a leftover.
      for my $t (grep { /^\.new-\d+$/ } @all) {
        next if $t eq ".new-$$";
        next unless open(my $xf, "<", "$queue/$t");
        next if time - (stat $xf)[9] < 5;
        unlink "$queue/$t" if flock($xf, LOCK_EX | LOCK_NB);
      }
      # A ticket nobody holds is stale.
      for my $t (sort grep { /^\d+-\d+$/ } @all) {
        my $line = $info;
        if ($t ne $name) {
          open(my $xf, "<", "$queue/$t") or next;
          if (flock($xf, LOCK_EX | LOCK_NB)) { unlink "$queue/$t"; next; }
          $line = <$xf> // ""; chomp $line;
        }
        my $lt = $line =~ /\[light\]$/ ? 1 : 0;
        $heavy_head //= $line unless $lt;
        $first //= $t if $lt == $light;
        last if defined $first && (!$light || defined $heavy_head);
      }
      closedir $qd;
    }
    if (!$ticket || !defined $first || $first eq $name) {
      # A light run must not keep a queued exclusive run from ever starting.
      if ($light && defined $heavy_head && $heavy_head =~ /\[exclusive\]$/) { $why = "an exclusive run waits in the queue"; }
      else { ($got, $why) = try_start(); last if defined $got; }
      if ($why ne $noted) { note_wait($why); $noted = $why; }
    }
    select(undef, undef, undef, 0.2);
  }
  if ($ticket) { unlink $ticket; close $tfh; }
  for my $sig (qw(TERM INT HUP)) { $SIG{$sig} = "DEFAULT"; }
  my $excl = !ref $got;
  # Only heavy starts space out later starts.
  if (!$light && open(my $ls, ">", $last_start)) { close $ls; }
  my $base = $light ? $lanedir : $slotdir;
  my @slots = $excl ? () : map { $_->[0] } @$got;
  my @slotfiles = $excl ? ($lock) : map { "$base/$_" } @slots;
  my @ownerfiles = $excl ? ($owner) : map { "$base/$_.owner" } @slots;
  my $slot = $excl ? "exclusive" : $light ? "light" : $slots[0];
  $ENV{HEAVY_RUN_HELD} = $slotfiles[0];
  $ENV{HEAVY_RUN_SLOT} = $slot;
  $ENV{HEAVY_RUN_SLOT_LIST} = $excl || $light ? $slot : join(",", @slots);
  if (open(my $wl, ">>", $waitlog)) {
    my @lt = localtime;
    printf $wl "%04d-%02d-%02dT%02d:%02d:%02d waited=%d pid=%d slot=%s weight=%s lane=%s\n", $lt[5] + 1900, $lt[4] + 1, @lt[3,2,1,0], time - $t0, $$, $slot,
      $excl ? "all" : scalar @slots, $light ? "light" : "heavy";
    close $wl;
  }
  # Block signals across fork so none can kill the parent before it forwards.
  my $set_sig = POSIX::SigSet->new(POSIX::SIGTERM(), POSIX::SIGINT(), POSIX::SIGHUP());
  POSIX::sigprocmask(POSIX::SIG_BLOCK(), $set_sig);
  my $pid = fork() // die "heavy-run: cannot fork: $!\n";
  if ($pid == 0) {
    POSIX::sigprocmask(POSIX::SIG_UNBLOCK(), $set_sig);
    exec("perl", "-e", $priority_code, $level, @cmd) or die "heavy-run: cannot run $cmd[0]: $!\n";
  }
  for my $sig (qw(TERM INT HUP)) { $SIG{$sig} = sub { kill $sig, $pid }; }
  POSIX::sigprocmask(POSIX::SIG_UNBLOCK(), $set_sig);
  my @t = localtime;
  my $otag = $excl ? "" : $tag;
  for my $of (@ownerfiles) {
    if (open(my $o, ">", $of)) {
      printf $o "%02d:%02d:%02d pid=%d cwd=%s cmd=%s%s\n", @t[2,1,0], $pid, $ENV{PWD} // "", join(" ", @cmd), $otag;
      close $o;
    }
  }
  while (waitpid($pid, 0) == -1) { last unless $!{EINTR}; }
  my $st = $?;
  truncate($_, 0) for @ownerfiles;
  exit(POSIX::WIFSIGNALED($st) ? 128 + POSIX::WTERMSIG($st) : POSIX::WEXITSTATUS($st));
' "$lock" "$owner" "$level" "$queue" "$dir/seq" "$waitlog" "$priority_code" "$dir" "$slots_set" "$ramp" "$maxload" "$exclusive" "$weight" "$light" "$keep_orphan" "$@"
