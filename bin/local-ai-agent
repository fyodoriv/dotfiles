#!/bin/bash
# local-ai-agent — minimal agentic loop over Ollama's native /api/chat.
#
# Thin wrapper around lib/local-ai-agent.py. See that file for the full
# rationale (why bypass opencode + @ai-sdk/openai-compatible, speed tuning
# notes for qwen3-coder:30b on Apple Silicon).
#
# Usage:
#   local-ai-agent "<task>" [--model qwen3-coder:30b] [--max-turns N] ...
#
# Production runs get telemetry by default — a row gets appended to
# docs/audits/local-ai-runs.csv on exit (in the agent's --cwd, default
# is the current shell dir). Set LOCAL_AI_TELEMETRY=0 to skip.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB="$SCRIPT_DIR/../lib/local-ai-agent.py"
EXTRA=()
if [[ "${LOCAL_AI_TELEMETRY:-1}" != "0" ]]; then
  EXTRA+=(--telemetry)
fi
# shellcheck source=../lib/dotfiles-endpoint-paths.sh
source "$SCRIPT_DIR/../lib/dotfiles-endpoint-paths.sh"
PYTHON="$(dotfiles_resolve_python "$SCRIPT_DIR/.." "${HOME:-}")"
exec "$PYTHON" "$LIB" "${EXTRA[@]}" "$@"
