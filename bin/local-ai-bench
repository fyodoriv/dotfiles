#!/bin/bash
# local-ai-bench — short reproducible benchmark for the local-AI stack.
#
# Prints cold-load + warm latency + tok/s for qwen3-coder:30b on Ollama,
# and confirms KV cache reuse is reducing prompt-eval time across calls
# with the same system+tools prefix. Use this to catch regressions after
# Ollama upgrades or env-var changes.
#
# Usage:
#   local-ai-bench [--model MODEL] [--cold] [--backend=ollama|llamacpp]
#   local-ai-bench --idle-memory
#
# Flags:
#   --model MODEL   model to bench (default qwen3-coder:30b)
#   --cold          force-unload the model first so the first call measures
#                   true cold-load time
#   --backend       backend to use (default ollama, or llamacpp)
#   --idle-memory   report local Ollama process memory and loaded models as JSON
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/dotfiles-endpoint-paths.sh
source "$SCRIPT_DIR/../lib/dotfiles-endpoint-paths.sh"
PYTHON="$(dotfiles_resolve_python "$SCRIPT_DIR/.." "${HOME:-}")"

MODEL="qwen3-coder:30b"
COLD=false
BACKEND="ollama"
IDLE_MEMORY=false
while [ $# -gt 0 ]; do
  case "$1" in
    --model) MODEL="$2"; shift 2 ;;
    --cold) COLD=true; shift ;;
    --backend) BACKEND="$2"; shift 2 ;;
    --idle-memory) IDLE_MEMORY=true; shift ;;
    --help|-h) sed -n '2,/^set -euo/{ /^set -euo/d; p; }' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 1 ;;
  esac
done

if $IDLE_MEMORY; then
  if $COLD || [ "$BACKEND" != ollama ]; then
    echo "--idle-memory needs the Ollama backend and cannot be used with --cold" >&2
    exit 1
  fi
  exec "$PYTHON" - <<'PY'
from datetime import datetime, timezone
import json
from pathlib import PurePath
import re
import subprocess


def read_probe(args):
    try:
        return subprocess.run(args, capture_output=True, errors="replace", timeout=4)
    except (OSError, subprocess.TimeoutExpired):
        return None


def local_process_memory():
    listing = read_probe(["ps", "-axo", "pid=,ppid=,comm="])
    if listing is None or listing.returncode != 0:
        return None
    executables = {}
    workers = {}
    for line in listing.stdout.splitlines():
        fields = line.split(maxsplit=2)
        if len(fields) != 3:
            continue
        pid, parent, command = fields
        name = PurePath(command).name
        if name == "ollama":
            executables[pid] = (parent, command)
        elif name == "llama-server":
            workers[pid] = (parent, command)
    if not executables:
        return {}
    executables.update(
        {pid: entry for pid, entry in workers.items() if entry[0] in executables}
    )

    details = read_probe(
        ["ps", "-ww", "-p", ",".join(executables), "-o", "pid=,ppid=,rss=,args="]
    )
    if details is None or details.returncode != 0:
        return None
    totals = {}
    servers = set()
    child_memory = []
    for line in details.stdout.splitlines():
        fields = line.split(maxsplit=3)
        if len(fields) != 4 or not fields[2].isdigit():
            return None
        pid, parent, kib, args = fields
        entry = executables.pop(pid, None)
        if entry is None or entry[0] != parent:
            return None
        command = entry[1]
        name = PurePath(command).name
        if args.startswith(command + " "):
            args = name + " " + args[len(command) + 1:]
        if name == "llama-server":
            if re.match(r"^(?:\S*/)?llama-server(?:\s|$)", args) is None:
                return None
            child_memory.append((parent, int(kib)))
            continue
        match = re.match(r"^(?:\S*/)?ollama\s+(\S+)", args)
        if match is None:
            return None
        role = match[1]
        if role in ("serve", "start"):
            role = "serve"
            servers.add(pid)
        if role in ("serve", "runner"):
            totals[role] = totals.get(role, 0) + int(kib)
        elif role not in ("list", "ps", "run", "show", "--version", "--help"):
            return None
    if executables:
        return None
    for parent, kib in child_memory:
        if parent in servers:
            totals["runner"] = totals.get("runner", 0) + kib
    return totals


def local_models():
    result = read_probe(
        ["curl", "--disable", "--noproxy", "*", "--silent", "--fail",
         "--max-time", "2", "http://127.0.0.1:11434/api/ps"]
    )
    if result is None:
        return None, False
    if result.returncode != 0:
        return None, result.returncode == 7
    try:
        names = [model["name"] for model in json.loads(result.stdout)["models"]]
        return names if all(isinstance(name, str) for name in names) else None, False
    except (KeyError, TypeError, ValueError):
        return None, False


def memory_verdict(runner_kib):
    if runner_kib <= 500 * 1024:
        return "UNDER_THRESHOLD"
    if runner_kib <= 5000 * 1024:
        return "AT_THRESHOLD"
    return "OVER_THRESHOLD"


memory = local_process_memory()
models, refused = local_models()
runner_kib = serve_kib = None
verdict = "UNKNOWN"
if memory:
    serve_kib = memory.get("serve", 0)
    if "runner" in memory or not models:
        runner_kib = memory.get("runner", 0)
        verdict = memory_verdict(runner_kib)
elif memory == {} and refused:
    runner_kib = serve_kib = 0
    verdict = "NO_OLLAMA"
    models = []
print(json.dumps({
    "ts": datetime.now(timezone.utc).isoformat(),
    "ollama_runner_rss_mb": None if runner_kib is None else runner_kib / 1024,
    "ollama_serve_rss_mb": None if serve_kib is None else serve_kib / 1024,
    "loaded_models": models,
    "verdict": verdict,
}))
PY
fi

if [ "$BACKEND" = "llamacpp" ]; then
  # Probe for llama-server binary
  if ! command -v llama-server >/dev/null 2>&1 && ! [ -x "/usr/local/bin/llama-server" ]; then
    echo "llama-server not installed (skip: brew install llama.cpp OR git clone https://github.com/ggml-org/llama.cpp && make -j)" >&2
    exit 1
  fi

  # Use llama.cpp endpoint
  "$PYTHON" - "$MODEL" <<'PY'
import json, sys, time, urllib.request

MODEL = sys.argv[1]
LLAMACPP = "http://127.0.0.1:8080"
SYSTEM = (
    "You are a shell agent. Always call the bash tool with a single "
    "concrete command. Never explain."
)
TOOLS = [{
    "type": "function",
    "function": {
        "name": "bash",
        "description": "Run a bash command.",
        "parameters": {
            "type": "object",
            "properties": {
                "command": {"type": "string", "description": "cmd"},
            },
            "required": ["command"],
        },
    },
}]


def call(messages, num_predict=50):
    body = json.dumps({
        "model": MODEL,
        "messages": messages,
        "tools": TOOLS,
        "stream": False,
        "keep_alive": "24h",
        "options": {"temperature": 0, "num_ctx": 8192, "num_predict": num_predict},
    }).encode()
    req = urllib.request.Request(
        f"{LLAMACPP}/v1/chat/completions",
        data=body,
        headers={"Content-Type": "application/json"},
    )
    t0 = time.time()
    with urllib.request.urlopen(req, timeout=120) as resp:
        d = json.loads(resp.read())
    return time.time() - t0, d


print(f"model:       {MODEL}")
print(f"backend:     llamacpp @ {LLAMACPP}")
print()
print(f"{'#':>2}  {'wall_ms':>8}  {'prompt_eval_ms':>14}  {'eval_ms':>8}  {'eval_count':>10}  {'tok/s':>7}")
print(f"{'─'*2:>2}  {'─'*8:>8}  {'─'*14:>14}  {'─'*8:>8}  {'─'*10:>10}  {'─'*7:>7}")
for i, q in enumerate([
    "What is the date?",
    "What is the hostname?",
    "What is uname?",
    "How many .md files are in this directory?",
], 1):
    elapsed, d = call([
        {"role": "system", "content": SYSTEM},
        {"role": "user", "content": q},
    ])
    prompt_ms = (d.get("prompt_eval_duration", 0) or 0) / 1e6
    eval_ms = (d.get("eval_duration", 0) or 0) / 1e6
    eval_count = d.get("eval_count", 0)
    tps = (eval_count * 1000 / eval_ms) if eval_ms else 0
    print(f"{i:>2}  {elapsed*1000:8.0f}  {prompt_ms:14.0f}  {eval_ms:8.0f}  {eval_count:10}  {tps:7.0f}")

print()
print("Interpretation:")
print("  - Call #1 prompt_eval_ms is the cold prefix processing time.")
print("  - Calls #2-N prompt_eval_ms drops to ~50ms or less => KV cache")
print("    reuse is working (system prompt + tools prefix reused).")
print("  - eval_ms / eval_count should sit around 85 tok/s on M3 Max.")
PY
  exit 0
fi

# Default Ollama backend. OLLAMA_HOST lets the bats fixture point us at
# a mock server on a fresh port (default real Ollama runs on :11434).
OLLAMA_HOST="${OLLAMA_HOST:-http://127.0.0.1:11434}"
if ! curl -sf -m 2 "$OLLAMA_HOST/v1/models" >/dev/null 2>&1; then
  echo "Ollama is not reachable on $OLLAMA_HOST — start it first (launchctl bootstrap …com.dotfiles.ollama)." >&2
  exit 1
fi

if $COLD; then
  echo "→ unloading $MODEL (true cold-load measurement)"
  curl -s -X POST "$OLLAMA_HOST/api/generate" \
    -d "{\"model\":\"$MODEL\",\"keep_alive\":0}" >/dev/null
  sleep 2
fi

"$PYTHON" - "$MODEL" "$OLLAMA_HOST" <<'PY'
import json, sys, time, urllib.request

MODEL = sys.argv[1]
OLLAMA = sys.argv[2]
SYSTEM = (
    "You are a shell agent. Always call the bash tool with a single "
    "concrete command. Never explain."
)
TOOLS = [{
    "type": "function",
    "function": {
        "name": "bash",
        "description": "Run a bash command.",
        "parameters": {
            "type": "object",
            "properties": {
                "command": {"type": "string", "description": "cmd"},
            },
            "required": ["command"],
        },
    },
}]


def call(messages, num_predict=50):
    body = json.dumps({
        "model": MODEL,
        "messages": messages,
        "tools": TOOLS,
        "stream": False,
        "keep_alive": "24h",
        "options": {"temperature": 0, "num_ctx": 8192, "num_predict": num_predict},
    }).encode()
    req = urllib.request.Request(
        f"{OLLAMA}/api/chat",
        data=body,
        headers={"Content-Type": "application/json"},
    )
    t0 = time.time()
    with urllib.request.urlopen(req, timeout=120) as resp:
        d = json.loads(resp.read())
    return time.time() - t0, d


print(f"model:       {MODEL}")
print(f"backend:     ollama @ {OLLAMA}")
print()
print(f"{'#':>2}  {'wall_ms':>8}  {'prompt_eval_ms':>14}  {'eval_ms':>8}  {'eval_count':>10}  {'tok/s':>7}")
print(f"{'─'*2:>2}  {'─'*8:>8}  {'─'*14:>14}  {'─'*8:>8}  {'─'*10:>10}  {'─'*7:>7}")
for i, q in enumerate([
    "What is the date?",
    "What is the hostname?",
    "What is uname?",
    "How many .md files are in this directory?",
], 1):
    elapsed, d = call([
        {"role": "system", "content": SYSTEM},
        {"role": "user", "content": q},
    ])
    prompt_ms = (d.get("prompt_eval_duration", 0) or 0) / 1e6
    eval_ms = (d.get("eval_duration", 0) or 0) / 1e6
    eval_count = d.get("eval_count", 0)
    tps = (eval_count * 1000 / eval_ms) if eval_ms else 0
    print(f"{i:>2}  {elapsed*1000:8.0f}  {prompt_ms:14.0f}  {eval_ms:8.0f}  {eval_count:10}  {tps:7.0f}")

print()
print("Interpretation:")
print("  - Call #1 prompt_eval_ms is the cold prefix processing time.")
print("  - Calls #2-N prompt_eval_ms drops to ~50ms or less => KV cache")
print("    reuse is working (system prompt + tools prefix reused).")
print("  - eval_ms / eval_count should sit around 85 tok/s on M3 Max.")
PY
