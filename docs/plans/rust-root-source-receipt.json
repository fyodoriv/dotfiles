      "path": "macos-trackpad.sh",
      "line": 31,
      "text": "  sed 's/#.*//' \"$skip_file\" | awk -v d=\"$1\" -v k=\"$2\" '$1 == d { $1 = \"\"; sub(/^ +/, \"\"); sub(/ +$/, \"\"); if ($0 == k) found = 1 } END { exit !found }'"
