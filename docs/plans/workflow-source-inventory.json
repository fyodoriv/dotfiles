      "path": ".github/workflows/ci.yml",
      "blob": "fc701e508475c62924a804a74adec6ffbc309bf3",
      "line": 117,
      "content": [
        "        run: |",
        "          # Measure zsh startup time (interactive + login shell)",
        "          # Runs 5 iterations and reports the median",
        "          times=()",
        "          for i in $(seq 1 5); do",
        "            ms=$( { TIMEFORMAT='%3R'; time zsh -ic exit; } 2>&1 | tail -1 )",
        "            # Convert seconds to milliseconds",
        "            ms_int=$(echo \"$ms * 1000\" | bc | cut -d. -f1)",
        "            times+=(\"$ms_int\")",
        "            echo \"  Run $i: ${ms_int}ms\"",
        "          done",
        "          # Sort and pick median (3rd of 5)",
        "          IFS=$'\\n' sorted=($(printf '%s\\n' \"${times[@]}\" | sort -n)); unset IFS",
        "          median=${sorted[2]}",
        "          echo \"\"",
        "          echo \"Median shell startup: ${median}ms\"",
        "          echo \"## Shell Startup Time\" >> \"$GITHUB_STEP_SUMMARY\"",
        "          echo \"Median: **${median}ms** (threshold: 200ms)\" >> \"$GITHUB_STEP_SUMMARY\"",
        "          # Fail if median exceeds threshold (200ms for CI \u2014 runners are slower)",
        "          threshold=200",
        "          if [ \"$median\" -gt \"$threshold\" ]; then",
        "            echo \"::error::Shell startup ${median}ms exceeds ${threshold}ms threshold\"",
        "            exit 1",
        "          fi",
        "          echo \"OK (under ${threshold}ms threshold)\"",
        ""
      ]
    },
