      "content": [
        "        run: |",
        "          body_file=\"$(mktemp)\"",
        "          {",
        "            echo \"## Monthly Brew Audit \u2014 $(date +%Y-%m-%d)\"",
        "            echo",
        "            echo \"The following Brewfile entries need attention:\"",
        "            echo",
        "            printf '%s\\n' \"$AUDIT_LIST\"",
        "            echo",
        "            echo \"The audit checks Homebrew metadata and livecheck without requiring packages to be installed on the runner.\"",
        "            echo",
        "            echo \"This issue is auto-generated by the brew-audit workflow.\"",
        "          } > \"$body_file\"",
        "",
        "          # Check if an open issue already exists",
        "          existing=$(gh issue list --label \"brew-audit\" --state open --json number --jq '.[0].number // empty')",
        "          if [ -n \"$existing\" ]; then",
        "            echo \"Updating existing issue #$existing\"",
        "            gh issue comment \"$existing\" --body-file \"$body_file\"",
        "          else",
        "            gh issue create \\",
        "              --title \"Brew audit: manifest problems ($(date +%Y-%m))\" \\",
        "              --label \"brew-audit\" \\",
        "              --body-file \"$body_file\"",
        "          fi",
        ""
      ]
    },
