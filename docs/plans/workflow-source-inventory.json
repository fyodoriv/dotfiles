      ]
    },
    {
      "path": ".github/workflows/ci.yml",
      "blob": "fc701e508475c62924a804a74adec6ffbc309bf3",
      "line": 183,
      "content": [
        "        run: |",
        "          if [ -f coverage/bats/coverage.json ]; then",
        "            pct=$(jq -r '.percent_covered' coverage/bats/coverage.json)",
        "            floor=$(sed -n '1p' .shell-coverage-floor)",
        "            echo \"percent=$pct\" >> \"$GITHUB_OUTPUT\"",
        "            echo \"## Shell Script Coverage\" >> \"$GITHUB_STEP_SUMMARY\"",
        "            echo \"Line coverage: **${pct}%**\" >> \"$GITHUB_STEP_SUMMARY\"",
        "            echo \"Coverage floor: **${floor}%**\" >> \"$GITHUB_STEP_SUMMARY\"",
        "            echo \"\"",
        "            .github/scripts/check-shell-coverage.sh coverage/bats/coverage.json .shell-coverage-floor",
        "          else",
        "            echo \"percent=unknown\" >> \"$GITHUB_OUTPUT\"",
        "            echo \"## Shell Script Coverage\" >> \"$GITHUB_STEP_SUMMARY\"",
        "            echo \"Coverage report not generated (dotfiles-coverage may have failed)\" >> \"$GITHUB_STEP_SUMMARY\"",
        "            echo \"Coverage report not found\"",
        "            exit 1",
        "          fi"
      ]
