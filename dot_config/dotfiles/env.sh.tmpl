# Generated by chezmoi — do not edit manually.
# Override repos_dir via: chezmoi edit-config
export DOTFILES_REPOS_DIR="$HOME/{{ .repos_dir }}"
export DOTFILES_DIR="$HOME/{{ .dotfiles_dir }}"
# Endpoint-security shims (curl/jq/grep/find) must win PATH in every shell —
# interactive, non-interactive, IDE agents, and chezmoi scripts.
export PATH="$DOTFILES_DIR/bin:$HOME/.local/bin:${PATH:-}"

# Non-interactive bash/sh scripts (not bash -c) source this via BASH_ENV/ENV.
# zsh -c loads ~/.zshenv instead — preferred for IDE agent subshells.
export BASH_ENV="$HOME/.config/dotfiles/bash-env.sh"
export ENV="$HOME/.config/dotfiles/bash-env.sh"

# Per-agent agent-browser daemon identity — must run in non-interactive zsh
# (Cursor/Claude agent tool shells load ~/.zshenv but not ~/.zshrc.ai-tools).
if [ -f "$DOTFILES_DIR/lib/agent-browser-session-env.sh" ]; then
  # shellcheck source=/dev/null
  . "$DOTFILES_DIR/lib/agent-browser-session-env.sh"
fi
