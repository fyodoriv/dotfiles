root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{kt,kts,java,gradle}]
indent_size = 4

[*.{py,pyi}]
indent_size = 4
max_line_length = 120

[*.rs]
indent_size = 4

[*.go]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[*.sh]
indent_size = 2

[*.{css,scss}]
indent_size = 2

[Makefile]
indent_style = tab
