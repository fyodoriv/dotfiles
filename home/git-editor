#!/bin/bash
set -euo pipefail

# Non-interactive shell (e.g. IDE agent, CI) — accept the message as-is
if [ ! -t 0 ] && [ ! -t 1 ]; then
  exit 0
fi

# Respect user's $EDITOR if explicitly set
if [ -n "${EDITOR:-}" ] && command -v "$EDITOR" &>/dev/null; then
  exec "$EDITOR" "$@"
fi

if command -v cursor &>/dev/null; then
  exec cursor --wait "$@"
fi

if command -v code &>/dev/null; then
  exec code --wait "$@"
fi

exec nano "$@"
