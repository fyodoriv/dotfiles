# ~/.zshenv.secrets — enterprise and secret env vars (never tracked in git)
#
# Copy this file to ~/.zshenv.secrets and uncomment/edit the vars you need.
# It is sourced automatically by ~/.zshenv on every shell startup.

# ═══════════════════════════════════════════════════════════════════
# Generic (all users)
# ═══════════════════════════════════════════════════════════════════

# GitHub token — needed for GitHub MCP server and API access.
# Option 1 (recommended): derive from gh CLI auth — stays in sync, never stale:
# if command -v gh &>/dev/null && [ -z "$GITHUB_TOKEN" ]; then
#   export GITHUB_TOKEN="$(gh auth token -h github.com 2>/dev/null)"
# fi
# Option 2: hardcode a PAT (github.com → Settings → Developer settings → Tokens)
# export GITHUB_TOKEN='your-github-pat'

# --- AI Tools (only if use_ai_tools: true in chezmoi config) ---

# Anthropic API key — needed for Claude SDK, and minsky
# How to get: console.anthropic.com → Settings → API Keys → Create Key
# export ANTHROPIC_API_KEY='<your-anthropic-api-key>'

# --- MCP Server tokens (used by agentbrew-managed MCP servers in ~/.claude.json) ---

# Slack MCP server — needed for slack MCP integration
# How to get bot token: api.slack.com → Your Apps → Select app → OAuth & Permissions → Bot User OAuth Token (xoxb-...)
# How to get user token: api.slack.com → Your Apps → Select app → OAuth & Permissions → User OAuth Token (xoxp-...)
# export SLACK_BOT_TOKEN='xoxb-your-slack-bot-token'
# export SLACK_USER_TOKEN='xoxp-your-slack-user-token'

# Atlassian (Jira/Confluence) MCP server — needed for atlassian MCP integration
# How to get: id.atlassian.com → Security → Create and manage API tokens
# export JIRA_URL='https://your-company.atlassian.net'
# export JIRA_USERNAME='your-email@company.com'
# export JIRA_API_TOKEN='your-atlassian-api-token'

# --- Path Overrides ---

# Override the repos base directory (default: ~/apps)
# Used by: dotfiles-doctor modules, check-all, morning, cleanup, git-maintain
# Set this if your repos live outside ~/apps (e.g. ~/projects, ~/src)
# export DOTFILES_REPOS_DIR="$HOME/projects"

# --- Travel hacking toolkit (~/apps/travel) ---

# Ignav — flight search REST API (1,000 free requests, no credit card)
# How to get: https://ignav.com/signup → Dashboard → API Key
# export IGNAV_API_KEY='ignav_...'

# SerpAPI — Google Hotels + Google Flights scraping (100 free searches/month)
# How to get: https://serpapi.com/users/sign_up → Dashboard → API Key
# export SERPAPI_API_KEY='...'

# RapidAPI — Booking.com Live + Google Flights Live (free tier ~100 req/month)
# How to get: https://rapidapi.com/auth/sign-up → Subscribe to: apiheya/booking-live-api + apiheya/google-flights-live-api
# export RAPIDAPI_KEY='...'

# Seats.aero — award flight availability across 27 mileage programs (Pro subscription required)
# How to get: https://seats.aero/settings → API tab
# export SEATS_AERO_API_KEY='...'

# LiteAPI — live hotel rates and booking (needs API key)
# How to get: https://app.liteapi.travel/
# export LITEAPI_API_KEY='...'

# AwardWallet Business — loyalty program balances across all programs (Business account required)
# How to get: https://business.awardwallet.com/profile/api
# export AWARDWALLET_API_KEY='...'
# export AWARDWALLET_USER_ID='...'

# Credit card portal credentials (for Chase Travel + Amex Travel portal price search via agent-browser)
# export CHASE_USERNAME='...'
# export CHASE_PASSWORD='...'
# export AMEX_USERNAME='...'
# export AMEX_PASSWORD='...'

# Airline loyalty login (for American Airlines balance check via agent-browser)
# export AA_USERNAME='...'
# export AA_PASSWORD='...'

# Southwest (for fare class breakdown and points pricing via agent-browser/Docker)
# export SW_USERNAME='...'
# export SW_PASSWORD='...'

# ═══════════════════════════════════════════════════════════════════
# Organization-specific extensions
# ═══════════════════════════════════════════════════════════════════
#
# If your organization ships an overlay repo (e.g. a private overlay
# alongside this dotfiles checkout), put org-specific secrets there.
# The overlay's example file is typically `<overlay>/zshenv.<org>.example`.
# The overlay's apply step is responsible for sourcing those into
# ~/.zshenv.secrets if you want them merged into your shell env.
