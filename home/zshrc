# Quick project opener — cd + list
p() {
  local repos="${DOTFILES_REPOS_DIR:-$HOME/apps}"
  local dir="$repos/${1}"
  if [ -d "$dir" ]; then
    cd "$dir" && ll
  else
    echo "Projects:" && ls "$repos"
  fi
}

# Git branch cleanup — delete merged local branches
gclean() {
  git branch --merged | grep -v '\*\|main\|master' | xargs -n 1 git branch -d 2>/dev/null
  echo "Cleaned merged branches"
}

# Quick grep in project
search() { rg --color=always --line-number --no-heading "$@" | fzf --ansi; }

