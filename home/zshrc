typeset -U PATH

# ── Zsh plugins (deferred — load after first prompt for faster startup) ──
# Registers a one-shot precmd hook. The first prompt renders fast; plugins
# load before the second prompt (which is effectively instant since the user
# is still reading the first prompt output). Saves ~75ms from initial display.
_load_plugins() {
  add-zsh-hook -d precmd _load_plugins
  unfunction _load_plugins 2>/dev/null

  # Syntax highlighting (must be before autosuggestions)
  local fsh="/opt/homebrew/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"
  [ ! -f "$fsh" ] && fsh="/usr/local/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"
  [ ! -f "$fsh" ] && fsh="/opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  [ ! -f "$fsh" ] && fsh="/usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  [ -f "$fsh" ] && source "$fsh"

  # Autosuggestions
  local as="/opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [ ! -f "$as" ] && as="/usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [ -f "$as" ] && source "$as"

  # History substring search
  local hs="/opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh"
  [ ! -f "$hs" ] && hs="/usr/local/share/zsh-history-substring-search/zsh-history-substring-search.zsh"
  if [ -f "$hs" ]; then
    source "$hs"
    bindkey '^[[A' history-substring-search-up
    bindkey '^[[B' history-substring-search-down
    bindkey -M emacs '^P' history-substring-search-up
    bindkey -M emacs '^N' history-substring-search-down
    HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND="bg=#44475a,fg=#50fa7b,bold"
    HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND="bg=#44475a,fg=#ff5555,bold"
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _load_plugins

