# ── Dev functions ────────────────────────────────────────────────────
killport() { lsof -ti:"$1" | xargs kill -9 2>/dev/null && echo "Killed port $1" || echo "Nothing on port $1"; }
serve() { npx -y serve -l "${1:-3000}" .; }
mkcd() { mkdir -p "$1" && cd "$1"; }
