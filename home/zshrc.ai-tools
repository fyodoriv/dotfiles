# ── AI agent tooling (opt-in: use_ai_tools: true in chezmoi config) ──
# This file is sourced by ~/.zshrc when deployed by chezmoi with
# use_ai_tools enabled. It contains Devin CLI shortcuts, AI model
# defaults, agent-browser tuning, and related helpers.

# ── Secrets (loaded from macOS Keychain at shell startup) ────────────
# Exported eagerly so MCP servers launched by GUI apps (Cursor, Claude Desktop)
# inherit the token. The keychain lookup is fast (~5ms).
export JIRA_PERSONAL_TOKEN="${JIRA_PERSONAL_TOKEN:-$(security find-generic-password -a "$(whoami)" -s jira-personal-token -w 2>/dev/null)}"

jira-token() {
  echo "$JIRA_PERSONAL_TOKEN"
}

# ── AI model defaults ────────────────────────────────────────────────
# Devin reads this as a CLI/env default; ~/.config/devin/config.json also pins
# the same model so non-interactive sessions inherit it without a shell.
#
# Devin uses GPT-5.5 XHigh Thinking Fast by default — see
# AGENTS.md § Model Configuration for the source-level pin and rationale.
export DEVIN_MODEL="gpt-5-5-xhigh-priority"
export WAVEFRONT_API_KEY="${WAVEFRONT_API_KEY:-}"  # stub — prevents Devin CLI startup error from shared Windsurf MCP config

# ── Minsky per-machine agent config ──────────────────────────────────
# Controls which CLI minsky's tick-loop spawns for cloud iterations.
# Default: "claude" (claude --print). Set to "devin" to use Devin CLI
# (devin --print --model <DEVIN_MODEL> --permission-mode dangerous).
# The cloud-agent env var is the per-machine preference; the tick-loop
# reads it at startup alongside MINSKY_LOCAL_AGENT for local iterations.
export MINSKY_CLOUD_AGENT="devin"
export MINSKY_CLOUD_AGENT_MODEL="${DEVIN_MODEL}"

# ── agent-browser performance ─────────────────────────────────────────
# Keep daemon alive 10 min between commands (avoids cold start per invocation)
export AGENT_BROWSER_IDLE_TIMEOUT_MS=600000
# Fail faster: 15s vs 25s default — if a page hasn't loaded, something is wrong
export AGENT_BROWSER_DEFAULT_TIMEOUT=15000
# Per-agent daemon identity with attach-first browser policy.
#
# Background: agent-browser supports `--session <name>` (env:
# AGENT_BROWSER_SESSION) which spawns a separate daemon AND a separate
# Chrome instance with its own user-data-dir when it is not attached to
# an existing CDP endpoint.
#
# Problem: every agent-browser caller defaulted to session "default", so
# Devin / Claude Code / Cursor / Windsurf agents running concurrently on
# the same box ended up driving the same Chrome and stealing each other's
# active tab mid-task. Real collision observed 2026-05-12.
#
# Fix: when this shell is inside a known agent context, set
# AGENT_BROWSER_SESSION to a stable, agent-unique daemon name, then let
# the wrapper below attach that daemon to the managed Chrome on port
# 9223 by default. Explicit user-supplied AGENT_BROWSER_SESSION values
# remain the escape hatch for genuinely isolated non-SSO work.
#
# Detection mirrors `bin/gh`'s `_gh_wrapper_is_agent_context` so the
# agent-context surface is consistent across wrappers. Operator (non-agent)
# shells leave AGENT_BROWSER_SESSION unset, keep the "default" session,
# and continue to use the fast --cdp 9223 shared-Chrome path below.
# Shared implementation: lib/agent-browser-session-env.sh (also sourced from
# ~/.config/dotfiles/env.sh for non-interactive agent subprocesses).
if [ -f "${DOTFILES_DIR:-$HOME/apps/tooling/dotfiles}/lib/agent-browser-session-env.sh" ]; then
  # shellcheck source=/dev/null
  . "${DOTFILES_DIR:-$HOME/apps/tooling/dotfiles}/lib/agent-browser-session-env.sh"
fi

# Wrap `agent-browser` to auto-connect operators and implicit agent
# sessions to the persistent Chrome on port 9223 (started at login by
# com.dotfiles.agent-browser-chrome launchagent — see
# modules/agent-browser/). Eliminates the 5-6s Chrome cold-start every
# time agent-browser respawns its own Chrome via Playwright.
#
# Measured (Chrome 147, macOS): navigate example.com from a closed daemon
# is 6.1s on the cold path, ~0.4s via --cdp 9223 — ~16x speedup.
#
# The "default" session and dotfiles-assigned implicit agent sessions use
# this shared-Chrome fast path. A caller-provided AGENT_BROWSER_SESSION
# remains isolated for non-SSO work that genuinely needs separate cookies.
#
# Falls back to default behavior when port 9223 isn't responsive (Chrome
# crashed, launchagent disabled, etc.). Opt out per-invocation by setting
# AGENT_BROWSER_NO_AUTO_CDP=1.
#
# The TCP probe via /dev/tcp is sub-millisecond. The subshell opens fd 3
# to localhost:9223 and exits, so fd 3 closes with that subshell; no
# cleanup is needed in the parent shell.
_dotfiles_agent_browser_should_restore_focus() {
  [ -z "${AGENT_BROWSER_ALLOW_FOCUS:-}" ] || return 1
  local _ab_arg
  for _ab_arg in "$@"; do
    [ "$_ab_arg" = "--headed" ] && return 1
  done
  return 0
}

agent-browser() {
  local _ab_session="${AGENT_BROWSER_SESSION:-default}"
  local _ab_cdp_ready=0
  local _ab_dotfiles_dir="${DOTFILES_DIR:-$HOME/apps/tooling/dotfiles}"
  if [ ! -x "$_ab_dotfiles_dir/bin/agent-browser-singleton-preflight" ]; then
    _ab_dotfiles_dir="$HOME/apps/dotfiles"
  fi
  local _ab_focus_log="$_ab_dotfiles_dir/bin/dotfiles-restore-focus-after-chrome"
  if [ "${_DOTFILES_AGENT_BROWSER_TEST_CDP_READY:-}" = "1" ] || (exec 3<>/dev/tcp/127.0.0.1/9223) 2>/dev/null; then
    _ab_cdp_ready=1
  fi
  local _ab_singleton_preflight="$_ab_dotfiles_dir/bin/agent-browser-singleton-preflight"
  if [ -n "${AGENT_BROWSER_PROFILE:-}" ]; then
    if [ -x "$_ab_singleton_preflight" ]; then
      command "$_ab_singleton_preflight" --profile "$AGENT_BROWSER_PROFILE" -- "$@"
      _ab_rc=$?
      if _dotfiles_agent_browser_should_restore_focus "$@" && [ -x "$_ab_focus_log" ]; then
        DOTFILES_FOCUS_STEAL_CALLER=agent-browser-singleton "$_ab_focus_log" --log-if-chrome-frontmost || true
      fi
      return "$_ab_rc"
    fi
    local _ab_managed_profile="${AGENT_BROWSER_PROFILE%/}"
    local _ab_tilde_prefix
    _ab_tilde_prefix="$(printf '\176/')"
    case "$_ab_managed_profile" in
      "~") _ab_managed_profile="$HOME" ;;
      "$_ab_tilde_prefix"*) _ab_managed_profile="$HOME/${_ab_managed_profile#"$_ab_tilde_prefix"}" ;;
      '$HOME') _ab_managed_profile="$HOME" ;;
      '$HOME/'*) _ab_managed_profile="$HOME/${_ab_managed_profile#\$HOME/}" ;;
    esac
    case "$_ab_managed_profile" in
      "$HOME/.agent-browser/chrome-profile"|"$HOME/.agent-browser/debug-profile"|"$HOME/.agent-browser/tooling-profile")
        echo "Refusing to launch Chrome against launchd-owned AGENT_BROWSER_PROFILE without singleton preflight: $AGENT_BROWSER_PROFILE" >&2
        return 2
        ;;
    esac
  fi
  local _ab_rc=0
  if [ -z "${AGENT_BROWSER_NO_AUTO_CDP:-}" ] \
    && [ "$_ab_cdp_ready" = "1" ] \
    && { [ "$_ab_session" = "default" ] || [ "${_DOTFILES_AGENT_BROWSER_IMPLICIT_SESSION:-}" = "1" ]; }; then
    # Never pass AGENT_BROWSER_ARGS on the CDP attach path — off-screen window
    # flags on launchd Chromes cause flash-then-quit loops when tabs close.
    env -u AGENT_BROWSER_ARGS command agent-browser --cdp 9223 "$@" || _ab_rc=$?
  else
    # Cold-path only: headless avoids focus steal. Use --headed for visible SSO.
    AGENT_BROWSER_ARGS="${AGENT_BROWSER_ARGS:---headless=new}" \
      command agent-browser "$@" || _ab_rc=$?
  fi
  if _dotfiles_agent_browser_should_restore_focus "$@" && [ -x "$_ab_focus_log" ]; then
    DOTFILES_FOCUS_STEAL_CALLER=agent-browser "$_ab_focus_log" --log-if-chrome-frontmost || true
  fi
  return "$_ab_rc"
}

# WebStorm fast shells keep browser routing, but skip aliases and other
# interactive helpers. `dotfiles-full-shell` restores those on demand.
if [[ "${DOTFILES_JETBRAINS_FAST_SHELL:-0}" == "1" ]]; then
  return 0
fi

# ── PATH: AI tools ──────────────────────────────────────────────────
# Windsurf IDE CLI
[ -d "$HOME/.codeium/windsurf/bin" ] && export PATH="$HOME/.codeium/windsurf/bin:$PATH"

# ── Devin CLI: power user shortcuts ──────────────────────────────────
# The devin wrapper (~/.local/bin/devin) keeps terminal titles useful without
# using caffeinate, so macOS update restarts are not blocked by agent sessions.
alias dv='devin'
alias dvp='devin -p --'
alias dvc='devin -c'
alias dvr='devin --resume'     # resume last session
alias dvl='devin --list'       # list recent sessions

# dvb — Devin bypass mode. The one-shot launcher operators reach for when
# they want maximum agent capability with no permission prompts:
#   - --model gpt-5-5-xhigh-priority GPT-5.5 XHigh Thinking Fast
#                                    per AGENTS.md § Model Configuration.
#   - --permission-mode dangerous    Auto-approves every tool — no prompts.
#                                    Devin's own default is "auto" which
#                                    still prompts on writes.
#
# Why pin --model explicitly even though ~/.config/devin/config.json
# already pins the same value: env-var leaks (ANTHROPIC_MODEL, DEVIN_MODEL),
# accidental config edits, or a stale value persisting from before the
# GPT-5.5 default-model change can all silently
# override the file-level default. Passing the flag every time means dvb
# is the canonical "I want bypass + GPT-5.5 XHigh Thinking Fast" entry point regardless
# of any in-flight env-var or config drift.
#
# Why pre-export GITHUB_TOKEN: Devin imports MCP configs from peer agents
# (~/.cursor/mcp.json, ~/.claude.json, …) and strict-interpolates
# ${GITHUB_TOKEN}. A bare placeholder with an unset env var aborts Devin's
# WHOLE MCP load — every tool (playwright, context7, etc.), not just
# github. `~/.zshenv.company.secrets` sets the var at parent-shell init
# time, but `gh auth login` may have happened after this shell started,
# leaving GITHUB_TOKEN empty for the child Devin. Defensive re-derivation
# closes that gap. Pinned by tests/zshrc-ai-tools-dvb.bats § 6 cases.
#
# Note: the MARATHON=N delegation to taskgrind that pre-#124-dvb supported
# is gone — taskgrind was deprecated in PR #124. Operators who want
# multi-session loops should use minsky's daemon mode directly
# (`minsky run`) instead of layering it under dvb.
_DV_START_EPOCH=""

_dv_show_duration() {
  if [[ -n "$_DV_START_EPOCH" ]]; then
    local elapsed=$(( $(date +%s) - _DV_START_EPOCH ))
    local h=$((elapsed / 3600)) m=$(( (elapsed % 3600) / 60 ))
    if [[ $h -gt 0 ]]; then
      echo "⏱  Session duration: ${h}h${m}m"
    else
      echo "⏱  Session duration: ${m}m"
    fi
  fi
}

dvb() {
  _DV_START_EPOCH=$(date +%s)

  if [[ -z "${GITHUB_TOKEN:-}" ]] && command -v gh &>/dev/null; then
    export GITHUB_TOKEN="$(gh auth token 2>/dev/null)"
  fi

  devin --model gpt-5-5-xhigh-priority --permission-mode dangerous -- "$@"
  _dv_show_duration
}

# ── tmux-wrapped agent launchers ─────────────────────────────────────
# Per the agent-tmux convention (rusty-art/claude-tmux, amux, agentdock):
# launching an AI agent inside tmux makes the process survive terminal
# close, ssh disconnect, Ghostty/iTerm quit, and macOS sleep cycles
# (when Amphetamine/pmset prevents lid-close sleep). The plain `dv`,
# `cc`, `curr` aliases still launch the agent in the foreground for
# quick one-shot work; the `t*` variants persist.
#
# Session naming: `<agent>-<cwd-basename>`. Re-running the same alias
# in the same repo attaches to the live session instead of creating a
# new one. Detach with `Ctrl-a d` (prefix is `Ctrl-a` per ~/.tmux.conf).
alias tdv='agent-tmux devin'                              # Devin CLI in tmux
alias tdvr='agent-tmux devin --resume'                    # Resume last Devin session in tmux
alias tdvp='agent-tmux devin --permission-mode dangerous --'  # Devin with prompt in tmux
alias tcc='agent-tmux claude'                             # Claude Code in tmux
alias tcur='agent-tmux cursor-agent'                      # Cursor Agent in tmux
alias tcdx='agent-tmux codex'                             # Codex CLI in tmux
alias agents='agent-tmux --ls'                            # List active agent-tmux sessions

# ── tmux-wrapped agent launchers ─────────────────────────────────────
# Per the agent-tmux convention (rusty-art/claude-tmux, amux, agentdock):
# launching an AI agent inside tmux makes the process survive terminal
# close, ssh disconnect, Ghostty/iTerm quit, and macOS sleep cycles
# (when Amphetamine/pmset prevents lid-close sleep). The plain `dv`,
# `cc`, `curr` aliases still launch the agent in the foreground for
# quick one-shot work; the `t*` variants persist.
#
# Session naming: `<agent>-<cwd-basename>`. Re-running the same alias
# in the same repo attaches to the live session instead of creating a
# new one. Detach with `Ctrl-a d` (prefix is `Ctrl-a` per ~/.tmux.conf).
alias tdv='agent-tmux devin'                              # Devin CLI in tmux
alias tdvr='agent-tmux devin --resume'                    # Resume last Devin session in tmux
alias tdvp='agent-tmux devin --permission-mode dangerous --'  # Devin with prompt in tmux
alias tcc='agent-tmux claude'                             # Claude Code in tmux
alias tcur='agent-tmux cursor-agent'                      # Cursor Agent in tmux
alias tcdx='agent-tmux codex'                             # Codex CLI in tmux
alias agents='agent-tmux --ls'                            # List active agent-tmux sessions

# devin-fleet — launch N parallel Devin agents in tmux
# Usage: devin-fleet "task 1" "task 2" "task 3"
devin-fleet() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: devin-fleet \"task 1\" \"task 2\" ..."; return 1
  fi
  local session="devin-fleet-$$"
  tmux new-session -d -s "$session" -n "devin-0" "devin --permission-mode dangerous -- $(printf '%q' "$1")"
  shift
  local i=1
  for task in "$@"; do
    tmux new-window -t "$session" -n "devin-$i" "devin --permission-mode dangerous -- $(printf '%q' "$task")"
    ((i++))
  done
  echo "Launched $i Devin agents in tmux session: $session"
  echo "Attach: tmux attach -t $session"
}

# devin-session — open a persistent named tmux session for Devin/Claude work.
# Creates: left pane = devin, right pane = claude / shell. Reattaches if exists.
# Usage: devin-session [session-name]
devin-session() {
  local name="${1:-ai}"
  if tmux has-session -t "$name" 2>/dev/null; then
    echo "Reattaching to existing session: $name"
    tmux attach -t "$name"
    return
  fi
  # Create session with devin in main pane
  tmux new-session -d -s "$name" -x 220 -y 50
  tmux rename-window -t "$name:1" "devin"
  # Split right: shell / claude pane
  tmux split-window -h -t "$name:1" -p 45
  tmux select-pane -t "$name:1.1"
  tmux send-keys -t "$name:1.1" "devin --permission-mode dangerous" Enter
  tmux send-keys -t "$name:1.2" "echo 'Right pane: run claude or shell commands here'" Enter
  # Attach
  tmux attach -t "$name"
}

# devin-buffer — Ctrl+G workaround: grab current typed line and send to Devin
# Enterprise accounts block `devin shell setup`, so Ctrl+G is unavailable.
# This widget replicates the behavior: capture buffer, clear line, run devin with it.
# Ghostty: Ctrl+G is bindable. WebStorm terminal: may conflict — use a different key if needed.
_devin_send_buffer() {
  local task="$BUFFER"
  BUFFER=""
  zle reset-prompt
  if [[ -n "$task" ]]; then
    devin --permission-mode dangerous -- "$task"
  fi
}
zle -N _devin_send_buffer
bindkey "^G" _devin_send_buffer

# ── MLX local LLM server (auto-start, hardware-adaptive) ─────────────
# Starts from the user's terminal context — some corporate Endpoint Security
# configurations kill launchd-spawned LLM processes within seconds; shell-
# spawned children are left alone.
#
# endpoint-agent popup history (2026-05-12 fix):
# This block previously invoked `/usr/bin/nohup` to make the child immune
# to SIGHUP on shell exit. Endpoint security treats `nohup` as a
# blocked binary and pops the policy warning dialog every time a fresh interactive shell tries to start
# the server. The fix is `disown -h $!`, a zsh/bash builtin that
# achieves the same nohup-immunity semantic (the SHELL won't send SIGHUP
# to that job on exit) without invoking the blocked binary. Do NOT
# re-introduce `nohup` here. The `&!` (background + disown) on the
# outer subshell keeps shell startup fast.
#
# Hardware-adaptive: picks a primary model that fits the machine's unified
# memory without swap-thrashing. Override with `MLX_MODEL_OVERRIDE` if you
# want a specific model regardless of memory.
#
# Gate: MLX's prebuilt wheels are arm64-only. On Apple Silicon machines
# running the shell under Rosetta (uname -m == x86_64), `python3 -m
# mlx_lm` fails with an arch-mismatch dlopen error every shell start.
# Skip in that case — opencode falls back to whichever engine the
# local-ai LaunchAgents brought up (Ollama on :11434 by default; see
# `~/.config/opencode/opencode.json`). Override with
# DOTFILES_FORCE_MLX_STARTUP=1 to opt back in. WebStorm's fast terminal path
# skips local-model startup so Claude Code does not compete with a new MLX server.
if [[ -o interactive ]] \
   && { [[ "${DOTFILES_JETBRAINS_FAST_SHELL:-0}" != "1" ]] || [[ -n "${DOTFILES_FORCE_MLX_STARTUP:-}" ]]; } \
   && { [[ "$(uname -m)" == "arm64" ]] || [[ -n "${DOTFILES_FORCE_MLX_STARTUP:-}" ]]; }; then
  (
    if ! curl -sf http://127.0.0.1:8080/v1/models > /dev/null 2>&1; then
      mem_gb=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 ))
      if [[ -n "${MLX_MODEL_OVERRIDE:-}" ]]; then
        mlx_model="$MLX_MODEL_OVERRIDE"
      elif [[ "$mem_gb" -le 32 ]]; then
        mlx_model="mlx-community/Qwen3-8B-4bit"
      elif [[ "$mem_gb" -le 64 ]]; then
        mlx_model="mlx-community/Qwen3-14B-Instruct-4bit"
      elif [[ "$mem_gb" -le 96 ]]; then
        mlx_model="mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit"
      else
        mlx_model="mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit"
      fi
      # Direct background + disown -h (nohup-equivalent, no blocked binary).
      # See "endpoint-agent popup history" comment above.
      # Use uv-managed python to avoid Python.framework path (endpoint agent
      # flags any binary whose path contains Python.framework — rule 10).
      # Dynamic lookup via `uv python find` adapts to any architecture.
      _mlx_python="$(uv python find 3.13 2>/dev/null || echo "")"
      [ -z "$_mlx_python" ] && _mlx_python="${HOME}/.local/bin/python3.13"
      "$_mlx_python" -m mlx_lm server \
        --model "$mlx_model" \
        --port 8080 --host 127.0.0.1 \
        --max-tokens 32768 \
        --prompt-cache-size 2 \
        --prompt-cache-bytes 8589934592 \
        < /dev/null \
        > "$HOME/.cache/mlx-server.log" 2> "$HOME/.cache/mlx-server.err" &
      disown -h "$!" 2>/dev/null || true
      for i in $(seq 1 30); do
        curl -sf http://127.0.0.1:8080/v1/models > /dev/null 2>&1 && break
        sleep 2
      done
    fi
  ) &!
fi

# ── opencode fast-attach alias ───────────────────────────────────────
# `oc` attaches to the persistent opencode-serve daemon at 127.0.0.1:4096
# (managed by ~/Library/LaunchAgents/com.dotfiles.opencode-serve.plist).
# Skips ~5–10 s of JS bootstrap that bare `opencode` pays per invocation.
#
# Use:
#   oc                     # new TUI session, daemon-attached
#   oc -c                  # continue last session
#   oc --dir ~/foo         # attach with project context
alias oc='opencode attach http://127.0.0.1:4096'

# ── Anthropic API key slot (paid stable cloud fallback for opencode) ──
# Uncomment + fill in to enable the paid Anthropic provider in opencode
# (Haiku 4.5 / Sonnet 4.6). Inert until set — local stays default.
# Better practice: put the export in ~/.zshenv.secrets (gitignored) so it's
# also available to non-interactive shells launched by GUI agents.
# export ANTHROPIC_API_KEY="sk-ant-..."
