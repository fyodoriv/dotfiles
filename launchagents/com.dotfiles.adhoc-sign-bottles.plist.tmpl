<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.dotfiles.adhoc-sign-bottles

  Daily adhoc-sign sweep for Homebrew bottles + uv pythons + endpoint shims.
  Closes the unsigned window after `brew upgrade <formula>` outside chezmoi apply
  or weekly topgrade — unsigned Mach-O triggers endpoint agent unsigned on every spawn.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.dotfiles.adhoc-sign-bottles</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>{{ .chezmoi.homeDir }}/{{ .dotfiles_dir }}/.chezmoiscripts/run_after_endpoint-security.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StartInterval</key>
    <integer>86400</integer>
    <key>ExitTimeOut</key>
    <integer>600</integer>

    <key>EnvironmentVariables</key>
    <dict>
      <key>LANG</key>
      <string>C.UTF-8</string>
      <key>HOME</key>
      <string>{{ .chezmoi.homeDir }}</string>
      <key>PATH</key>
      <string>{{ template "launchagent-path" . }}</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/adhoc-sign-bottles.launchagent.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/adhoc-sign-bottles.launchagent.err.log</string>
  </dict>
</plist>
