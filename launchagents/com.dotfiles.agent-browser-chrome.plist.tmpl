<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dotfiles.agent-browser-chrome</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Google Chrome.app/Contents/MacOS/Google Chrome</string>
    <string>--remote-debugging-port=9223</string>
    <string>--user-data-dir={{ .chezmoi.homeDir }}/.agent-browser/chrome-profile</string>
    <string>--no-first-run</string>
    <string>--no-default-browser-check</string>
    <!-- Launch headless with NO window at login; the CDP remote-debugging port
         stays live so agent-browser attaches and creates targets in-process.
         Authenticated sessions persist in --user-data-dir. Use agent-browser
         --headed when a visible browser is required (SSO/MFA). -->
    <string>--no-startup-window</string>
    <string>--headless=new</string>
    <string>--disable-sync</string>
    <string>--disable-background-networking</string>
    <string>--enable-gpu-rasterization</string>
    <string>--enable-zero-copy</string>
    <string>--renderer-process-limit=8</string>
    <string>--enable-features=V8CodeCache</string>
    <string>--disk-cache-size=536870912</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- RunAtLoad-only, deliberately NOT KeepAlive: Chrome must stay closed
       when the user quits it for logout/shutdown. Agents still attach via
       --cdp when the login-started browser is available, but launchd and
       dotfiles-doctor must never reopen Chrome after a deliberate close. -->
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/agent-browser-chrome.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/agent-browser-chrome.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LANG</key>
    <string>C.UTF-8</string>
    <key>HOME</key>
    <string>{{ .chezmoi.homeDir }}</string>
  </dict>
</dict>
</plist>
