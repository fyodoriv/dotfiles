<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.dotfiles.chrome-dock-guard — event-driven, no polling. When a hidden
  launchd agent Chrome (9223, plus the temp-browser) becomes the active app (Dock click,
  Cmd-Tab, open -a), raise or start the user's Chrome instead. Never touches
  the agent Chromes.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dotfiles.chrome-dock-guard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{ .chezmoi.homeDir }}/{{ .dotfiles_dir }}/bin/dotfiles-chrome-dock-guard</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after a crash only; a clean skip (no swiftc) stays stopped. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/chrome-dock-guard.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/chrome-dock-guard.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>C.UTF-8</string>
        <key>PATH</key>
        <string>{{ template "launchagent-path" . }}</string>
        <key>HOME</key>
        <string>{{ .chezmoi.homeDir }}</string>
    </dict>
</dict>
</plist>
