<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dotfiles.chrome-profile</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- chrome-heal = Local State Work profile + ChromeWork default-browser reassert -->
        <string>{{ .chezmoi.homeDir }}/{{ .dotfiles_dir }}/bin/chrome-heal</string>
    </array>
    <!-- Run at login (before Chrome auto-starts) and every hour.
         Hourly cadence heals LaunchServices drift (Chrome/macOS claiming
         raw Chrome as default) without waiting for weekly doctor. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/chrome-profile.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/chrome-profile.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>C.UTF-8</string>
        <key>PATH</key>
        <string>{{ template "launchagent-path" . }}</string>
        <key>HOME</key>
        <string>{{ .chezmoi.homeDir }}</string>
    </dict>
</dict>
</plist>
