<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dotfiles.dotfiles-upgrade</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{ .chezmoi.homeDir }}/{{ .dotfiles_dir }}/bin/dotfiles-upgrade</string>
    </array>
    <!--
        Weekly, Sunday 09:00 local. Why this cadence:
          - Weekly (not daily): topgrade pulls brew + casks + every other manager,
            which is heavy. Daily wastes battery + bandwidth on machines that
            don't need it.
          - Sunday morning: a stable window when the operator is unlikely to be
            mid-task. dotfiles-doctor runs Monday 09:00 (StartCalendarInterval
            in its plist), so this runs ~24h before and gives doctor a chance
            to surface any post-upgrade drift.
          - 09:00: after typical morning wake, before peak coding hours.
        Adjust here if the timing collides with something on this machine.
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/dotfiles-upgrade.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/dotfiles-upgrade.launchd.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>C.UTF-8</string>
        <key>PATH</key>
        <string>{{ template "launchagent-path" . }}</string>
        <key>HOME</key>
        <string>{{ .chezmoi.homeDir }}</string>
    </dict>
</dict>
</plist>
