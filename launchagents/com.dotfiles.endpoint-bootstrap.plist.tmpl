<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.dotfiles.endpoint-bootstrap

  Fast RunAtLoad sweep: ad-hoc sign jq + uv pythons, link shims, write
  ~/.local/state/dotfiles/endpoint-ready. Supersedes com.dotfiles.adhoc-sign-uv-pythons
  (uv-only) and closes the post-reboot jq endpoint agent race with minsky tick-loop / daemon.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.dotfiles.endpoint-bootstrap</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>{{ .chezmoi.homeDir }}/{{ .dotfiles_dir }}/.chezmoiscripts/run_at_login_endpoint-bootstrap.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>ExitTimeOut</key>
    <integer>120</integer>

    <key>EnvironmentVariables</key>
    <dict>
      <key>LANG</key>
      <string>C.UTF-8</string>
      <key>HOME</key>
      <string>{{ .chezmoi.homeDir }}</string>
      <key>PATH</key>
      <string>{{ template "launchagent-path" . }}</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/endpoint-bootstrap.launchagent.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/endpoint-bootstrap.launchagent.err.log</string>
  </dict>
</plist>
