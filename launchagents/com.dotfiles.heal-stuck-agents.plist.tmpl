<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.dotfiles.heal-stuck-agents

  Self-healing watchdog for stuck Cursor agent symptoms: hung git-upload-pack
  SSH sessions, stale sandbox shells (vitest/tail -f/watch:pr), runaway
  high-CPU helper crawls, idle SSH mux sockets, and Cursor agent API DNS blips.
  Runs every 30 seconds and at login.

  Does NOT restart Cursor — permanent agent transport fail still needs Reload Window.
  Never steals focus or opens GUI apps.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.dotfiles.heal-stuck-agents</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>{{ .chezmoi.homeDir }}/{{ .dotfiles_dir }}/bin/dotfiles-heal-stuck-agents</string>
      <string>--fix</string>
      <string>--quiet</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StartInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>120</integer>

    <key>EnvironmentVariables</key>
    <dict>
      <key>LANG</key>
      <string>C.UTF-8</string>
      <key>HOME</key>
      <string>{{ .chezmoi.homeDir }}</string>
      <key>PATH</key>
      <string>{{ template "launchagent-path" . }}</string>
      <key>HEAL_SKIP_NETWORK</key>
      <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/heal-stuck-agents.launchagent.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/heal-stuck-agents.launchagent.err.log</string>
  </dict>
</plist>
