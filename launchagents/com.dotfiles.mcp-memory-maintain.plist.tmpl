<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dotfiles.mcp-memory-maintain</string>
    <!-- Retired compatibility artifact: AgentBrew owns memory maintenance. -->
    <key>Disabled</key>
    <true/>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{ .chezmoi.homeDir }}/{{ .dotfiles_dir }}/bin/dotfiles-memory</string>
        <string>maintain</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/mcp-memory-maintain.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/mcp-memory-maintain.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>C.UTF-8</string>
        <key>PATH</key>
        <string>{{ template "launchagent-path" . }}</string>
        <key>HOME</key>
        <string>{{ .chezmoi.homeDir }}</string>
    </dict>
</dict>
</plist>
