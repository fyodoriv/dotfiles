<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  One loopback-only mcp-memory-service daemon shared by every local MCP client.
  This avoids one Python/ONNX process and model load per concurrent agent.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.dotfiles.mcp-memory</string>
    <!-- Retired compatibility artifact: AgentBrew owns com.agentbrew.mcp-memory. -->
    <key>Disabled</key>
    <true/>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>{{ .chezmoi.homeDir }}/{{ .dotfiles_dir }}/bin/mcp-memory-launchagent</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
      <key>LANG</key>
      <string>C.UTF-8</string>
      <key>HOME</key>
      <string>{{ .chezmoi.homeDir }}</string>
      <key>PATH</key>
      <string>{{ template "launchagent-path" . }}</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/mcp-memory.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/mcp-memory.err.log</string>
  </dict>
</plist>
