<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dotfiles.network-resilience</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{ .chezmoi.homeDir }}/{{ .dotfiles_dir }}/bin/network-watchdog</string>
        <string>--quiet</string>
    </array>
    <!-- Run periodically; the sleepwatcher wake hook also kickstarts this job.
         Watching /Library/Preferences/SystemConfiguration is intentionally
         avoided because VPN agents can mutate it every 30 seconds, causing
         continuous redundant connectivity probes. -->
    <key>StartInterval</key>
    <integer>{{ if hasKey . "network_watchdog_interval" }}{{ .network_watchdog_interval }}{{ else }}300{{ end }}</integer>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/network-resilience.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/network-resilience.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>C.UTF-8</string>
        <key>PATH</key>
        <string>{{ template "launchagent-path" . }}</string>
        <key>HOME</key>
        <string>{{ .chezmoi.homeDir }}</string>
{{ if dig "use_ai_tools" false . }}        <key>DOTFILES_NETWORK_TARGETS</key>
        <string>https://github.com https://api.anthropic.com https://app.devin.ai</string>
{{ end }}    </dict>
    <!-- Don't accumulate if many changes happen in quick succession -->
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
