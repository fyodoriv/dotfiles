<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.dotfiles.ollama

  Starts `ollama serve` only when no healthy API already owns port 11434.
  Ollama.app can own the API; the wrapper exits successfully in that case.

  Critical env vars baked in:
    OLLAMA_NUM_PARALLEL=1       — single-user setup; default of 4 reserves
                                  KV cache for slots we never use (~3 GB
                                  leaked on 32-GB Macs).
    OLLAMA_KEEP_ALIVE=24h       — keep model loaded between calls; no
                                  cold-start tax per inference.
    OLLAMA_FLASH_ATTENTION=1    — speeds attention; cuts KV memory.
    OLLAMA_KV_CACHE_TYPE=q8_0   — 8-bit KV cache. Halves KV memory vs
                                  the f16 default with negligible quality
                                  loss; lets us keep both primary +
                                  small_model loaded on the 64GB box and
                                  trims first-token latency a bit.
                                  Requires OLLAMA_FLASH_ATTENTION=1.
    OLLAMA_CONTEXT_LENGTH=32768 — qwen3-coder ships with a 262K-token
                                  default context, which inflates KV
                                  cache by ~8x. 32K is plenty for code
                                  loops and shaves several seconds off
                                  cold-load time.
    OLLAMA_MAX_LOADED_MODELS    — 64GB+ Macs can keep both the primary
                                  (qwen3-coder:30b, ~18 GB on disk,
                                  ~25-30 GB in VRAM) AND the
                                  small_model (qwen3:0.6b, ~500 MB)
                                  resident so opencode's
                                  title/compaction calls don't evict
                                  the big model. Templated below: 2 on
                                  64GB+, 1 on smaller machines.

  KeepAlive.SuccessfulExit=false: restart a failed owned server, but do not
  respawn when the wrapper detects an already-running Ollama.app server.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.dotfiles.ollama</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>{{ .chezmoi.homeDir }}/{{ .dotfiles_dir }}/bin/ollama-launchagent</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
      <key>SuccessfulExit</key>
      <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
      <key>LANG</key>
      <string>C.UTF-8</string>
      <key>OLLAMA_NUM_PARALLEL</key>
      <string>1</string>
      <key>OLLAMA_MAX_LOADED_MODELS</key>
      <string>{{ if ge (div (output "sysctl" "-n" "hw.memsize" | trim | int) 1073741824) 64 }}2{{ else }}1{{ end }}</string>
      <key>OLLAMA_KEEP_ALIVE</key>
      <string>24h</string>
      <key>OLLAMA_FLASH_ATTENTION</key>
      <string>1</string>
      <key>OLLAMA_KV_CACHE_TYPE</key>
      <string>q8_0</string>
      <key>OLLAMA_CONTEXT_LENGTH</key>
      <string>32768</string>
      <key>OLLAMA_HOST</key>
      <string>127.0.0.1:11434</string>
      <key>OLLAMA_MODELS</key>
      <string>{{ .chezmoi.homeDir }}/.ollama/models</string>
      <key>OLLAMA_BIN</key>
      <string>{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew/bin/ollama{{ else }}/usr/local/bin/ollama{{ end }}</string>
      <key>HOME</key>
      <string>{{ .chezmoi.homeDir }}</string>
      <key>PATH</key>
      <string>{{ template "launchagent-path" . }}</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/ollama.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/ollama.err.log</string>
  </dict>
</plist>
