<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.dotfiles.opencode-serve

  Runs `opencode serve` as a persistent local daemon on 127.0.0.1:4096.
  Eliminates the per-invocation JS bootstrap cost (~5–10 s) for opencode TUI
  sessions that attach to it via the `oc` alias defined in home/zshrc.ai-tools.

  Why 127.0.0.1: the daemon accepts unauthenticated connections without
  OPENCODE_SERVER_PASSWORD set, which is fine for loopback only and would be
  dangerous on a non-loopback interface. Don't change --hostname unless you
  also set the password.

  KeepAlive=true with ThrottleInterval=10: if opencode-serve crashes (rare —
  it lazy-connects to providers, never depends on Ollama being up first),
  launchd respawns within ~10 s.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.dotfiles.opencode-serve</string>

    <key>ProgramArguments</key>
    <array>
      <string>{{ .chezmoi.homeDir }}/.opencode/bin/opencode</string>
      <string>serve</string>
      <string>--port</string>
      <string>4096</string>
      <string>--hostname</string>
      <string>127.0.0.1</string>
      <string>--log-level</string>
      <string>WARN</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
      <key>LANG</key>
      <string>C.UTF-8</string>
      <key>HOME</key>
      <string>{{ .chezmoi.homeDir }}</string>
      <key>PATH</key>
      <string>{{ template "launchagent-path" . }}</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/opencode-serve.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/opencode-serve.err.log</string>
  </dict>
</plist>
