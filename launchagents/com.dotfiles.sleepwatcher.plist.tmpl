<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dotfiles.sleepwatcher</string>
    <key>ProgramArguments</key>
    <array>
        {{- if stat "/opt/homebrew/sbin/sleepwatcher" }}
        <string>/opt/homebrew/sbin/sleepwatcher</string>
        {{- else }}
        <string>/usr/local/sbin/sleepwatcher</string>
        {{- end }}
        <string>-V</string>
        <string>-s</string>
        <string>{{ .chezmoi.homeDir }}/.sleep</string>
        <string>-w</string>
        <string>{{ .chezmoi.homeDir }}/.wakeup</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/sleepwatcher.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/sleepwatcher.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>C.UTF-8</string>
        <key>PATH</key>
        <string>{{ template "launchagent-path" . }}</string>
        <key>HOME</key>
        <string>{{ .chezmoi.homeDir }}</string>
    </dict>
</dict>
</plist>
