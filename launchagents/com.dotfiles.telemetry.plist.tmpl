<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.dotfiles.telemetry — the one scheduled sender of the anonymous
  performance numbers (bin/dotfiles-telemetry daily). It runs every hour and
  at load; the script itself sends at most once a day, only with a key, and
  stops after 3 seconds. It is installed only while the stored telemetry
  answer is yes: `dotfiles telemetry on` loads it, `off` removes it, and
  apply skips it otherwise (should_skip_agent). A custom XDG_STATE_HOME
  reaches the job only when it is set where the plist is rendered
  (`dotfiles telemetry on` or `dotfiles apply`); the path is XML-escaped, so
  a path with & or < is safe. Other scheduled jobs never start a send: launchd kills what a job
  leaves behind when it exits, which could stop a send half way (2026-11-09).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dotfiles.telemetry</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{ .chezmoi.homeDir }}/{{ .dotfiles_dir }}/bin/dotfiles-telemetry</string>
        <string>daily</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>Nice</key>
    <integer>15</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/telemetry.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/telemetry.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>C.UTF-8</string>
        <key>PATH</key>
        <string>{{ template "launchagent-path" . }}</string>
        <key>HOME</key>
        <string>{{ .chezmoi.homeDir }}</string>
{{- if env "XDG_STATE_HOME" }}
        <key>XDG_STATE_HOME</key>
        <string>{{ env "XDG_STATE_HOME" | html }}</string>
{{- end }}
    </dict>
</dict>
</plist>
