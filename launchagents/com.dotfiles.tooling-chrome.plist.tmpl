<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dotfiles.tooling-chrome</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Google Chrome.app/Contents/MacOS/Google Chrome</string>
    <string>--remote-debugging-port=9225</string>
    <string>--user-data-dir={{ .chezmoi.homeDir }}/.agent-browser/tooling-profile</string>
    <string>--no-first-run</string>
    <string>--no-default-browser-check</string>
    <!-- Headless CDP at login — see com.dotfiles.agent-browser-chrome. -->
    <string>--no-startup-window</string>
    <string>--headless=new</string>
    <string>--disable-sync</string>
    <string>--disable-background-networking</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Third login-started Chrome on this host (port 9225), separate from
       com.dotfiles.agent-browser-chrome (9223, dashboard / SSO-gated
       UI) and com.dotfiles.debug-chrome (9224, general
       debugging). Holds long-lived authenticated sessions for
       TOOLING-REPO work — pages opened while debugging dotfiles /
       agentbrew / minsky — so agents working in
       ~/apps/tooling/* do not collide with the dashboard browser's
       tabs (which the human keeps open for primary product work). Deliberately
       not KeepAlive: a quit for logout/shutdown must stay closed. -->
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/tooling-chrome.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/share/dotfiles/logs/tooling-chrome.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LANG</key>
    <string>C.UTF-8</string>
    <key>HOME</key>
    <string>{{ .chezmoi.homeDir }}</string>
  </dict>
</dict>
</plist>
