// Windsurf keybindings — managed by dotfiles
// Symlinked to ~/Library/Application Support/Windsurf/User/keybindings.json
// by modules/windsurf/doctor.sh.
//
// LAYERING — read this before editing:
//   1) `k--kato.intellij-idea-keybindings` provides the WebStorm/IntelliJ
//      shortcut bundle (Cmd-B → Go to Declaration, Shift-F6 → Rename, etc.).
//   2) `vscodevim.vim` owns in-editor motion (h/j/k/l, dd, gg, etc.).
//   3) THIS FILE only adds the customisations from jetbrains/keymap.xml —
//      keybinds the user changed away from defaults. Anything else lives in
//      the IntelliJ extension.
//
// Source of truth for these specific bindings: jetbrains/keymap.xml.
// Keep the comment headers next to each block in sync if you adjust.
[
  // ── RecentFiles → meta+e (jetbrains/keymap.xml) ──────────────────────────
  { "key": "cmd+e",       "command": "workbench.action.openRecent" },
  { "key": "cmd+e",       "command": "-workbench.action.showCommands", "when": "false" },

  // ── FindUsages → alt+f7 (default) + shift+meta+l ─────────────────────────
  { "key": "alt+f7",      "command": "editor.action.referenceSearch.trigger",
                          "when": "editorHasReferenceProvider && !inReferenceSearchEditor" },
  { "key": "shift+cmd+l", "command": "editor.action.goToReferences",
                          "when": "editorHasReferenceProvider && !inReferenceSearchEditor" },

  // ── GotoTypeDeclaration → shift+meta+b + shift+ctrl+b ────────────────────
  { "key": "shift+cmd+b", "command": "editor.action.goToTypeDefinition",
                          "when": "editorHasTypeDefinitionProvider && editorTextFocus" },
  { "key": "shift+ctrl+b","command": "editor.action.goToTypeDefinition",
                          "when": "editorHasTypeDefinitionProvider && editorTextFocus" },

  // ── QuickTypeDefinition → shift+ctrl+alt+q ───────────────────────────────
  { "key": "shift+ctrl+alt+q", "command": "editor.action.peekTypeDefinition",
                               "when": "editorHasTypeDefinitionProvider && editorTextFocus" },

  // ── EditorCloneCaretAbove/Below → shift+meta+alt+up/down ─────────────────
  { "key": "shift+cmd+alt+up",   "command": "editor.action.insertCursorAbove",
                                 "when": "editorTextFocus" },
  { "key": "shift+cmd+alt+down", "command": "editor.action.insertCursorBelow",
                                 "when": "editorTextFocus" },

  // ── GotoTest → shift+ctrl+t (run test on current file) ───────────────────
  // VS Code has no "go to test file" built-in; we run the test instead. If
  // jest-runner or vitest-explorer is installed, this triggers their command.
  { "key": "shift+ctrl+t", "command": "testing.runCurrentFile",
                           "when": "editorTextFocus" },

  // ── RunClass → shift+ctrl+r ──────────────────────────────────────────────
  { "key": "shift+ctrl+r", "command": "workbench.action.tasks.runTask" },

  // ── Split editor → shift+ctrl+meta+h/s; Unsplit → shift+ctrl+meta+u ──────
  { "key": "shift+ctrl+cmd+h", "command": "workbench.action.splitEditorDown" },
  { "key": "shift+ctrl+cmd+s", "command": "workbench.action.splitEditorRight" },
  { "key": "shift+ctrl+cmd+u", "command": "workbench.action.joinAllGroups" },

  // ── Move editor between groups → shift+ctrl+alt+j/l ──────────────────────
  { "key": "shift+ctrl+alt+j", "command": "workbench.action.moveEditorToBelowGroup" },
  { "key": "shift+ctrl+alt+l", "command": "workbench.action.moveEditorToRightGroup" },

  // ── HideAllWindows → shift+meta+f12 ──────────────────────────────────────
  { "key": "shift+cmd+f12", "command": "workbench.action.maximizeEditor" },

  // ── ActivateTerminalToolWindow → alt+f12 (default) + ctrl+meta+4 ─────────
  { "key": "alt+f12",  "command": "workbench.action.terminal.toggleTerminal",
                       "when": "terminal.active" },
  { "key": "alt+f12",  "command": "workbench.action.terminal.focus",
                       "when": "!terminal.active" },
  { "key": "ctrl+cmd+4","command": "workbench.action.terminal.toggleTerminal" },

  // ── ESLint fix → alt+s (Javascript.Linters.EsLint.Fix) ───────────────────
  { "key": "alt+s",    "command": "eslint.executeAutofix",
                       "when": "editorTextFocus && !editorReadonly" },

  // ── Vcs.Push.Force → shift+ctrl+meta+k (force-with-lease via wrapper) ────
  { "key": "shift+ctrl+cmd+k", "command": "git.pushForce" },

  // ── Annotate → ctrl+alt+a (GitLens file blame) ───────────────────────────
  { "key": "ctrl+alt+a", "command": "gitlens.toggleFileBlame",
                         "when": "editorTextFocus" },

  // ── Cascade — already Windsurf defaults (shift+meta+i, meta+\) ───────────
  // Documented here so future readers see the user's preference is preserved.
  // No override needed — these match Windsurf's built-in bindings.

  // ── Vim escape ergonomics ────────────────────────────────────────────────
  // Press jk fast → ESC in insert mode. Common ergonomic improvement; vim
  // settings in settings.json don't expose this directly, so bind here.
  { "key": "j k",      "command": "extension.vim_escape",
                       "when": "editorTextFocus && vim.active && vim.mode == 'Insert'" }
]
