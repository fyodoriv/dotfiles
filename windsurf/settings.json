{
  // ─────────────────────────────────────────────────────────────────────────
  // Windsurf user settings — managed by dotfiles
  // Symlinked to ~/Library/Application Support/Windsurf/User/settings.json
  // by modules/windsurf/doctor.sh. Round-trips: edit here OR in the UI;
  // either change persists into git via dotfiles-sync.
  //
  // Inherits from WebStorm (see windsurf/README.md for the full mapping).
  // Cascade / MCP / skills are NOT managed here — agentbrew owns ~/.codeium/.
  // ─────────────────────────────────────────────────────────────────────────

  // ── Editor font (mirrors jetbrains/editor-font.xml) ──────────────────────
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono NF', Menlo, monospace",
  "editor.fontSize": 15,
  "editor.lineHeight": 1.5,
  "editor.fontLigatures": true,
  "editor.fontWeight": "400",

  // ── Editor behavior (mirrors jetbrains/editor.xml) ───────────────────────
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.autoGuessEncoding": false,
  "editor.detectIndentation": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.renderWhitespace": "selection",
  "editor.unicodeHighlight.invisibleCharacters": true,
  "editor.unicodeHighlight.ambiguousCharacters": true,

  // Match WebStorm AUTO_POPUP_JAVADOC_INFO=true and inline-hint visibility
  "editor.parameterHints.enabled": true,
  "editor.parameterHints.cycle": true,
  "editor.hover.enabled": "on",
  "editor.hover.delay": 300,
  "editor.suggestOnTriggerCharacters": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.snippetSuggestions": "inline",
  "editor.suggest.preview": true,
  "editor.tabCompletion": "on",
  "editor.inlineSuggest.enabled": true,

  // Mirror WebStorm DeclarativeInlayHintsSettings — chain/type hints off,
  // keep parameter hints on (most useful) and other defaults.
  "editor.inlayHints.enabled": "offUnlessPressed",
  "javascript.inlayHints.parameterNames.enabled": "literals",
  "javascript.inlayHints.functionLikeReturnTypes.enabled": false,
  "javascript.inlayHints.propertyDeclarationTypes.enabled": false,
  "javascript.inlayHints.variableTypes.enabled": false,
  "javascript.inlayHints.parameterTypes.enabled": false,
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.functionLikeReturnTypes.enabled": false,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": false,
  "typescript.inlayHints.variableTypes.enabled": false,
  "typescript.inlayHints.parameterTypes.enabled": false,
  "typescript.inlayHints.enumMemberValues.enabled": false,

  // Match WebStorm cursor + scrolling feel
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "editor.smoothScrolling": true,
  "editor.scrollBeyondLastLine": false,
  "editor.linkedEditing": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": "active",
  "editor.guides.highlightActiveIndentation": true,
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 4,
  "editor.matchBrackets": "always",
  "editor.renderControlCharacters": false,
  "editor.renderLineHighlight": "all",
  "editor.occurrencesHighlight": "singleFile",
  "editor.selectionHighlight": true,
  "editor.wordBasedSuggestions": "matchingDocuments",
  "editor.codeLens": false,
  "editor.minimap.enabled": false,
  "editor.foldingHighlight": true,
  "editor.foldingImportsByDefault": false,

  // Format-on-save with Prettier, ESLint fix on explicit save
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never",
  },

  // ── Soft-wrap masks (mirror SOFT_WRAP_FILE_MASKS) ────────────────────────
  "editor.wordWrap": "off",
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off",
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[plaintext]": { "editor.wordWrap": "on" },
  "[restructuredtext]": { "editor.wordWrap": "on" },
  "[asciidoc]": { "editor.wordWrap": "on" },

  // ── Per-language indents (mirror dot_editorconfig) ───────────────────────
  // Default 2 spaces handled by editor.tabSize above. Override 4-space langs.
  "[java]": { "editor.tabSize": 4 },
  "[kotlin]": { "editor.tabSize": 4 },
  "[python]": { "editor.tabSize": 4, "editor.formatOnSave": false },
  "[rust]": { "editor.tabSize": 4 },
  "[go]": { "editor.insertSpaces": false, "editor.tabSize": 4 },
  "[makefile]": { "editor.insertSpaces": false, "editor.tabSize": 4 },
  "[shellscript]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },

  // JS/TS/JSON/YAML/HTML/CSS/SCSS/Markdown default formatter = Prettier
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[scss]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[less]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  // ── Workbench / UI (mirror jetbrains/ui.xml — compact density) ───────────
  // Color + icon themes are unified across Cursor / Windsurf / VS Code to match
  // WebStorm's "New UI Dark". Theme + icon-theme labels resolve to extensions
  // declared in extensions.txt.
  "workbench.colorTheme": "IntelliJ IDEA New UI Dark",
  "workbench.preferredDarkColorTheme": "IntelliJ IDEA New UI Dark",
  "workbench.preferredLightColorTheme": "IntelliJ IDEA New UI Light",
  "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-dark",
  "workbench.productIconTheme": "Default",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.enablePreviewFromCodeNavigation": false,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.tabActionLocation": "right",
  "workbench.editor.tabActionCloseVisibility": true,
  "workbench.editor.wrapTabs": false,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 20,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.openSideBySideDirection": "right",
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.restoreViewState": true,
  "workbench.editor.revealIfOpen": true,
  "workbench.tree.indent": 12,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.list.smoothScrolling": true,
  "workbench.layoutControl.enabled": false,
  "workbench.activityBar.location": "default",
  "workbench.sideBar.location": "left",
  "workbench.statusBar.visible": true,
  "workbench.commandPalette.history": 100,
  "workbench.commandPalette.preserveInput": false,
  "workbench.settings.openDefaultSettings": true,
  "workbench.settings.useSplitJSON": false,
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "on",

  // ── File nesting (mirror ui.xml ProjectViewFileNesting) ──────────────────
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.js.map, ${capture}.d.ts, ${capture}.d.ts.map, ${capture}.mjs, ${capture}.mjs.map, ${capture}.cjs, ${capture}.cjs.map",
    "*.tsx": "${capture}.js, ${capture}.js.map, ${capture}.jsx, ${capture}.jsx.map, ${capture}.d.ts, ${capture}.d.ts.map",
    "*.cts": "${capture}.js, ${capture}.js.map, ${capture}.cjs, ${capture}.cjs.map, ${capture}.d.cts, ${capture}.d.cts.map",
    "*.mts": "${capture}.js, ${capture}.js.map, ${capture}.mjs, ${capture}.mjs.map, ${capture}.d.mts, ${capture}.d.mts.map",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.min.js.map, ${capture}-compiled.js, ${capture}-compiled.js.map, ${capture}.map",
    "*.jsx": "${capture}.js, ${capture}.js.map",
    "*.cjs": "${capture}.cjs.map",
    "*.mjs": "${capture}.mjs.map",
    "*.es6": "${capture}.js, ${capture}.js.map",
    "*.css": "${capture}.min.css, ${capture}.css.map, ${capture}.min.css.map",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, .npmrc, .yarnrc, .yarnrc.yml, .pnp.cjs, .pnp.loader.mjs, npm-shrinkwrap.json",
    "tsconfig.json": "tsconfig.*.json",
    "Cargo.toml": "Cargo.lock, Cargo.*.toml",
    "Pipfile": "Pipfile.lock",
    "pyproject.toml": "poetry.lock, uv.lock, pdm.lock",
    "Gemfile": "Gemfile.lock",
    "go.mod": "go.sum",
    "Dockerfile": "Dockerfile.*, .dockerignore, docker-compose.*, compose.*",
    ".env": ".env.*, .envrc, .env.example",
    "README.md": "AUTHORS, BACKERS*, CHANGELOG*, CITATION*, CODEOWNERS*, CODE_OF_CONDUCT*, CONTRIBUTING*, CONTRIBUTORS*, COPYING*, FUNDING*, GOVERNANCE*, HISTORY*, LICENSE*, MAINTAINERS*, NOTICE*, PATENTS*, README-*, README_*, SECURITY*, SUPPORT*, TASKS.md",
  },

  // ── Explorer ─────────────────────────────────────────────────────────────
  "explorer.compactFolders": true,
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "explorer.confirmPasteNative": true,
  "explorer.sortOrder": "type",
  "explorer.autoReveal": true,
  "explorer.incrementalNaming": "smart",
  "explorer.openEditors.visible": 0,

  // ── Files / search exclude (performance — critical for monorepos) ────────
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.idea": true,
    "**/.fleet": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.cache": true,
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/out/**": true,
    "**/coverage/**": true,
    "**/.next/**": true,
    "**/.nuxt/**": true,
    "**/.turbo/**": true,
    "**/.svelte-kit/**": true,
    "**/.parcel-cache/**": true,
    "**/.cache/**": true,
    "**/.yarn/cache/**": true,
    "**/.yarn/install-state.gz": true,
    "**/.pnp.*": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/target/**": true,
    "**/.gradle/**": true,
    "**/.yalc/**": true,
    "**/.worktrees/**": true,
    "**/Library/Application Support/**": true,
    "**/.minsky/**": true,
    "**/.orchestrator/**": true,
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/out": true,
    "**/coverage": true,
    "**/.next": true,
    "**/.nuxt": true,
    "**/.turbo": true,
    "**/.svelte-kit": true,
    "**/.cache": true,
    "**/.yarn": true,
    "**/.yalc": true,
    "**/.worktrees": true,
    "**/target": true,
    "**/__pycache__": true,
    "**/.venv": true,
    "**/venv": true,
    "**/*.min.js": true,
    "**/*.min.css": true,
    "**/yarn.lock": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,
    "**/bun.lockb": true,
    "**/.minsky": true,
    "**/.orchestrator": true,
  },
  "search.useGlobalIgnoreFiles": true,
  "search.useParentIgnoreFiles": true,
  "search.followSymlinks": false,
  "search.smartCase": true,
  "search.maxResults": 20000,
  "search.searchOnType": true,
  "search.showLineNumbers": true,
  "search.useIgnoreFiles": true,

  // ── Performance (M3 Max 64 GB — tuned for heavy agent + multi-repo use) ──
  //
  // Memory budget: Windsurf main + renderers ≤12 GB, tsserver ≤8 GB,
  // language server ≤2 GB. Leaves ~40 GB for local LLM, Docker, browsers.
  //
  // V8 heap: controlled by ~/.config/windsurf/argv.json (see below).
  "editor.largeFileOptimizations": true,
  "editor.maxTokenizationLineLength": 20000,
  "editor.experimental.asyncTokenization": true,
  "files.maxMemoryForLargeFilesMB": 8192,
  "files.useExperimentalFileWatcher": true,
  "files.hotExit": "onExitAndWindowClose",
  "files.autoSave": "onFocusChange",
  "files.autoSaveDelay": 1000,
  "files.simpleDialog.enable": false,
  "files.restoreUndoStack": true,
  "files.participants.timeout": 5000,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  "extensions.ignoreRecommendations": false,
  "update.mode": "manual",
  "update.showReleaseNotes": false,
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "gitlens.telemetry.enabled": false,
  "diffEditor.maxComputationTime": 0,
  "diffEditor.maxFileSize": 0,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,
  "outline.showVariables": false,
  "problems.decorations.enabled": true,
  "problems.showCurrentInStatus": true,
  "problems.sortOrder": "severity",

  // ── TypeScript / JavaScript (mirror codestyle.xml + idea.properties) ─────
  // typescript.service.memoryLimit=4096 in idea.properties → 8 GB ceiling here
  "typescript.tsserver.maxTsServerMemory": 8192,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "typescript.tsserver.log": "off",
  "typescript.tsserver.useSyntaxServer": "auto",
  "typescript.tsserver.watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriority",
  },
  "typescript.suggest.completeFunctionCalls": true,
  "typescript.suggest.autoImports": true,
  "typescript.suggest.paths": true,
  "typescript.preferences.importModuleSpecifier": "shortest",
  "typescript.preferences.importModuleSpecifierEnding": "minimal",
  "typescript.preferences.quoteStyle": "single",
  "typescript.preferences.useAliasesForRenames": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.format.enable": true,
  "typescript.format.semicolons": "insert",
  "typescript.format.insertSpaceAfterCommaDelimiter": true,
  "typescript.format.insertSpaceAfterSemicolonInForStatements": true,
  "typescript.format.insertSpaceBeforeAndAfterBinaryOperators": true,
  "typescript.format.insertSpaceBeforeFunctionParenthesis": false,
  "typescript.workspaceSymbols.scope": "currentProject",
  "typescript.implementationsCodeLens.enabled": false,
  "typescript.referencesCodeLens.enabled": false,
  "typescript.surveys.enabled": false,
  "typescript.disableAutomaticTypeAcquisition": false,
  "javascript.suggest.completeFunctionCalls": true,
  "javascript.suggest.autoImports": true,
  "javascript.suggest.paths": true,
  "javascript.preferences.importModuleSpecifier": "shortest",
  "javascript.preferences.importModuleSpecifierEnding": "minimal",
  "javascript.preferences.quoteStyle": "single",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.format.semicolons": "insert",
  "js/ts.implicitProjectConfig.checkJs": false,
  "js/ts.implicitProjectConfig.experimentalDecorators": true,

  // ── ESLint (mirror Javascript.Linters.EsLint.Fix keybind on alt+s) ───────
  "eslint.enable": true,
  "eslint.run": "onType",
  "eslint.format.enable": false,
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.codeActionsOnSave.mode": "problems",
  "eslint.useFlatConfig": null,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "svelte",
  ],
  "eslint.lintTask.enable": false,
  "eslint.problems.shortenToSingleLine": false,
  "eslint.rules.customizations": [{ "rule": "*", "severity": "default" }],

  // ── Prettier (mirror codestyle.xml USE_DOUBLE_QUOTES=false, semi, comma) ─
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": true,
  "prettier.documentSelectors": [],
  "prettier.bracketSameLine": false,
  "prettier.singleQuote": true,
  "prettier.jsxSingleQuote": false,
  "prettier.semi": true,
  "prettier.trailingComma": "all",
  "prettier.arrowParens": "always",
  "prettier.endOfLine": "lf",
  "prettier.printWidth": 100,
  "prettier.tabWidth": 2,

  // ── Git (mirror WebStorm git.wait.for.changed.files.indexing=false) ──────
  "git.enabled": true,
  "git.autorefresh": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": false,
  "git.suggestSmartCommit": false,
  "git.enableCommitSigning": false,
  "git.fetchOnPull": true,
  "git.pullBeforeCheckout": true,
  "git.allowForcePush": true,
  "git.useForcePushWithLease": true,
  "git.confirmForcePush": true,
  "git.openRepositoryInParentFolders": "never",
  "git.replaceTagsWhenPull": true,
  "git.detectSubmodules": false,
  "git.followTagsWhenSync": true,
  "git.showActionButton": { "commit": true, "publish": false, "sync": false },
  "git.decorations.enabled": true,
  "git.untrackedChanges": "separate",
  "git.branchProtection": ["main", "master"],
  "git.branchProtectionPrompt": "alwaysPrompt",
  "git.inputValidation": true,
  "scm.alwaysShowProviders": false,
  "scm.alwaysShowRepositories": false,
  "scm.diffDecorations": "all",
  "scm.diffDecorationsGutterVisibility": "always",
  "scm.diffDecorationsGutterWidth": 3,
  "scm.providerCountBadge": "focused",

  // ── Terminal (mirror jetbrains/terminal-font.xml) ────────────────────────
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono NF', Menlo, monospace",
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.lineHeight": 1.4,
  "terminal.integrated.fontWeight": "400",
  "terminal.integrated.fontWeightBold": "700",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.scrollback": 100000,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.location": "right",
  "terminal.integrated.allowChords": false,
  "terminal.integrated.allowMnemonics": false,
  "terminal.integrated.confirmOnExit": "hasChildProcesses",
  "terminal.integrated.confirmOnKill": "editor",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.history": 1000,
  "terminal.integrated.macOptionIsMeta": true,
  "terminal.integrated.rightClickBehavior": "paste",
  "terminal.integrated.wordSeparators": " ()[]{}',\"`─‘’",
  "terminal.integrated.env.osx": {},
  "terminal.external.osxExec": "iTerm.app",

  // ── Vim (vscodevim — match IdeaVim sensibly; let IntelliJ keymap own  ────
  // most non-motion commands by listing them under vim.handleKeys=false) ───
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.smartcase": true,
  "vim.ignorecase": true,
  "vim.leader": "<space>",
  "vim.foldfix": true,
  "vim.surround": true,
  "vim.easymotion": false,
  "vim.searchHighlightColor": "rgba(150, 150, 255, 0.3)",
  "vim.statusBarColorControl": false,
  "vim.handleKeys": {
    // Let IntelliJ keymap / Windsurf own these — vim won't intercept
    "<C-a>": false,
    "<C-f>": false,
    "<C-d>": false,
    "<C-c>": false,
    "<C-v>": false,
    "<C-x>": false,
    "<C-z>": false,
    "<C-y>": false,
    "<C-b>": false,
    "<C-n>": true,
    "<C-w>": false,
    "<C-p>": false,
    "<C-e>": false,
    "<C-t>": false,
    "<C-/>": false,
    "<C-l>": false,
    "<C-h>": true,
    "<C-j>": true,
    "<C-k>": true,
    "<C-r>": true,
  },
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "w"],
      "commands": ["workbench.action.files.save"],
    },
    {
      "before": ["<leader>", "q"],
      "commands": ["workbench.action.closeActiveEditor"],
    },
    {
      "before": ["<leader>", "e"],
      "commands": ["workbench.action.toggleSidebarVisibility"],
    },
    { "before": ["<leader>", "f"], "commands": ["workbench.action.quickOpen"] },
    {
      "before": ["<leader>", "/"],
      "commands": ["workbench.action.findInFiles"],
    },
    { "before": ["g", "d"], "commands": ["editor.action.revealDefinition"] },
    { "before": ["g", "r"], "commands": ["editor.action.goToReferences"] },
    { "before": ["g", "i"], "commands": ["editor.action.goToImplementation"] },
    { "before": ["g", "t"], "commands": ["editor.action.goToTypeDefinition"] },
    { "before": ["K"], "commands": ["editor.action.showHover"] },
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    { "before": [">"], "commands": ["editor.action.indentLines"] },
    { "before": ["<"], "commands": ["editor.action.outdentLines"] },
  ],

  // ── GitLens (replaces WebStorm's Annotate / Git blame inline) ────────────
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": true,
  "gitlens.currentLine.pullRequests.enabled": true,
  "gitlens.currentLine.format": "${author, agoOrDate|14-}  ${message|40?}",
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.statusBar.enabled": true,
  "gitlens.statusBar.format": "${author, agoOrDate}",
  "gitlens.blame.heatmap.enabled": false,
  "gitlens.blame.toggleMode": "file",
  "gitlens.advanced.messages": {
    "suppressCommitHasNoPreviousCommitWarning": true,
  },

  // ── Error Lens (inline errors, replaces WebStorm's editor decorations) ───
  "errorLens.enabled": true,
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "errorLens.gutterIconsEnabled": true,
  "errorLens.followCursor": "allLines",
  "errorLens.delay": 200,
  "errorLens.scrollbarHackEnabled": true,
  "errorLens.fontWeight": "normal",
  "errorLens.messageBackgroundMode": "none",
  "errorLens.padding": "1px 6px",
  "errorLens.margin": "1ch",

  // ── Code Spell Checker (replaces WebStorm typo inspection) ───────────────
  "cSpell.enabled": true,
  "cSpell.diagnosticLevel": "Hint",
  "cSpell.showStatus": true,
  "cSpell.userWords": [],
  "cSpell.ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.git/**",
    "**/*.lock",
    "**/*.lockb",
    "yarn.lock",
    "package-lock.json",
    "pnpm-lock.yaml",
  ],

  // ── Markdown / preview ───────────────────────────────────────────────────
  "markdown.preview.fontFamily": "'JetBrainsMono Nerd Font', -apple-system, BlinkMacSystemFont, sans-serif",
  "markdown.preview.lineHeight": 1.5,
  "markdown.preview.openMarkdownLinks": "inEditor",
  "markdown.preview.scrollEditorWithPreview": true,
  "markdown.preview.scrollPreviewWithEditor": true,
  "markdown.extension.toc.updateOnSave": false,
  "markdown.extension.toc.levels": "2..6",
  "markdown.extension.print.absoluteImgPath": false,
  "markdown.extension.list.indentationSize": "adaptive",

  // ── Material Icon Theme (matches JetBrains file icons style) ─────────────
  "material-icon-theme.activeIconPack": "react",
  "material-icon-theme.hidesExplorerArrows": false,
  "material-icon-theme.folders.theme": "specific",
  "material-icon-theme.files.associations": {
    "*.test.ts": "Tune",
    "*.test.tsx": "Tune",
    "*.spec.ts": "Tune",
    "*.spec.tsx": "Tune",
  },

  // ── Notebook (Jupyter) ───────────────────────────────────────────────────
  "notebook.lineNumbers": "on",
  "notebook.output.scrolling": true,
  "notebook.output.wordWrap": true,
  "notebook.formatOnSave.enabled": true,
  "notebook.codeActionsOnSave": { "source.fixAll": "explicit" },

  // ── Misc safety ──────────────────────────────────────────────────────────
  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.startupPrompt": "never",
  "security.workspace.trust.banner": "untilDismissed",
  "security.workspace.trust.enabled": true,
  "task.quickOpen.skip": false,
  "task.allowAutomaticTasks": "off",
  "debug.allowBreakpointsEverywhere": true,
  "debug.showInStatusBar": "onFirstSessionStart",
  "debug.console.fontFamily": "'JetBrainsMono Nerd Font', Menlo, monospace",
  "debug.console.fontSize": 14,
  "debug.console.lineHeight": 1.4,
  "debug.toolBarLocation": "docked",
  "debug.inlineValues": "auto",

  // ── Editor: misc UI ──────────────────────────────────────────────────────
  "editor.padding.top": 6,
  "editor.padding.bottom": 6,
  "editor.rulers": [],
  "editor.glyphMargin": true,
  "editor.lineNumbers": "on",
  "editor.scrollbar.horizontal": "auto",
  "editor.scrollbar.vertical": "auto",
  "editor.scrollbar.verticalScrollbarSize": 14,
  "editor.scrollbar.horizontalScrollbarSize": 14,
  "editor.overviewRulerBorder": false,

  // ── Search / find ────────────────────────────────────────────────────────
  "editor.find.seedSearchStringFromSelection": "always",
  "editor.find.autoFindInSelection": "multiline",
  "editor.find.addExtraSpaceOnTop": false,
  "editor.find.cursorMoveOnType": true,
  "editor.find.globalFindClipboard": false,

  // ── Window ───────────────────────────────────────────────────────────────
  "window.titleBarStyle": "custom",
  "window.commandCenter": false,
  "window.menuBarVisibility": "compact",
  "window.nativeFullScreen": true,
  "window.openFilesInNewWindow": "off",
  "window.openFoldersInNewWindow": "off",
  "window.restoreWindows": "all",
  "window.restoreFullscreen": true,
  "window.zoomLevel": 0,
  "window.confirmBeforeClose": "keyboardOnly",

  // ── Keyboard layering ────────────────────────────────────────────────────
  // The IntelliJ IDEA Keybindings extension (installed by doctor.sh) provides
  // the WebStorm shortcut bundle. User-specific overrides from jetbrains/
  // keymap.xml live in windsurf/keybindings.json (symlinked next to this).
  "keyboard.dispatch": "keyCode",

  // ── EditorConfig (already respects ~/.editorconfig — no opt-out needed) ──
  "editorconfig.generateAuto": false,

  // ── Cascade (Windsurf-native; tuned for M3 Max + heavy agent use) ────────
  // Agent rules / MCP / skills are owned by agentbrew, not these settings.
  "windsurf.chat.autoExecutionPolicy": "asked",
  "windsurf.autoApprove": "never",
  "windsurf.acp.enabled": true,
  "windsurf.autoContinue": 0,
  "windsurf.terminal.cascadeProfile.osx": "managed",

  // ── Process priority / resource governance ────────────────────────────────
  // Electron Chromium flags that apply to the renderer + extension host.
  // These are settings-level controls; the heavy lifters (V8 heap, GPU accel)
  // live in ~/.windsurf/argv.json.
  "window.experimental.useSandbox": false,
  "extensions.experimental.affinity": {
    "esbenp.prettier-vscode": 1,
    "dbaeumer.vscode-eslint": 1,
    "vscodevim.vim": 2,
    "eamodio.gitlens": 2,
  },
  "githubPullRequests.pullBranch": "never",
}
